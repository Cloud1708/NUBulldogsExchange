@inherits LayoutComponentBase
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Components.Mobile
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject IFormFactor FormFactor
@inject AdminSettingsService StoreSettings
@implements IDisposable

<AuthSessionRestorer />

<style>
    :root {
        --navy: @Primary;
        --navy-dark: color-mix(in srgb, @Primary 82%, #000);
        --navy-deep: color-mix(in srgb, @Primary 88%, #fff);
        --navy-light: color-mix(in srgb, @Primary 72%, #fff);
        --gold: @Accent;
        --gold-dark: color-mix(in srgb, @Accent 85%, #000);
    }
</style>

@if (FormFactor.IsMobile)
{
    <div class="mobile-app-shell">
        <main class="mobile-store-main">
            @Body
        </main>

        <MobileBottomNav />
        <ToastHost />
    </div>
}
else
{
    <div class="store-shell">
        <header class="site-header">
            <SiteHeader />
            <SiteNavbar />
        </header>

        <main class="store-main">
            @Body
        </main>

        <SiteFooter />
        <ToastHost />
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string Primary => AdminSettingsValidation.SafeColor(
        StoreSettings.Saved.Branding.PrimaryColor, AdminBrandingSettings.DefaultPrimary);

    private string Accent => AdminSettingsValidation.SafeColor(
        StoreSettings.Saved.Branding.AccentColor, AdminBrandingSettings.DefaultAccent);

    protected override async Task OnInitializedAsync()
    {
        StoreSettings.OnChange += Refresh;
        await StoreSettings.EnsureLoadedAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => StoreSettings.OnChange -= Refresh;
}
