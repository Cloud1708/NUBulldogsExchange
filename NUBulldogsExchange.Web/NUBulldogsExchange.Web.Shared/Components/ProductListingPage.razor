@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject NavigationManager Navigation
@inject ProductCatalogService Catalog
@inject AdminProductService AdminProducts
@implements IDisposable

<section class="shop-page">
    <div class="container">
        <nav class="shop-breadcrumb" aria-label="Breadcrumb">
            @foreach (var item in DisplayBreadcrumb)
            {
                @if (!string.IsNullOrWhiteSpace(item.Href))
                {
                    <a href="@item.Href">@item.Label</a>
                    <Icon Name="chevron-right" Size="14" />
                }
                else
                {
                    <span>@item.Label</span>
                }
            }
        </nav>

        <header class="shop-heading">
            <h1 class="shop-title">@DisplayTitle</h1>
            @if (!HasSearchQuery && !string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </header>

        <div class="shop-layout">
            <aside class="shop-sidebar desktop-filters">
                <ShopFilters Categories="CategoryOptions"
                             Colors="ColorOptions"
                             Sizes="SizeOptions"
                             PriceMin="_catalogMin"
                             PriceMax="_catalogMax"
                             SelectedMin="_minPrice"
                             SelectedMinChanged="SetMinPrice"
                             SelectedMax="_maxPrice"
                             SelectedMaxChanged="SetMaxPrice"
                             SelectedCategories="_categories"
                             SelectedColors="_colors"
                             SelectedSizes="_sizes"
                             MinRating="_minRating"
                             MinRatingChanged="SetRating"
                             InStockOnly="_inStockOnly"
                             InStockOnlyChanged="SetInStock"
                             InStockCount="InStockCount"
                             FiltersChanged="OnFiltersChanged"
                             OnClearClicked="ClearAll"
                             RadioGroupName="@($"{RadioGroupPrefix}-desktop")" />
            </aside>

            <div class="shop-results">
                <div class="shop-toolbar-card">
                    <p class="shop-showing">@ShowingLabel</p>
                    <div class="shop-toolbar-right">
                        <button type="button" class="mobile-filters-btn" @onclick="() => _filtersOpen = true">
                            <Icon Name="sliders" Size="16" /> Filters
                        </button>
                        <label class="shop-sort">
                            <span>Sort by</span>
                            <select value="@_sortOption" @onchange="OnSortChanged">
                                <option value="featured">Featured</option>
                                <option value="newest">Newest</option>
                                <option value="best-selling">Best Selling</option>
                                <option value="price-asc">Price: Low to High</option>
                                <option value="price-desc">Price: High to Low</option>
                                <option value="rating">Top Rated</option>
                            </select>
                        </label>
                        <div class="view-toggle" role="group" aria-label="View mode">
                            <button type="button" class="view-btn @(_viewMode == "grid" ? "active" : "")" aria-pressed="@(_viewMode == "grid")" title="Grid view" @onclick="SetGridView">
                                <Icon Name="grid" Size="16" />
                            </button>
                            <button type="button" class="view-btn @(_viewMode == "list" ? "active" : "")" aria-pressed="@(_viewMode == "list")" title="List view" @onclick="SetListView">
                                <Icon Name="list" Size="16" />
                            </button>
                        </div>
                    </div>
                </div>

                @if (Chips.Count > 0)
                {
                    <div class="shop-chips">
                        @foreach (var chip in Chips)
                        {
                            var key = chip.Key;
                            <span class="shop-chip">
                                @chip.Label
                                <button type="button" aria-label="@($"Remove {chip.Label}")" @onclick="() => RemoveChip(key)">
                                    <Icon Name="x" Size="12" />
                                </button>
                            </span>
                        }
                        <button type="button" class="shop-chip-clear" @onclick="ClearAll">Clear All</button>
                    </div>
                }

                @if (Universe.Count == 0)
                {
                    <div class="shop-empty">
                        <h2>No products are currently available.</h2>
                        <p>Please check back soon.</p>
                        <a href="/" class="btn btn-navy">Return Home</a>
                    </div>
                }
                else if (!_pageItems.Any())
                {
                    <div class="shop-empty">
                        @if (HasSearchQuery && !HasActiveFilters)
                        {
                            <h2>No products found for "@_searchQuery".</h2>
                            <p>Try another search term.</p>
                            <button type="button" class="btn btn-navy" @onclick="ClearSearch">Clear Search</button>
                        }
                        else
                        {
                            <h2>No products found.</h2>
                            <p>Try adjusting your filters.</p>
                            <button type="button" class="btn btn-navy" @onclick="ClearAll">Clear Filters</button>
                        }
                    </div>
                }
                else if (_viewMode == "list")
                {
                    <div class="product-list">
                        @foreach (var product in _pageItems)
                        {
                            <ProductListCard @key="product.Id" Product="product" SoldCount="Catalog.FulfilledUnits(product.Id)" />
                        }
                    </div>
                }
                else
                {
                    <div class="product-grid shop-product-grid">
                        @foreach (var product in _pageItems)
                        {
                            <ProductCard @key="product.Id" Product="product" SoldCount="Catalog.FulfilledUnits(product.Id)" ShowCatalogExtras="true" />
                        }
                    </div>
                }

                @if (_totalPages > 1)
                {
                    <div class="shop-pagination">
                        <button type="button" class="page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)">Previous</button>
                        @for (var page = 1; page <= _totalPages; page++)
                        {
                            var p = page;
                            <button type="button" class="page-btn page-num @(_currentPage == p ? "active" : "")" @onclick="() => GoToPage(p)">@p</button>
                        }
                        <button type="button" class="page-btn" disabled="@(_currentPage >= _totalPages)" @onclick="() => GoToPage(_currentPage + 1)">Next</button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@if (_filtersOpen)
{
    <div class="filter-drawer-overlay" @onclick="() => _filtersOpen = false"></div>
    <aside class="filter-drawer">
        <div class="filter-drawer-header">
            <strong>Filters</strong>
            <button type="button" class="icon-button" @onclick="() => _filtersOpen = false" aria-label="Close filters">
                <Icon Name="x" Size="18" />
            </button>
        </div>
        <ShopFilters Categories="CategoryOptions"
                     Colors="ColorOptions"
                     Sizes="SizeOptions"
                     PriceMin="_catalogMin"
                     PriceMax="_catalogMax"
                     SelectedMin="_minPrice"
                     SelectedMinChanged="SetMinPrice"
                     SelectedMax="_maxPrice"
                     SelectedMaxChanged="SetMaxPrice"
                     SelectedCategories="_categories"
                     SelectedColors="_colors"
                     SelectedSizes="_sizes"
                     MinRating="_minRating"
                     MinRatingChanged="SetRating"
                     InStockOnly="_inStockOnly"
                     InStockOnlyChanged="SetInStock"
                     InStockCount="InStockCount"
                     FiltersChanged="OnFiltersChanged"
                     OnClearClicked="ClearAll"
                     RadioGroupName="@($"{RadioGroupPrefix}-drawer")" />
    </aside>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public IEnumerable<BreadcrumbItem> Breadcrumb { get; set; } = [];
    [Parameter] public IEnumerable<Product>? BaseProducts { get; set; }
    [Parameter] public string DefaultSort { get; set; } = "featured";
    [Parameter] public string RadioGroupPrefix { get; set; } = "listing";

    private const int PageSize = 8;

    private string? _searchQuery;
    private string _sortOption = "featured";
    private string _viewMode = "grid";
    private int _currentPage = 1;
    private bool _filtersOpen;
    private bool _initialized;
    private bool _priceReady;
    private decimal _catalogMin;
    private decimal _catalogMax;
    private decimal _minPrice;
    private decimal _maxPrice;

    private readonly HashSet<string> _categories = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _colors = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _sizes = new(StringComparer.OrdinalIgnoreCase);
    private int _minRating;
    private bool _inStockOnly;

    private List<Product> _filtered = [];
    private List<Product> _pageItems = [];
    private int _totalPages = 1;

    private bool HasSearchQuery => !string.IsNullOrWhiteSpace(_searchQuery);

    private bool HasActiveFilters =>
        _categories.Count > 0 || _colors.Count > 0 || _sizes.Count > 0 ||
        _minRating > 0 || _inStockOnly ||
        _minPrice > _catalogMin || _maxPrice < _catalogMax;

    private string DisplayTitle => HasSearchQuery ? $"Results for \"{_searchQuery}\"" : Title;

    private string ShowingLabel
    {
        get
        {
            var total = _filtered.Count;
            if (total == 0) return "Showing 0 products";
            var start = (_currentPage - 1) * PageSize + 1;
            var end = Math.Min(start + PageSize - 1, total);
            return $"Showing {start}–{end} of {total} {(total == 1 ? "product" : "products")}";
        }
    }

    private List<Product> Universe => CatalogUniverse().ToList();
    private int InStockCount => Universe.Count(ProductVariantLogic.IsPurchasable);

    private IEnumerable<BreadcrumbItem> DisplayBreadcrumb => HasSearchQuery
        ? [new("Home", "/"), new("Shop", "/shop"), new($"\"{_searchQuery}\"")]
        : Breadcrumb;

    private Task SetMinPrice(decimal value)
    {
        _minPrice = value;
        return Task.CompletedTask;
    }

    private Task SetMaxPrice(decimal value)
    {
        _maxPrice = value;
        return Task.CompletedTask;
    }

    private Task SetRating(int value)
    {
        _minRating = value;
        return Task.CompletedTask;
    }

    private Task SetInStock(bool value)
    {
        _inStockOnly = value;
        return Task.CompletedTask;
    }

    private List<ShopFilters.FilterCount> CategoryOptions
    {
        get
        {
            var known = Catalog.Categories.Select(c => c.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return Universe
                .Where(p => !string.IsNullOrWhiteSpace(p.Category))
                .GroupBy(p => p.Category.Trim(), StringComparer.OrdinalIgnoreCase)
                .Where(g => known.Count == 0 || known.Contains(g.Key))
                .Select(g => new ShopFilters.FilterCount(g.First().Category.Trim(), g.Count()))
                .Where(c => c.Count > 0)
                .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private List<ShopFilters.ColorFilter> ColorOptions =>
        Universe
            .SelectMany(p => ProductVariantLogic.SellableVariants(p)
                .Where(v => !string.IsNullOrWhiteSpace(v.ColorName))
                .Select(v => v.ColorName!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Select(name => (Product: p, Name: name)))
            .GroupBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .Select(g => new ShopFilters.ColorFilter(
                g.First().Name,
                ProductVariantLogic.ColorHex(g.First().Product.Variants, g.First().Name),
                g.Select(x => x.Product.Id).Distinct().Count()))
            .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<ShopFilters.FilterCount> SizeOptions =>
        Universe
            .SelectMany(p => ProductVariantLogic.SellableVariants(p)
                .Where(v => !string.IsNullOrWhiteSpace(v.Size))
                .Select(v => v.Size.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Select(size => (Product: p, Size: size)))
            .GroupBy(x => x.Size, StringComparer.OrdinalIgnoreCase)
            .Select(g => new ShopFilters.FilterCount(g.First().Size, g.Select(x => x.Product.Id).Distinct().Count()))
            .OrderBy(s => InventoryRow.SizeSortRank(s.Name))
            .ThenBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<(string Key, string Label)> Chips
    {
        get
        {
            var chips = new List<(string, string)>();
            foreach (var category in _categories.OrderBy(c => c))
                chips.Add(($"category:{category}", $"Category: {category}"));
            foreach (var color in _colors.OrderBy(c => c))
                chips.Add(($"color:{color}", $"Color: {color}"));
            foreach (var size in _sizes.OrderBy(InventoryRow.SizeSortRank))
                chips.Add(($"size:{size}", $"Size: {size}"));
            if (_minPrice > _catalogMin || _maxPrice < _catalogMax)
                chips.Add(("price", $"Price: {ProductVariantLogic.FormatPeso(_minPrice)} – {ProductVariantLogic.FormatPeso(_maxPrice)}"));
            if (_minRating > 0)
                chips.Add(("rating", $"Rating: {_minRating} & up"));
            if (_inStockOnly)
                chips.Add(("stock", "In Stock"));
            return chips;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _sortOption = DefaultSort;
        await AdminProducts.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        await Catalog.EnsureFulfilledSalesAsync();
        SyncFromUrl();
        EnsurePriceBounds(reset: true);
        RebuildResults();
        _initialized = true;
    }

    protected override void OnParametersSet()
    {
        if (!_initialized) return;
        EnsurePriceBounds(reset: false);
        RebuildResults();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncFromUrl();
        _currentPage = 1;
        RebuildResults();
        InvokeAsync(StateHasChanged);
    }

    private void SyncFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _searchQuery = GetQueryValue(uri, "q") ?? GetQueryValue(uri, "search");
        if (!string.IsNullOrWhiteSpace(_searchQuery))
            _searchQuery = _searchQuery.Trim();

        _categories.Clear();
        var category = GetQueryValue(uri, "category");
        if (!string.IsNullOrWhiteSpace(category))
            _categories.Add(category);
    }

    private static string? GetQueryValue(Uri uri, string key)
    {
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query)) return null;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 0) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[0]), key, StringComparison.OrdinalIgnoreCase))
                continue;
            return pair.Length > 1 ? Uri.UnescapeDataString(pair[1]) : string.Empty;
        }
        return null;
    }

    private IEnumerable<Product> CatalogUniverse()
    {
        var source = BaseProducts ?? Catalog.StorefrontProducts;
        return source.Where(p =>
            p.IsPublished &&
            (string.IsNullOrEmpty(p.Status) || p.Status.Equals("Active", StringComparison.OrdinalIgnoreCase)));
    }

    private IEnumerable<Product> ListingProducts() => Catalog.Search(CatalogUniverse(), _searchQuery);

    private void EnsurePriceBounds(bool reset)
    {
        var prices = CatalogUniverse().SelectMany(ProductVariantLogic.CustomerPrices).ToList();
        _catalogMin = prices.Count == 0 ? 0 : Math.Floor(prices.Min());
        _catalogMax = prices.Count == 0 ? 0 : Math.Ceiling(prices.Max());
        if (reset || !_priceReady)
        {
            _minPrice = _catalogMin;
            _maxPrice = _catalogMax;
            _priceReady = true;
        }
        else
        {
            _minPrice = Math.Clamp(_minPrice, _catalogMin, _catalogMax);
            _maxPrice = Math.Clamp(_maxPrice, _catalogMin, _catalogMax);
            if (_minPrice > _maxPrice) _minPrice = _catalogMin;
        }
    }

    private Task OnFiltersChanged()
    {
        _currentPage = 1;
        RebuildResults();
        return Task.CompletedTask;
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        _sortOption = e.Value?.ToString() ?? DefaultSort;
        _currentPage = 1;
        RebuildResults();
    }

    private void SetGridView() => _viewMode = "grid";
    private void SetListView() => _viewMode = "list";

    private void RemoveChip(string key)
    {
        var split = key.Split(':', 2);
        switch (split[0])
        {
            case "category": _categories.Remove(split[1]); break;
            case "color": _colors.Remove(split[1]); break;
            case "size": _sizes.Remove(split[1]); break;
            case "price":
                _minPrice = _catalogMin;
                _maxPrice = _catalogMax;
                break;
            case "rating": _minRating = 0; break;
            case "stock": _inStockOnly = false; break;
        }
        _currentPage = 1;
        RebuildResults();
    }

    private void ClearAll()
    {
        _categories.Clear();
        _colors.Clear();
        _sizes.Clear();
        _minRating = 0;
        _inStockOnly = false;
        _minPrice = _catalogMin;
        _maxPrice = _catalogMax;
        _currentPage = 1;
        _filtersOpen = false;

        if (HasSearchQuery)
        {
            Navigation.NavigateTo($"/shop?q={Uri.EscapeDataString(_searchQuery!)}");
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            Navigation.NavigateTo(uri.AbsolutePath);
            return;
        }

        RebuildResults();
    }

    private void ClearSearch()
    {
        _searchQuery = null;
        Navigation.NavigateTo("/shop");
    }

    private void RebuildResults()
    {
        IEnumerable<Product> list = ListingProducts();

        if (_categories.Count > 0)
            list = list.Where(p => _categories.Contains(p.Category ?? string.Empty));

        if (_colors.Count > 0)
            list = list.Where(p => ProductVariantLogic.SellableVariants(p)
                .Any(v => !string.IsNullOrWhiteSpace(v.ColorName) && _colors.Contains(v.ColorName)));

        if (_sizes.Count > 0)
            list = list.Where(p => ProductVariantLogic.SellableVariants(p)
                .Any(v => !string.IsNullOrWhiteSpace(v.Size) && _sizes.Contains(v.Size)));

        if (_catalogMax > _catalogMin && (_minPrice > _catalogMin || _maxPrice < _catalogMax))
        {
            list = list.Where(p =>
            {
                var prices = ProductVariantLogic.CustomerPrices(p);
                return prices.Any(price => price >= _minPrice && price <= _maxPrice);
            });
        }

        if (_minRating > 0)
            list = list.Where(p => p.Rating >= _minRating);

        if (_inStockOnly)
            list = list.Where(ProductVariantLogic.IsPurchasable);

        list = _sortOption switch
        {
            "newest" => list
                .OrderByDescending(p => p.CreatedAt ?? p.PublishedAt ?? DateTime.MinValue)
                .ThenByDescending(p => p.Id),
            "price-asc" => list.OrderBy(p => ProductVariantLogic.CustomerPrices(p).DefaultIfEmpty(p.Price).Min()),
            "price-desc" => list.OrderByDescending(p => ProductVariantLogic.CustomerPrices(p).DefaultIfEmpty(p.Price).Max()),
            "best-selling" => list
                .OrderByDescending(p => Catalog.FulfilledUnits(p.Id))
                .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
            "rating" => list
                .OrderByDescending(p => p.Rating)
                .ThenByDescending(p => p.Reviews)
                .ThenByDescending(p => Catalog.FulfilledUnits(p.Id)),
            _ => list.OrderByDescending(p => p.IsFeatured).ThenBy(p => p.Id)
        };

        _filtered = list.ToList();
        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
        if (_currentPage > _totalPages) _currentPage = _totalPages;
        if (_currentPage < 1) _currentPage = 1;
        _pageItems = _filtered.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        RebuildResults();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
