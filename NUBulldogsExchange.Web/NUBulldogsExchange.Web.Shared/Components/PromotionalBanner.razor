@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data

<section class="section section-light" id="essentials">
    <div class="container">
        <div class="essentials-banner">
            <div class="essentials-content">
                <span>CAMPUS ESSENTIALS</span>
                <h2>Bulldog Essentials</h2>
                <p>
                    Gear up for campus life with official-inspired NU merchandise.
                    From notebooks to bags — everything you need.
                </p>
                <a class="btn btn-gold" href="/school-essentials">Shop Essentials →</a>
            </div>
            <div class="essentials-image">
                <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=800&q=85"
                     alt="NU Bulldogs campus bag"
                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
            </div>
        </div>
    </div>
</section>
