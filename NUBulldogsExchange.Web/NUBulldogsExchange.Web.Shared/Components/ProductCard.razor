@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject CartService Cart
@inject WishlistService Wishlist
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigation
@implements IDisposable

<article class="product-card" @onclick="GoToDetails">
    <div class="product-image">
        @if (ShowCatalogExtras)
        {
            <span class="shop-stock-badge is-@StockKey">@ProductVariantLogic.CustomerStockLabel(Product)</span>
        }
        else if (Rank is > 0)
        {
            <span class="rank-badge rank-@Rank">#@Rank</span>
        }
        else if (ShowNewBadge)
        {
            <span class="badge badge-new">New</span>
        }
        else if (!string.IsNullOrWhiteSpace(Product.Badge))
        {
            <span class="badge @BadgeClass">@Product.Badge</span>
        }

        @if (Rank is > 0 && !string.IsNullOrWhiteSpace(Product.Badge))
        {
            <span class="badge badge-offset @BadgeClass">@Product.Badge</span>
        }
        <button type="button"
                class="favorite @(IsWishlisted ? "active" : "")"
                title="Wishlist"
                @onclick="ToggleWishlist"
                @onclick:stopPropagation="true">
            <Icon Name="heart" Size="16" />
        </button>
        <img src="@Product.ImageUrl"
             alt="@Product.Name"
             loading="lazy"
             onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
    </div>

    <div class="product-info">
        <small>@Product.Category</small>
        <h3>@Product.Name</h3>

        <div class="rating">
            @for (var i = 1; i <= 5; i++)
            {
                <span class="star @(i <= Math.Round(Product.Rating) ? "filled" : "")">★</span>
            }
            @if (ShowCatalogExtras)
            {
                <span>@Product.Rating.ToString("0.0") (@Product.Reviews) · @((SoldCount ?? Product.Sold).ToString("N0")) sold</span>
            }
            else
            {
                <span>(@Product.Reviews) · @((SoldCount ?? Product.Sold).ToString("N0")) sold</span>
            }
        </div>

        @if (ShowCatalogExtras)
        {
            var swatches = CardColors;
            var sizes = CardSizes;
            @if (swatches.Count > 0)
            {
                <div class="shop-card-swatches">
                    @foreach (var color in swatches.Take(4))
                    {
                        <span class="filter-swatch" style="background:@color.Hex" title="@color.Name"></span>
                    }
                    @if (swatches.Count > 4)
                    {
                        <small>+@(swatches.Count - 4)</small>
                    }
                </div>
            }
            @if (sizes.Count > 0)
            {
                <div class="shop-card-sizes">
                    @foreach (var size in sizes.Take(4))
                    {
                        <span>@size</span>
                    }
                </div>
            }
        }
        else if (Product.Colors.Count > 0)
        {
            <div class="colors">
                @foreach (var color in Product.Colors)
                {
                    <span class="dot @color" title="@color"></span>
                }
            </div>
        }

        <div class="product-bottom">
            <div class="price-wrap">
                <strong>@ProductVariantLogic.FormatCatalogPrice(Product.Price, Product.Variants)</strong>
                @if (Product.OriginalPrice is decimal original)
                {
                    <s>₱@original.ToString("N0")</s>
                }
            </div>
            @if (ShowCatalogExtras)
            {
                <button type="button"
                        class="btn btn-gold shop-card-action"
                        disabled="@OutOfStock"
                        @onclick="AddToCart"
                        @onclick:stopPropagation="true">
                    @ActionLabel
                </button>
            }
            else
            {
                <button type="button"
                        class="cart-button"
                        title="@ActionLabel"
                        disabled="@OutOfStock"
                        @onclick="AddToCart"
                        @onclick:stopPropagation="true">
                    <Icon Name="cart" Size="16" />
                </button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = null!;
    [Parameter] public int? Rank { get; set; }
    [Parameter] public bool ShowNewBadge { get; set; }
    /// <summary>Overrides the cached <see cref="Product.Sold"/> (e.g. fulfilled-only totals on Home).</summary>
    [Parameter] public int? SoldCount { get; set; }
    [Parameter] public bool ShowCatalogExtras { get; set; }

    private string BadgeClass => Product.Badge switch
    {
        "Best Seller" => "badge-best",
        "Sale" => "badge-sale",
        "New" => "badge-new",
        _ => "badge-best"
    };

    private bool IsWishlisted => Auth.IsLoggedIn && Wishlist.Contains(Product.Id);
    private List<ProductVariant> Sellable => ProductVariantLogic.SellableVariants(Product);
    private bool OutOfStock => !ProductVariantLogic.IsPurchasable(Product);
    private bool NeedsOptions => Sellable.Count > 1;
    private string StockKey => ProductVariantLogic.CustomerStockKey(Product);
    private string ActionLabel => OutOfStock ? "Out of Stock" : NeedsOptions ? "Select Options" : "Add to Cart";

    private List<(string Name, string Hex)> CardColors =>
        Sellable
            .Where(v => !string.IsNullOrWhiteSpace(v.ColorName))
            .GroupBy(v => v.ColorName!.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => (g.Key, ProductVariantLogic.ColorHex(Product.Variants, g.Key)))
            .ToList();

    private List<string> CardSizes =>
        Sellable
            .Where(v => !string.IsNullOrWhiteSpace(v.Size))
            .Select(v => v.Size.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(InventoryRow.SizeSortRank)
            .ToList();

    protected override void OnInitialized()
    {
        Wishlist.OnChange += Refresh;
        Auth.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void ToggleWishlist()
    {
        if (!Auth.IsLoggedIn)
        {
            Toast.Show("Please log in to save items to your wishlist.");
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
            return;
        }

        Wishlist.Toggle(Product.Id);
        Toast.Show(Wishlist.Contains(Product.Id)
            ? "Added to wishlist."
            : "Removed from wishlist.");
    }

    private void AddToCart()
    {
        if (OutOfStock)
            return;

        if (NeedsOptions)
        {
            Navigation.NavigateTo($"/product/{Product.Id}");
            return;
        }

        if (Sellable.Count == 1)
        {
            var variant = Sellable[0];
            Cart.Add(Product, 1, variant.ColorName, variant.Size, variant.Id);
        }
        else
        {
            Cart.Add(Product);
        }

        Toast.Show("Product added to cart.");
    }

    private void GoToDetails() => Navigation.NavigateTo($"/product/{Product.Id}");

    public void Dispose()
    {
        Wishlist.OnChange -= Refresh;
        Auth.OnChange -= Refresh;
    }
}
