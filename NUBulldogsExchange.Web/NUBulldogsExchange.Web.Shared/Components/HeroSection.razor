@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data

<section class="hero" id="home">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-text">
            <span class="hero-tag">Official School Merchandise</span>
            <h1>
                Wear Your
                <span>Bulldog Pride.</span>
            </h1>
            <p>
                Official-inspired NU merchandise made for students, alumni, faculty,
                and true Bulldog supporters. Quality gear that carries your university spirit.
            </p>
            <div class="hero-buttons">
                <a href="/shop" class="btn btn-gold">Shop Collection</a>
                <a href="/new-arrivals" class="btn btn-outline">Explore New Arrivals</a>
            </div>

            <ul class="hero-benefits">
                <li>
                    <Icon Name="map-pin" Size="18" />
                    <div>
                        <strong>Free Campus Pickup</strong>
                        <small>@OrderFlow.PickupHoursDays, @OrderFlow.PickupHoursTime</small>
                    </div>
                </li>
                <li>
                    <Icon Name="shield" Size="18" />
                    <div>
                        <strong>Secure Payments</strong>
                        <small>Pay on pickup or online</small>
                    </div>
                </li>
                <li>
                    <Icon Name="truck" Size="18" />
                    <div>
                        <strong>Easy Order Tracking</strong>
                        <small>Follow every status update</small>
                    </div>
                </li>
            </ul>
        </div>

        @if (MainProduct is not null)
        {
            <div class="hero-gallery @(SideProducts.Count == 0 ? "is-single" : SideProducts.Count == 1 ? "is-pair" : "")">
                <a class="hero-shot hero-shot-main" href="/product/@MainProduct.Id">
                    <img src="@MainProduct.ImageUrl"
                         alt="@MainProduct.Name"
                         onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                    <span class="hero-shot-label">@MainProduct.Name</span>
                </a>
                @foreach (var product in SideProducts)
                {
                    <a class="hero-shot" href="/product/@product.Id">
                        <img src="@product.ImageUrl"
                             alt="@product.Name"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                        <span class="hero-shot-label">@product.Name</span>
                    </a>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public Product? MainProduct { get; set; }
    [Parameter] public IReadOnlyList<Product> SideProducts { get; set; } = [];
}
