@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data

<section class="hero" id="home">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-text">
            <span class="hero-tag">Official School Merchandise</span>
            <h1>
                Wear Your
                <span>Bulldog Pride.</span>
            </h1>
            <p>
                Official-inspired NU merchandise made for students, alumni, faculty,
                and true Bulldog supporters. Quality gear that carries your university spirit.
            </p>
            <div class="hero-buttons">
                <a href="/shop" class="btn btn-gold">Shop Collection</a>
                <a href="/new-arrivals" class="btn btn-outline">Explore New Arrivals →</a>
            </div>
        </div>

        <div class="hero-product">
            <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=700&q=85"
                 alt="Featured NU Bulldogs shirt"
                 onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
            <div class="pickup-card">
                <div class="pickup-icon">
                    <Icon Name="check" Size="16" />
                </div>
                <div>
                    <strong>Free Campus Pickup</strong>
                    <small>Available weekdays</small>
                </div>
            </div>
        </div>
    </div>
</section>
