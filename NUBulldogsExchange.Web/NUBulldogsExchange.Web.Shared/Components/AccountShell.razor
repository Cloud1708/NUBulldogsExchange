@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject NavigationManager Navigation
@implements IDisposable

@if (Auth.IsAdmin)
{
    <div class="admin-gate">
        <p>Redirecting to Admin Portal...</p>
    </div>
}
else
{
    <section class="account-dashboard">
        <div class="container account-dashboard-grid">
            <AccountSidebar Active="@Active" />
            <div class="account-main">
                @ChildContent
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string Active { get; set; } = "overview";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Auth.OnChange += Refresh;
        RedirectIfAdmin();
    }

    protected override void OnParametersSet() => RedirectIfAdmin();

    private void RedirectIfAdmin()
    {
        if (Auth.IsAdmin)
            Navigation.NavigateTo("/admin/dashboard");
    }

    private void Refresh()
    {
        RedirectIfAdmin();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Auth.OnChange -= Refresh;
}
