@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject ProductCatalogService Catalog
@implements IDisposable

<footer class="footer">
    <div class="container footer-grid">
        <div>
            <div class="footer-brand">
                <div class="brand-icon">NU</div>
                <div>
                    <strong>NU Bulldogs</strong>
                    <span>Exchange</span>
                </div>
            </div>
            <p class="footer-description">
                Official merchandise store for NU students, faculty, alumni, and Bulldog supporters.
            </p>
        </div>

        <div>
            <h4>Shop</h4>
            <a href="/new-arrivals">New Arrivals</a>
            <a href="/best-sellers">Best Sellers</a>
            <a href="/apparel">Apparel</a>
            <a href="/accessories">Accessories</a>
            @if (Catalog.SchoolEssentialsCategory is { } essentials)
            {
                <a href="/shop?category=@Uri.EscapeDataString(essentials.Name)">School Essentials</a>
            }
        </div>

        <div>
            <h4>Customer Service</h4>
            <a href="/orders">Order Tracking</a>
        </div>

        <div>
            <h4>My Account</h4>
            <a href="/profile">Profile</a>
            <a href="/orders">My Orders</a>
            <a href="/wishlist">Wishlist</a>
            <a href="/cart">Cart</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© @DateTime.Now.Year NU Bulldogs Exchange. All rights reserved.</span>
    </div>
</footer>

@code {
    protected override void OnInitialized() => Catalog.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Catalog.OnChange -= Refresh;
}
