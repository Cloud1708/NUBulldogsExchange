@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject ProductCatalogService Catalog
@inject AdminSettingsService StoreSettings
@implements IDisposable

<footer class="footer">
    <div class="container footer-grid">
        <div>
            <div class="footer-brand">
                <StoreBrandMark LogoUrl="@Branding.LogoUrl" StoreName="@Store.Name" />
                <div>
                    <strong>@Store.BrandLines.Title</strong>
                    <span>@Store.BrandLines.Subtitle</span>
                </div>
            </div>
            <p class="footer-description">@Branding.Tagline</p>
            <ul class="footer-contact">
                @if (!string.IsNullOrWhiteSpace(Store.Email))
                {
                    <li><Icon Name="mail" Size="14" /><a href="@($"mailto:{Store.Email}")">@Store.Email</a></li>
                }
                @if (!string.IsNullOrWhiteSpace(Store.Contact))
                {
                    <li><Icon Name="phone" Size="14" /><a href="@($"tel:{new string(Store.Contact.Where(ch => char.IsDigit(ch) || ch == '+').ToArray())}")">@Store.Contact</a></li>
                }
                @if (!string.IsNullOrWhiteSpace(Store.Address))
                {
                    <li><Icon Name="map-pin" Size="14" /><span>@Store.Address</span></li>
                }
            </ul>
        </div>

        <div>
            <h4>Shop</h4>
            <a href="/new-arrivals">New Arrivals</a>
            <a href="/best-sellers">Best Sellers</a>
            <a href="/apparel">Apparel</a>
            <a href="/accessories">Accessories</a>
            @if (Catalog.SchoolEssentialsCategory is { } essentials)
            {
                <a href="/shop?category=@Uri.EscapeDataString(essentials.Name)">School Essentials</a>
            }
        </div>

        <div>
            <h4>Customer Service</h4>
            <a href="/orders">Order Tracking</a>
        </div>

        <div>
            <h4>My Account</h4>
            <a href="/profile">Profile</a>
            <a href="/orders">My Orders</a>
            <a href="/wishlist">Wishlist</a>
            <a href="/cart">Cart</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© @DateTime.Now.Year @Store.Name. All rights reserved.</span>
    </div>
</footer>

@code {
    private NUBulldogsExchange.Web.Shared.Data.AdminStoreSettings Store => StoreSettings.Saved.Store;
    private NUBulldogsExchange.Web.Shared.Data.AdminBrandingSettings Branding => StoreSettings.Saved.Branding;

    protected override void OnInitialized()
    {
        Catalog.OnChange += Refresh;
        StoreSettings.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Catalog.OnChange -= Refresh;
        StoreSettings.OnChange -= Refresh;
    }
}
