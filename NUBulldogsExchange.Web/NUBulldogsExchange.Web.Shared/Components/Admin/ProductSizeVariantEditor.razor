@namespace NUBulldogsExchange.Web.Shared.Components.Admin
@using NUBulldogsExchange.Web.Shared.Data

<div class="admin-size-variants">
    <label class="admin-size-variants-toggle">
        <input type="checkbox"
               checked="@HasVariants"
               @onchange="OnHasVariantsChanged"
               disabled="@Disabled" />
        <span>This product has variants</span>
    </label>

    @if (!HasVariants)
    {
        <label class="admin-field admin-product-stock-field">
            <span>Stock Quantity</span>
            <input type="number"
                   min="0"
                   step="1"
                   value="@StockText"
                   disabled="@Disabled"
                   @oninput="OnStockInput"
                   placeholder="100" />
            @if (!string.IsNullOrWhiteSpace(StockError))
            {
                <em>@StockError</em>
            }
        </label>
    }
    else
    {
        <div class="admin-size-variants-panel">
            <div class="admin-size-variants-head">
                <strong>Product Variants</strong>
                <span class="admin-size-variants-total">Total Stock: @TotalStock</span>
            </div>

            <div class="admin-size-variants-table admin-unified-variants-table" role="table">
                <div class="admin-unified-variants-row is-header" role="row">
                    <span role="columnheader">Color</span>
                    <span role="columnheader">Size</span>
                    <span role="columnheader">Stock</span>
                    <span role="columnheader">SKU</span>
                    <span role="columnheader">Status</span>
                    <span role="columnheader" class="admin-size-variants-actions">Action</span>
                </div>

                @for (var i = 0; i < Variants.Count; i++)
                {
                    var index = i;
                    var row = Variants[index];
                    <div class="admin-unified-variants-row" role="row">
                        <div class="admin-unified-color-cell">
                            <input type="text"
                                   value="@row.ColorName"
                                   placeholder="Navy"
                                   disabled="@Disabled"
                                   @oninput="e => OnColorNameChanged(index, e)" />
                            @if (!string.IsNullOrWhiteSpace(row.ColorName))
                            {
                                <input type="color"
                                       value="@ColorInputValue(row.ColorHex, row.ColorName)"
                                       disabled="@Disabled"
                                       @oninput="e => OnColorHexPickerChanged(index, e)"
                                       aria-label="Color swatch" />
                            }
                        </div>
                        <input type="text"
                               value="@row.Size"
                               placeholder="S"
                               disabled="@Disabled"
                               @oninput="e => OnSizeChanged(index, e)" />
                        <input type="number"
                               min="0"
                               step="1"
                               value="@row.StockQuantity"
                               disabled="@Disabled"
                               @oninput="e => OnStockChanged(index, e)" />
                        <input type="text"
                               value="@row.Sku"
                               placeholder="NUBE-HD-001-S"
                               disabled="@Disabled"
                               @oninput="e => OnSkuChanged(index, e)" />
                        <select value="@(string.IsNullOrWhiteSpace(row.Status) ? "Active" : row.Status)"
                                disabled="@Disabled"
                                @onchange="e => OnStatusChanged(index, e)">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <button type="button"
                                class="admin-size-variants-remove"
                                title="Delete"
                                disabled="@Disabled"
                                @onclick="() => RemoveRow(index)">
                            Delete
                        </button>
                    </div>
                }
            </div>

            <button type="button"
                    class="btn btn-outline-navy admin-size-variants-add"
                    disabled="@Disabled"
                    @onclick="AddRow">
                + Add Variant
            </button>

            @if (!string.IsNullOrWhiteSpace(VariantsError))
            {
                <em class="admin-size-variants-error">@VariantsError</em>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool HasVariants { get; set; }
    [Parameter] public EventCallback<bool> HasVariantsChanged { get; set; }
    [Parameter] public List<ProductVariant> Variants { get; set; } = [];
    [Parameter] public EventCallback<List<ProductVariant>> VariantsChanged { get; set; }
    [Parameter] public string StockText { get; set; } = "0";
    [Parameter] public EventCallback<string> StockTextChanged { get; set; }
    [Parameter] public string? StockError { get; set; }
    [Parameter] public string? VariantsError { get; set; }
    [Parameter] public string BaseSku { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }

    private int TotalStock =>
        Variants.Where(v => v.IsActive).Sum(v => Math.Max(0, v.StockQuantity));

    public static string? Validate(IReadOnlyList<ProductVariant> variants) =>
        ProductVariantLogic.ValidateUnified(variants);

    private async Task OnHasVariantsChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        HasVariants = enabled;
        if (enabled && Variants.Count == 0)
            Variants.Add(NewRow());
        await HasVariantsChanged.InvokeAsync(enabled);
        await NotifyVariantsAsync();
    }

    private Task OnStockInput(ChangeEventArgs e) =>
        StockTextChanged.InvokeAsync(e.Value?.ToString() ?? "0");

    private async Task OnColorNameChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= Variants.Count) return;
        var previous = Variants[index].ColorName;
        Variants[index].ColorName = string.IsNullOrWhiteSpace(e.Value?.ToString())
            ? null
            : e.Value!.ToString()!.Trim();
        if (string.IsNullOrWhiteSpace(Variants[index].ColorName))
            Variants[index].ColorHex = null;
        else if (string.IsNullOrWhiteSpace(Variants[index].ColorHex))
        {
            Variants[index].ColorHex = ProductVariantLogic.DefaultHex(Variants[index].ColorName);
        }
        ProductVariantLogic.ApplySuggestedSku(Variants[index], BaseSku, previous, Variants[index].Size);
        await NotifyVariantsAsync();
    }

    private async Task OnColorHexPickerChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= Variants.Count) return;
        Variants[index].ColorHex = ProductVariantLogic.NormalizeHex(e.Value?.ToString());
        await NotifyVariantsAsync();
    }

    private async Task OnSizeChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= Variants.Count) return;
        var previous = Variants[index].Size;
        Variants[index].Size = string.IsNullOrWhiteSpace(e.Value?.ToString())
            ? string.Empty
            : e.Value!.ToString()!.Trim();
        ProductVariantLogic.ApplySuggestedSku(Variants[index], BaseSku, Variants[index].ColorName, previous);
        await NotifyVariantsAsync();
    }

    private async Task OnStockChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= Variants.Count) return;
        Variants[index].StockQuantity = int.TryParse(e.Value?.ToString(), out var stock)
            ? Math.Max(0, stock)
            : 0;
        await NotifyVariantsAsync();
    }

    private async Task OnSkuChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= Variants.Count) return;
        Variants[index].Sku = string.IsNullOrWhiteSpace(e.Value?.ToString())
            ? null
            : e.Value!.ToString()!.Trim();
        await NotifyVariantsAsync();
    }

    private async Task OnStatusChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= Variants.Count) return;
        Variants[index].Status = string.IsNullOrWhiteSpace(e.Value?.ToString())
            ? "Active"
            : e.Value!.ToString()!.Trim();
        await NotifyVariantsAsync();
    }

    private async Task AddRow()
    {
        Variants.Add(NewRow());
        await NotifyVariantsAsync();
    }

    private async Task RemoveRow(int index)
    {
        if (index < 0 || index >= Variants.Count) return;
        Variants.RemoveAt(index);
        if (Variants.Count == 0)
            Variants.Add(NewRow());
        await NotifyVariantsAsync();
    }

    private ProductVariant NewRow()
    {
        var row = new ProductVariant
        {
            Status = "Active",
            StockQuantity = 0
        };
        ProductVariantLogic.ApplySuggestedSku(row, BaseSku, null, null);
        return row;
    }

    private static string ColorInputValue(string? hex, string? name) =>
        ProductVariantLogic.NormalizeHex(hex) ?? ProductVariantLogic.DefaultHex(name);

    private Task NotifyVariantsAsync() => VariantsChanged.InvokeAsync(Variants);
}
