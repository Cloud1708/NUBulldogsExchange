@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<aside class="account-sidebar">
    <div class="account-sidebar-profile">
        <div class="account-sidebar-avatar-wrap">
            <div class="account-sidebar-avatar">@Auth.Initial</div>
            <a href="/profile" class="account-sidebar-edit" title="Edit profile" aria-label="Edit profile">
                <Icon Name="camera" Size="11" />
            </a>
        </div>
        <strong>@Auth.DisplayName</strong>
        <span>@Auth.Email</span>
    </div>

    <nav class="account-sidebar-nav" aria-label="Account">
        <a href="/account" class="account-nav-item @(IsActive("overview") ? "active" : "")">
            <Icon Name="user" Size="16" />
            Overview
        </a>
        <a href="/orders" class="account-nav-item @(IsActive("orders") ? "active" : "")">
            <Icon Name="package" Size="16" />
            My Orders
        </a>
        <a href="/wishlist" class="account-nav-item @(IsActive("wishlist") ? "active" : "")">
            <Icon Name="heart" Size="16" />
            Wishlist
        </a>
        <a href="/notifications" class="account-nav-item @(IsActive("notifications") ? "active" : "")">
            <Icon Name="bell" Size="16" />
            Notifications
            @if (Notifications.UnreadCount > 0)
            {
                <span class="account-nav-badge">@Notifications.UnreadCount</span>
            }
        </a>
        <a href="/profile" class="account-nav-item @(IsActive("profile") ? "active" : "")">
            <Icon Name="settings" Size="16" />
            My Profile
        </a>

        <div class="account-nav-sep"></div>

        <button type="button" class="account-nav-item account-nav-logout" @onclick="Logout">
            <Icon Name="log-out" Size="16" />
            Logout
        </button>
    </nav>
</aside>

@code {
    [Parameter] public string Active { get; set; } = "overview";

    protected override void OnInitialized()
    {
        Auth.OnChange += Refresh;
        Notifications.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    private bool IsActive(string key) => string.Equals(Active, key, StringComparison.OrdinalIgnoreCase);

    private async Task Logout()
    {
        await Auth.LogoutAsync(JS);
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Auth.OnChange -= Refresh;
        Notifications.OnChange -= Refresh;
    }
}
