@namespace NUBulldogsExchange.Web.Shared.Components.Mobile
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject NavigationManager Navigation
@inject CartService Cart
@inject WishlistService Wishlist
@inject AuthService Auth
@inject NotificationService Notifications
@implements IDisposable

<div class="top-header">
    <a href="/" class="brand">
        <div class="brand-icon">NU</div>
        <div class="brand-text">
            <span class="brand-title">Bulldogs Exchange</span>
        </div>
    </a>

    <div class="header-actions">
        <a href="/notifications" class="icon-button bell-button" title="Notifications" aria-label="Notifications">
            <span class="header-bell-icon">🔔</span>
            <span class="red-badge">@(Notifications.UnreadCount > 0 ? Notifications.UnreadCount : 3)</span>
        </a>
        <a href="/cart" class="icon-button cart-header-btn" title="Cart" aria-label="Shopping cart">
            <Icon Name="cart" Size="22" />
            @if (Cart.TotalCount > 0)
            {
                <span class="red-badge">@Cart.TotalCount</span>
            }
        </a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Cart.OnChange += Refresh;
        Notifications.OnChange += Refresh;
        Auth.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cart.OnChange -= Refresh;
        Notifications.OnChange -= Refresh;
        Auth.OnChange -= Refresh;
    }
}
