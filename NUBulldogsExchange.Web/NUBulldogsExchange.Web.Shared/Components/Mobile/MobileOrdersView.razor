@namespace NUBulldogsExchange.Web.Shared.Components.Mobile
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject OrderService OrderService
@inject CartService Cart
@inject ProductCatalogService Catalog
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="mobile-orders-container">
    @* Orders Header matching Figma Mockup *@
    <div class="mobile-orders-header">
        <h1 class="mobile-orders-title">My Orders</h1>
    </div>

    @* Horizontal Filter Pills *@
    <div class="mobile-filter-pills-row" role="tablist" aria-label="Order Status Filters">
        @foreach (var filter in Filters)
        {
            <button type="button"
                    role="tab"
                    class="mobile-filter-pill @(_filter == filter ? "active" : "")"
                    aria-selected="@(_filter == filter)"
                    @onclick="() => SetFilter(filter)">
                @filter
            </button>
        }
    </div>

    @{
        var visibleOrders = FilteredOrders.ToList();
    }

    @if (!visibleOrders.Any())
    {
        <div class="mobile-orders-empty">
            <div class="empty-icon-circle" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                    <path d="m3.3 7 8.7 5 8.7-5"></path>
                    <path d="M12 22V12"></path>
                </svg>
            </div>
            <h2 class="empty-title">No @(_filter == "All" ? "" : _filter.ToLowerInvariant()) orders found</h2>
            <p class="empty-text">You don't have any orders under this status yet.</p>
            <a href="/shop" class="empty-btn">Shop Merchandise</a>
        </div>
    }
    else
    {
        <div class="mobile-orders-list">
            @foreach (var order in visibleOrders)
            {
                <article class="mobile-order-card" @key="order.Id">
                    <div class="mobile-order-card-header">
                        <div class="mobile-order-header-left">
                            <strong class="mobile-order-id">#@order.Id</strong>
                            <span class="mobile-order-date">@FormatDate(order.Date) • @order.ItemCountLabel</span>
                        </div>
                        <span class="mobile-status-pill status-@order.CustomerStatusKey">@order.CustomerCategory</span>
                    </div>

                    <div class="mobile-order-fulfillment @(order.IsDelivery ? "is-delivery" : "is-pickup")">
                        <strong>@(order.IsDelivery ? "🚚 Delivery" : "📍 Campus Pickup")</strong>
                        <span>
                            @(string.IsNullOrWhiteSpace(order.FulfillmentLocationLabel)
                                ? (order.IsDelivery ? "Delivery address on file" : OrderFlow.PickupLocation)
                                : order.FulfillmentLocationLabel)
                        </span>
                    </div>
                    <div class="mobile-order-payment-meta">
                        <span>Payment: @(string.IsNullOrWhiteSpace(order.PaymentMethod) ? "—" : order.PaymentMethod)</span>
                        <span>Payment Status: @order.PaymentStatus</span>
                    </div>

                    <div class="mobile-order-items-list">
                        @foreach (var item in order.Items)
                        {
                            <div class="mobile-order-item-row">
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     class="mobile-order-item-thumb"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                <div class="mobile-order-item-info">
                                    <h4 class="mobile-order-item-title">@item.Name</h4>
                                    <span class="mobile-order-item-meta">
                                        @if (!string.IsNullOrWhiteSpace(item.Color))
                                        {
                                            <text>Color: @item.Color · </text>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Size) && !item.Size.Equals("Free Size", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <text>Size: @item.Size · </text>
                                        }
                                        Qty: @item.Quantity
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mobile-order-card-footer">
                        <div class="mobile-order-total-block">
                            <span class="mobile-order-total-label">Order Total</span>
                            <strong class="mobile-order-total-val">₱@order.Total.ToString("N0")</strong>
                        </div>

                        <div class="mobile-order-actions-row">
                            @if (order.CanWriteReview)
                            {
                                <button type="button" class="mobile-order-action-btn btn-outline" @onclick="() => BuyAgain(order)">Buy Again</button>
                                @if (order.HasUnreviewedItems)
                                {
                                    <button type="button" class="mobile-order-action-btn btn-navy" @onclick="() => OpenReview(order)">Write Review</button>
                                }
                                else
                                {
                                    <button type="button" class="mobile-order-action-btn btn-reviewed" disabled>✓ Reviewed</button>
                                }
                                <button type="button" class="mobile-order-action-btn btn-outline" @onclick="() => OpenDetails(order)">Details</button>
                            }
                            else if (order.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="mobile-order-action-btn btn-outline" @onclick="() => OpenDetails(order)">Details</button>
                            }
                            else
                            {
                                @if (order.CanConfirmReceived)
                                {
                                    <button type="button" class="mobile-order-action-btn btn-navy" @onclick="() => AskReceived(order)">Order Received</button>
                                }
                                <button type="button" class="mobile-order-action-btn btn-outline" @onclick="() => OpenDetails(order)">Details</button>
                                <button type="button" class="mobile-order-action-btn btn-navy" @onclick="() => TrackOrder(order)">Track</button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<CustomerOrderDetailsModal Order="_selectedOrder"
                           OnClose="CloseDetails"
                           OnRequestReceived="AskReceived"
                           OnWriteReview="OpenReviewFromDetails" />
<ConfirmOrderReceivedModal Order="_pendingReceived"
                           Saving="_savingReceived"
                           OnCancel="CloseReceivedConfirm"
                           OnConfirm="ConfirmReceived" />
<WriteReviewModal Order="_reviewOrder"
                  SelectedItem="_reviewItem"
                  OnClose="CloseReview"
                  OnSubmitted="OnReviewSubmitted" />

@* Track Order Sheet *@
@if (_trackingOrder is not null)
{
    <div class="mobile-modal-backdrop" @onclick="CloseTracking">
        <div class="mobile-modal-sheet" @onclick:stopPropagation="true">
            <div class="mobile-modal-header">
                <div>
                    <h3 class="mobile-modal-title">Track Order #@_trackingOrder.Id</h3>
                    <span class="mobile-order-date">@(_trackingOrder.IsDelivery ? "Estimated delivery: 3–7 business days" : "Expected pickup: today / next school day")</span>
                </div>
                <button type="button" class="mobile-modal-close-btn" @onclick="CloseTracking" aria-label="Close">
                    <Icon Name="x" Size="18" />
                </button>
            </div>

            <div style="margin: 20px 10px 24px 10px; display: flex; flex-direction: column; gap: 20px;">
                @{
                    var trackSteps = OrderFlow.TimelineSteps(_trackingOrder.Fulfillment);
                    var trackProgress = OrderFlow.TimelineProgress(_trackingOrder.Fulfillment, _trackingOrder.Status);
                }
                @for (var i = 0; i < trackSteps.Length; i++)
                {
                    var done = trackProgress >= 0 && i <= trackProgress;
                    <div style="display: flex; gap: 14px; align-items: flex-start;">
                        <div style="width: 28px; height: 28px; border-radius: 50%; background: @(done ? "#10B981" : "#E2E8F0"); color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800;">
                            @(done ? "✓" : (i + 1).ToString())
                        </div>
                        <div>
                            <strong style="font-size: 13px; color: #14366A; display: block;">@trackSteps[i]</strong>
                            @if (i == 0)
                            {
                                <span style="font-size: 11px; color: #64748B;">@FormatDate(_trackingOrder.Date)</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="mobile-order-action-btn btn-navy" style="width: 100%; padding: 10px;" @onclick="CloseTracking">
                Close Tracking
            </button>
        </div>
    </div>
}

@code {
    private static readonly string[] Filters = OrderFlow.CustomerTabs;

    private string _filter = "All";
    private MockOrder? _selectedOrder;
    private MockOrder? _trackingOrder;
    private MockOrder? _reviewOrder;
    private MockOrder? _pendingReceived;
    private bool _savingReceived;
    private MockOrderItem? _reviewItem;

    private IEnumerable<MockOrder> FilteredOrders => OrderService.Filter(_filter);

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += OnAuthChanged;
        OrderService.OnChange += Refresh;
        await OrderService.EnsureLoadedAsync(Auth.Email);
        await Catalog.EnsureLoadedAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        await OrderService.EnsureLoadedAsync(Auth.Email);
        StateHasChanged();
    });

    private void SetFilter(string filter) => _filter = filter;

    private static string FormatDate(DateTime date) => date.ToString("MMM d, yyyy");

    private void OpenDetails(MockOrder order) => _selectedOrder = order;
    private void CloseDetails() => _selectedOrder = null;

    private void AskReceived(MockOrder order)
    {
        if (!order.CanConfirmReceived)
            return;
        _pendingReceived = order;
    }

    private void CloseReceivedConfirm()
    {
        if (_savingReceived) return;
        _pendingReceived = null;
    }

    private async Task ConfirmReceived()
    {
        if (_pendingReceived is null || _savingReceived)
            return;

        _savingReceived = true;
        try
        {
            var updated = await OrderService.ConfirmReceivedAsync(_pendingReceived.Id);
            _pendingReceived = null;
            if (_selectedOrder?.Id.Equals(updated.Id, StringComparison.OrdinalIgnoreCase) == true)
                _selectedOrder = updated;
            if (_filter == OrderFlow.ToReceive)
                _filter = OrderFlow.Completed;
            Toast.Show("Order marked as received.");
        }
        catch (Exception ex)
        {
            Toast.Show(string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to confirm this order."
                : ex.Message);
        }
        finally
        {
            _savingReceived = false;
        }
    }

    private void TrackOrder(MockOrder order) => _trackingOrder = order;
    private void CloseTracking() => _trackingOrder = null;

    private void OpenReview(MockOrder order, MockOrderItem? item = null)
    {
        if (!order.CanWriteReview)
            return;
        _reviewOrder = order;
        _reviewItem = item;
    }

    private void OpenReviewFromDetails(MockOrderItem item)
    {
        if (_selectedOrder is null)
            return;
        OpenReview(_selectedOrder, item);
    }

    private void CloseReview()
    {
        _reviewOrder = null;
        _reviewItem = null;
    }

    private void OnReviewSubmitted()
    {
        if (_selectedOrder is not null)
        {
            _selectedOrder = OrderService.Orders.FirstOrDefault(o => o.Id == _selectedOrder.Id)
                ?? _selectedOrder;
        }

        if (_reviewOrder is not null)
        {
            _reviewOrder = OrderService.Orders.FirstOrDefault(o => o.Id == _reviewOrder.Id)
                ?? _reviewOrder;
        }
    }

    private async Task BuyAgain(MockOrder order)
    {
        int added = 0;
        foreach (var item in order.Items)
        {
            var prod = Catalog.Products.FirstOrDefault(p => p.Id == item.ProductId || p.Name.Equals(item.Name, StringComparison.OrdinalIgnoreCase));
            if (prod is not null)
            {
                Cart.Add(prod, item.Quantity, item.Color ?? prod.Colors.FirstOrDefault(), item.Size);
                added++;
            }
        }

        if (added > 0)
        {
            await Cart.PersistAsync(Auth.Email);
            Toast.Show("Items from order re-added to cart!");
            Navigation.NavigateTo("/cart");
        }
        else
        {
            Toast.Show("Browsing catalog for similar items...");
            Navigation.NavigateTo("/shop");
        }
    }

    private void CancelOrder(string orderId)
    {
        OrderService.Cancel(orderId);
        CloseDetails();
        Toast.Show($"Order #{orderId} has been cancelled.");
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChanged;
        OrderService.OnChange -= Refresh;
    }
}
