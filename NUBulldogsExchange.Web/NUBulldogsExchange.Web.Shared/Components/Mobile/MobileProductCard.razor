@namespace NUBulldogsExchange.Web.Shared.Components.Mobile
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject WishlistService Wishlist
@inject CartService Cart
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<article class="product-card" @onclick="GoToDetails">
    <div class="product-image">
        @if (!string.IsNullOrWhiteSpace(Product.Badge))
        {
            <span class="product-badge @BadgeClass">@Product.Badge</span>
        }
        else if (Rank is > 0)
        {
            <span class="product-badge badge-best">#@Rank Top</span>
        }
        <button type="button"
                class="mobile-fav-btn @(IsWishlisted ? "active" : "")"
                title="Wishlist"
                @onclick="ToggleWishlist"
                @onclick:stopPropagation="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="@(IsWishlisted ? "#EF4444" : "none")" stroke="@(IsWishlisted ? "#EF4444" : "#94A3B8")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
        </button>
        <img src="@Product.ImageUrl"
             alt="@Product.Name"
             loading="lazy"
             onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
    </div>

    <div class="product-info">
        <h3 class="product-title">@Product.Name</h3>

        <div class="mobile-rating-row">
            <span class="star-icon">⭐</span>
            <span class="rating-num">@(Product.Rating > 0 ? Product.Rating.ToString("0.0") : "4.8")</span>
            <span class="rating-dot">·</span>
            <span class="sold-count">@(Product.Sold > 0 ? Product.Sold.ToString("N0") : "120") sold</span>
        </div>

        <div class="product-bottom">
            <div class="price-wrap">
                <span class="current-price">₱@Product.Price.ToString("N0")</span>
                @if (Product.OriginalPrice is decimal original && original > Product.Price)
                {
                    <s class="original-price">₱@original.ToString("N0")</s>
                }
            </div>
            <button type="button"
                    class="mobile-add-btn"
                    title="Add to cart"
                    @onclick="AddToCart"
                    @onclick:stopPropagation="true">
                <Icon Name="plus" Size="18" />
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = null!;
    [Parameter] public int? Rank { get; set; }

    private bool IsWishlisted => Wishlist.Contains(Product.Id);

    private string BadgeClass => (Product.Badge ?? string.Empty) switch
    {
        "Best Seller" => "badge-best",
        "Sale" => "badge-sale",
        "New" => "badge-new",
        "Limited" => "badge-limited",
        _ => "badge-best"
    };

    protected override void OnInitialized()
    {
        Wishlist.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void GoToDetails() => Navigation.NavigateTo($"/product/{Product.Id}");

    private async Task ToggleWishlist()
    {
        Wishlist.Toggle(Product.Id);
        await Wishlist.PersistAsync(JS, Auth.Email);
        Toast.Show(IsWishlisted ? $"Saved {Product.Name} to Wishlist." : $"Removed {Product.Name} from Wishlist.");
    }

    private async Task AddToCart()
    {
        var defaultSize = Product.Sizes.FirstOrDefault();
        var defaultColor = Product.Colors.FirstOrDefault();
        Cart.Add(Product, 1, defaultColor, defaultSize);
        await Cart.PersistAsync(Auth.Email);
        Toast.Show($"Added {Product.Name} to cart!");
    }

    public void Dispose()
    {
        Wishlist.OnChange -= Refresh;
    }
}
