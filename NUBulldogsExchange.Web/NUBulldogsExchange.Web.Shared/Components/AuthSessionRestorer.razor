@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject WishlistService Wishlist
@inject CartService Cart
@inject IJSRuntime JS
@implements IDisposable

@code {
    private bool _restored;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
        Wishlist.OnChange += OnWishlistChanged;
        Cart.OnChange += OnCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored)
            return;

        _restored = true;
        await Auth.RestoreAsync(JS);
        if (Auth.IsLoggedIn)
        {
            await Wishlist.RestoreAsync(JS, Auth.Email);
            await Cart.RestoreAsync(Auth.Email);
        }
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Auth.IsLoggedIn)
            {
                await Wishlist.RestoreAsync(JS, Auth.Email);
                await Cart.RestoreAsync(Auth.Email);
            }
        });
    }

    private void OnWishlistChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Auth.IsLoggedIn)
                await Wishlist.PersistAsync(JS, Auth.Email);
        });
    }

    private void OnCartChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Auth.IsLoggedIn)
                await Cart.PersistAsync(Auth.Email);
        });
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChanged;
        Wishlist.OnChange -= OnWishlistChanged;
        Cart.OnChange -= OnCartChanged;
    }
}
