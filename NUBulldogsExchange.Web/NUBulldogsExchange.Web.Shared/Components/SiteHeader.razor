@namespace NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject NavigationManager Navigation
@inject CartService Cart
@inject WishlistService Wishlist
@inject AuthService Auth
@inject NotificationService Notifications
@inject IJSRuntime JS
@implements IDisposable

<div class="top-header container">
    <button type="button" class="mobile-menu-btn" @onclick="ToggleMobile" aria-label="Open menu">
        <Icon Name="menu" Size="22" />
    </button>

    <a href="/" class="brand" @onclick="CloseMenus">
        <div class="brand-icon">NU</div>
        <div>
            <div class="brand-title">NU Bulldogs</div>
            <div class="brand-subtitle">Exchange</div>
        </div>
    </a>

    <div class="search-box">
        <button type="button" class="search-submit" title="Search" aria-label="Search" @onclick="SubmitSearch">
            <Icon Name="search" Size="18" CssClass="search-icon" />
        </button>
        <input type="search"
               placeholder="Search shirts, hoodies, accessories..."
               value="@_query"
               @oninput="OnSearchInput"
               @onkeydown="OnSearchKey" />
    </div>

    <div class="header-actions">
        <a href="/wishlist" class="icon-button" title="Wishlist" aria-label="Wishlist">
            <Icon Name="heart" Size="20" />
            @if (Auth.IsLoggedIn && Wishlist.Count > 0)
            {
                <span class="badge-count">@Wishlist.Count</span>
            }
        </a>
        <a href="/notifications" class="icon-button" title="Notifications" aria-label="Notifications">
            <Icon Name="bell" Size="20" />
            @if (Auth.IsLoggedIn && Notifications.UnreadCount > 0)
            {
                <span class="badge-count">@Notifications.UnreadCount</span>
            }
        </a>
        <a href="/cart" class="icon-button" title="Cart" aria-label="Shopping cart">
            <Icon Name="cart" Size="20" />
            @if (Cart.TotalCount > 0)
            {
                <span class="badge-count">@Cart.TotalCount</span>
            }
        </a>

        @if (Auth.IsLoggedIn && Auth.CurrentUser is not null)
        {
            <div class="header-profile">
                <button type="button"
                        class="header-avatar-btn @(_isProfileMenuOpen ? "open" : "")"
                        title="@Auth.DisplayName"
                        aria-label="Account menu"
                        aria-expanded="@_isProfileMenuOpen"
                        @onclick="ToggleProfileMenu"
                        @onclick:stopPropagation="true">
                    <span class="header-avatar">@Auth.Initial</span>
                    <Icon Name="chevron-down" Size="14" CssClass="header-avatar-chevron" />
                </button>

                @if (_isProfileMenuOpen)
                {
                    <div class="profile-menu" role="menu" @onclick:stopPropagation="true">
                        <div class="profile-menu-user">
                            <strong>@Auth.DisplayName</strong>
                            <span>@Auth.Email</span>
                        </div>

                        @if (Auth.IsCustomer)
                        {
                            <a href="/account" class="profile-menu-item" role="menuitem" @onclick="CloseProfileMenu">
                                <Icon Name="user" Size="16" />
                                My Account
                            </a>
                            <a href="/orders" class="profile-menu-item" role="menuitem" @onclick="CloseProfileMenu">
                                <Icon Name="package" Size="16" />
                                My Orders
                            </a>
                        }
                        else if (Auth.IsAdmin)
                        {
                            <a href="/admin/dashboard" class="profile-menu-item" role="menuitem" @onclick="CloseProfileMenu">
                                <Icon Name="layout-dashboard" Size="16" />
                                Admin Portal
                            </a>
                        }

                        <div class="profile-menu-sep"></div>

                        <button type="button" class="profile-menu-item profile-menu-logout" role="menuitem" @onclick="Logout">
                            <Icon Name="log-out" Size="16" />
                            Logout
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <a href="@LoginHref" class="login-button">Login</a>
        }
    </div>
</div>

@if (_isProfileMenuOpen)
{
    <div class="profile-menu-backdrop" @onclick="CloseProfileMenu" @onkeydown="OnEscape"></div>
}

@if (_mobileOpen)
{
    <div class="mobile-nav-overlay" @onclick="CloseMobile"></div>
    <div class="mobile-nav-drawer">
        <div class="mobile-nav-header">
            <span>Menu</span>
            <button type="button" class="icon-button" @onclick="CloseMobile" aria-label="Close menu">
                <Icon Name="x" Size="20" />
            </button>
        </div>
        <nav class="mobile-nav-links">
            <a href="/" @onclick="CloseMobile">Home</a>
            <a href="/shop" @onclick="CloseMobile">Shop</a>
            <a href="/new-arrivals" @onclick="CloseMobile">New Arrivals</a>
            <a href="/best-sellers" @onclick="CloseMobile">Best Sellers</a>
            <a href="/apparel" @onclick="CloseMobile">Apparel</a>
            <a href="/accessories" @onclick="CloseMobile">Accessories</a>
            <a href="/school-essentials" @onclick="CloseMobile">School Essentials</a>
            <a href="/wishlist" @onclick="CloseMobile">Wishlist</a>
            <a href="/cart" @onclick="CloseMobile">Cart</a>
            @if (Auth.IsLoggedIn && Auth.CurrentUser is not null)
            {
                <div class="mobile-user-block">
                    <strong>@Auth.DisplayName</strong>
                    <span>@Auth.Email</span>
                </div>
                @if (Auth.IsCustomer)
                {
                    <a href="/account" @onclick="CloseMobile">My Account</a>
                    <a href="/orders" @onclick="CloseMobile">My Orders</a>
                }
                <button type="button" class="mobile-logout-btn" @onclick="LogoutMobile">Logout</button>
            }
            else
            {
                <a href="@LoginHref" @onclick="CloseMobile">Login</a>
            }
        </nav>
    </div>
}

@code {
    private string _query = string.Empty;
    private bool _mobileOpen;
    private bool _isProfileMenuOpen;

    private string LoginHref
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (string.IsNullOrWhiteSpace(path))
                return "/login?returnUrl=%2F";

            var relative = "/" + path;
            if (relative.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
                return "/login";

            return $"/login?returnUrl={Uri.EscapeDataString(relative)}";
        }
    }

    protected override void OnInitialized()
    {
        Cart.OnChange += Refresh;
        Wishlist.OnChange += Refresh;
        Auth.OnChange += Refresh;
        Notifications.OnChange += Refresh;
        Navigation.LocationChanged += OnLocationChanged;
        SyncQueryFromUrl();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isProfileMenuOpen = false;
        SyncQueryFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void SyncQueryFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _query = GetQueryValue(uri, "q")
            ?? GetQueryValue(uri, "search")
            ?? string.Empty;
    }

    private static string? GetQueryValue(Uri uri, string key)
    {
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query)) return null;

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 0) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[0]), key, StringComparison.OrdinalIgnoreCase))
                continue;
            return pair.Length > 1 ? Uri.UnescapeDataString(pair[1]) : string.Empty;
        }

        return null;
    }

    private void ToggleMobile()
    {
        _mobileOpen = !_mobileOpen;
        _isProfileMenuOpen = false;
    }

    private void CloseMobile() => _mobileOpen = false;
    private void CloseProfileMenu() => _isProfileMenuOpen = false;

    private void CloseMenus()
    {
        _mobileOpen = false;
        _isProfileMenuOpen = false;
    }

    private void ToggleProfileMenu()
    {
        _isProfileMenuOpen = !_isProfileMenuOpen;
        _mobileOpen = false;
    }

    private void OnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseProfileMenu();
    }

    private void OnSearchInput(ChangeEventArgs e) =>
        _query = e.Value?.ToString() ?? string.Empty;

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SubmitSearch();
        if (e.Key == "Escape")
            CloseProfileMenu();
    }

    private void SubmitSearch()
    {
        var trimmed = _query.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            Navigation.NavigateTo("/shop");
            return;
        }

        _query = trimmed;
        Navigation.NavigateTo($"/shop?q={Uri.EscapeDataString(trimmed)}");
    }

    private async Task Logout()
    {
        CloseMenus();
        await Auth.LogoutAsync(JS);
        Navigation.NavigateTo("/");
    }

    private async Task LogoutMobile()
    {
        CloseMenus();
        await Auth.LogoutAsync(JS);
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Cart.OnChange -= Refresh;
        Wishlist.OnChange -= Refresh;
        Auth.OnChange -= Refresh;
        Notifications.OnChange -= Refresh;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
