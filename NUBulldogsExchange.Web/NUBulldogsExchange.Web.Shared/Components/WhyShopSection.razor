@namespace NUBulldogsExchange.Web.Shared.Components

<section class="home-section why-section">
    <div class="container">
        <div class="section-header">
            <div>
                <h2>Why Shop With Us?</h2>
                <p>Your trusted university merchandise store</p>
            </div>
        </div>
        <div class="why-grid">
            <div class="why-card">
                <div class="why-icon"><Icon Name="map-pin" Size="22" /></div>
                <div>
                    <h3>Campus Pickup</h3>
                    <p>Convenient pickup inside the NU campus.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon"><Icon Name="award" Size="22" /></div>
                <div>
                    <h3>Quality Merchandise</h3>
                    <p>Products selected for quality and comfort.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon"><Icon Name="lock" Size="22" /></div>
                <div>
                    <h3>Secure Checkout</h3>
                    <p>Secure checkout experience.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon"><Icon Name="package" Size="22" /></div>
                <div>
                    <h3>Easy Order Tracking</h3>
                    <p>Track your order from processing to completion.</p>
                </div>
            </div>
        </div>
    </div>
</section>
