@namespace NUBulldogsExchange.Web.Shared.Components

<section class="why-section">
    <div class="container">
        <div class="center-title">
            <h2>Why Shop With Us?</h2>
            <p>Your trusted university merchandise store</p>
        </div>
        <div class="why-grid">
            <div class="why-card">
                <div class="why-icon"><Icon Name="map-pin" Size="24" /></div>
                <h3>Campus Pickup</h3>
                <p>Convenient pickup inside the NU campus. Free and hassle-free.</p>
            </div>
            <div class="why-card">
                <div class="why-icon"><Icon Name="package" Size="24" /></div>
                <h3>Quality Merchandise</h3>
                <p>Products selected for quality, comfort, and authentic Bulldog spirit.</p>
            </div>
            <div class="why-card">
                <div class="why-icon"><Icon Name="shield" Size="24" /></div>
                <h3>Secure Checkout</h3>
                <p>Your payment information is protected with industry-standard encryption.</p>
            </div>
            <div class="why-card">
                <div class="why-icon"><Icon Name="headphones" Size="24" /></div>
                <h3>Easy Order Tracking</h3>
                <p>Track your merchandise from processing to pickup completion.</p>
            </div>
        </div>
    </div>
</section>
