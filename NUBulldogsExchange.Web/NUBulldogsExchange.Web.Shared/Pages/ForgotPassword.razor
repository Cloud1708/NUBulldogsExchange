@page "/forgot-password"
@layout AuthLayout
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Forgot Password | NU Bulldogs Exchange</PageTitle>

<div class="auth-page auth-page-simple">
    <aside class="auth-brand-panel auth-brand-panel-compact">
        <div class="auth-brand-bg" aria-hidden="true"></div>
        <div class="auth-brand-inner">
            <a href="/" class="brand auth-logo">
                <div class="brand-icon auth-logo-icon">NU</div>
                <div>
                    <div class="brand-title">NU Bulldogs</div>
                    <div class="brand-subtitle">Exchange</div>
                </div>
            </a>
            <div class="auth-brand-hero">
                <h1 class="auth-hero-title">
                    Reset your<br />
                    <span>password.</span>
                </h1>
                <p class="auth-hero-desc">
                    Enter your registered email address and we'll send you a verification code to reset your password.
                </p>
            </div>
            <p class="auth-copyright">© 2026 NU Bulldogs Exchange</p>
        </div>
    </aside>

    <section class="auth-form-panel">
        <div class="auth-form-stack">
            @if (_step is not Step.Success and not Step.SendingCode)
            {
                <ol class="auth-steps" aria-label="Password reset progress">
                    <li class="@StepClass(1)">
                        <span class="auth-step-marker">@(VisualStep > 1 ? "✓" : "1")</span>
                        <span>Enter Email</span>
                    </li>
                    <li class="@StepClass(2)">
                        <span class="auth-step-marker">@(VisualStep > 2 ? "✓" : "2")</span>
                        <span>Verify Code</span>
                    </li>
                    <li class="@StepClass(3)">
                        <span class="auth-step-marker">3</span>
                        <span>New Password</span>
                    </li>
                </ol>
            }

            <div class="auth-login-card">
                @if (_step == Step.SendingCode)
                {
                    <h1>Sending Verification Code</h1>
                    <p class="auth-subtitle">
                        Please wait while we send a 6-digit verification code to your email.
                    </p>
                    <div class="auth-send-wait" role="status" aria-live="polite">
                        <span class="auth-spinner" aria-hidden="true"></span>
                        <strong>Sending code...</strong>
                        <small>If an account exists for this email, a verification code will be sent.</small>
                    </div>
                }
                else if (_step == Step.EnterEmail)
                {
                    <h1>Forgot Password</h1>
                    <p class="auth-subtitle">
                        Enter your registered email address and we'll send you a verification code to reset your password.
                    </p>

                    <form class="auth-form" @onsubmit="SendCodeAsync" @onsubmit:preventDefault="true" novalidate>
                        <div class="auth-field">
                            <label for="forgot-email">Email Address <span class="auth-req">*</span></label>
                            <div class="auth-input-wrap @(_emailError is not null ? "has-error" : "")">
                                <Icon Name="mail" Size="18" CssClass="auth-input-icon" />
                                <input id="forgot-email"
                                       type="email"
                                       autocomplete="email"
                                       inputmode="email"
                                       placeholder="you@example.com"
                                       value="@_email"
                                       aria-invalid="@(_emailError is not null)"
                                       aria-describedby="@(_emailError is not null ? "forgot-email-error" : null)"
                                       disabled="@_busy"
                                       @oninput="OnEmailInput" />
                            </div>
                            @if (_emailError is not null)
                            {
                                <span id="forgot-email-error" class="auth-field-error">@_emailError</span>
                            }
                        </div>
                        <button type="submit" class="btn btn-navy btn-block auth-primary-btn" disabled="@_busy">
                            Send Verification Code
                        </button>
                    </form>

                    <a href="/login" class="btn btn-outline-navy btn-block">Back to Login</a>
                }
                else if (_step == Step.VerifyCode)
                {
                    <h1>Verify Your Email</h1>
                    <p class="auth-subtitle">
                        We sent a 6-digit verification code to:<br />
                        <strong>@AuthValidation.MaskEmail(_email)</strong>
                    </p>
                    <p class="auth-muted-note">@_genericSentMessage</p>

                    <form class="auth-form" @onsubmit="VerifyCodeAsync" @onsubmit:preventDefault="true" novalidate>
                        <div class="auth-field">
                            <span class="auth-otp-label" id="forgot-otp-label">Verification code</span>
                            <div class="auth-otp @(_otpError is not null ? "has-error" : "")"
                                 role="group"
                                 aria-labelledby="forgot-otp-label"
                                 aria-describedby="@(_otpError is not null ? "forgot-otp-error" : "forgot-otp-hint")">
                                @for (var i = 0; i < 6; i++)
                                {
                                    var index = i;
                                    <input id="@($"forgot-otp-{index}")"
                                           class="auth-otp-box"
                                           type="text"
                                           inputmode="numeric"
                                           autocomplete="@(index == 0 ? "one-time-code" : "off")"
                                           maxlength="6"
                                           aria-label="@($"Digit {index + 1} of 6")"
                                           value="@_otp[index]"
                                           disabled="@_busy"
                                           @oninput="e => OnOtpInput(index, e)"
                                           @onkeydown="e => OnOtpKeyDown(index, e)" />
                                }
                            </div>
                            @if (_otpError is not null)
                            {
                                <span id="forgot-otp-error" class="auth-field-error" role="alert">
                                    <Icon Name="x-circle" Size="14" /> @_otpError
                                </span>
                            }
                            else
                            {
                                <span id="forgot-otp-hint" class="auth-otp-timer">
                                    @if (CodeExpired)
                                    {
                                        <span>Verification code expired.</span>
                                    }
                                    else
                                    {
                                        <span>Code expires in @FormatCountdown(CodeRemaining)</span>
                                    }
                                </span>
                            }
                        </div>

                        <div class="auth-resend-box">
                            <p>
                                <Icon Name="shield" Size="14" />
                                Didn't receive the code?
                            </p>
                            @if (ResendRemaining > TimeSpan.Zero)
                            {
                                <small>You can resend a new code in @FormatCountdown(ResendRemaining).</small>
                                <button type="button" class="btn btn-outline-navy btn-block" disabled>Resend Code</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-navy btn-block" disabled="@_busy" @onclick="ResendCodeAsync">
                                    Resend Code
                                </button>
                            }
                        </div>

                        <button type="submit" class="btn btn-navy btn-block auth-primary-btn" disabled="@(!CanVerify || _busy)">
                            Verify Code
                        </button>
                    </form>

                    <button type="button" class="auth-text-back" disabled="@_busy" @onclick="ChangeEmail">
                        <Icon Name="arrow-left" Size="16" /> Change Email
                    </button>
                }
                else if (_step is Step.NewPassword or Step.Resetting)
                {
                    var lengthOk = AuthValidation.MeetsPasswordPolicy(_newPassword);
                    var caseOk = AuthValidation.HasUpperAndLower(_newPassword);
                    var digitOk = AuthValidation.HasDigit(_newPassword);
                    var specialOk = AuthValidation.HasSpecial(_newPassword);
                    var matchOk = !string.IsNullOrEmpty(_confirmPassword) &&
                                  string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal);

                    <h1>Create New Password</h1>
                    <p class="auth-subtitle">Create a new password for your account.</p>

                    <form class="auth-form" @onsubmit="ResetPasswordAsync" @onsubmit:preventDefault="true" novalidate>
                        <div class="auth-field">
                            <label for="forgot-new-password">New Password <span class="auth-req">*</span></label>
                            <div class="auth-input-wrap @(_passwordError is not null ? "has-error" : "")">
                                <Icon Name="lock" Size="18" CssClass="auth-input-icon" />
                                <input id="forgot-new-password"
                                       type="@(_showNew ? "text" : "password")"
                                       autocomplete="new-password"
                                       placeholder="Enter a new password"
                                       value="@_newPassword"
                                       aria-invalid="@(_passwordError is not null)"
                                       disabled="@_busy"
                                       @oninput="OnNewPasswordInput" />
                                <button type="button"
                                        class="auth-eye-btn"
                                        title="@(_showNew ? "Hide password" : "Show password")"
                                        aria-label="@(_showNew ? "Hide password" : "Show password")"
                                        aria-pressed="@_showNew"
                                        @onclick="() => _showNew = !_showNew">
                                    <Icon Name="@(_showNew ? "eye-off" : "eye")" Size="18" />
                                </button>
                            </div>
                        </div>

                        <div class="auth-field">
                            <label for="forgot-confirm-password">Confirm New Password <span class="auth-req">*</span></label>
                            <div class="auth-input-wrap @(_confirmError is not null ? "has-error" : "")">
                                <Icon Name="lock" Size="18" CssClass="auth-input-icon" />
                                <input id="forgot-confirm-password"
                                       type="@(_showConfirm ? "text" : "password")"
                                       autocomplete="new-password"
                                       placeholder="Re-enter your new password"
                                       value="@_confirmPassword"
                                       aria-invalid="@(_confirmError is not null)"
                                       aria-describedby="@(_confirmError is not null ? "forgot-confirm-error" : null)"
                                       disabled="@_busy"
                                       @oninput="OnConfirmPasswordInput" />
                                <button type="button"
                                        class="auth-eye-btn"
                                        title="@(_showConfirm ? "Hide password" : "Show password")"
                                        aria-label="@(_showConfirm ? "Hide password" : "Show password")"
                                        aria-pressed="@_showConfirm"
                                        @onclick="() => _showConfirm = !_showConfirm">
                                    <Icon Name="@(_showConfirm ? "eye-off" : "eye")" Size="18" />
                                </button>
                            </div>
                            @if (_confirmError is not null)
                            {
                                <span id="forgot-confirm-error" class="auth-field-error">@_confirmError</span>
                            }
                        </div>

                        <div class="auth-pw-rules">
                            <strong>Password Requirements</strong>
                            <ul>
                                <li class="@(lengthOk ? "is-met" : "")">
                                    <Icon Name="@(lengthOk ? "check" : "minus")" Size="12" />
                                    At least @AuthValidation.MinPasswordLength characters
                                </li>
                                <li class="@(caseOk ? "is-met" : "")">
                                    <Icon Name="@(caseOk ? "check" : "minus")" Size="12" />
                                    Uppercase and lowercase letter
                                </li>
                                <li class="@(digitOk ? "is-met" : "")">
                                    <Icon Name="@(digitOk ? "check" : "minus")" Size="12" />
                                    At least one number
                                </li>
                                <li class="@(specialOk ? "is-met" : "")">
                                    <Icon Name="@(specialOk ? "check" : "minus")" Size="12" />
                                    At least one special character
                                </li>
                            </ul>
                        </div>

                        @if (_passwordError is not null)
                        {
                            <p class="auth-form-error" role="alert">@_passwordError</p>
                        }

                        <button type="submit"
                                class="btn btn-navy btn-block auth-primary-btn"
                                disabled="@(!CanReset || _busy)">
                            @(_step == Step.Resetting ? "Resetting Password..." : "Reset Password")
                        </button>
                    </form>
                }
                else
                {
                    <div class="auth-reset-success">
                        <span class="auth-success-check" aria-hidden="true">
                            <Icon Name="check" Size="32" />
                        </span>
                        <h1>Password Reset Successful</h1>
                        <p class="auth-subtitle">
                            Your password has been changed successfully.
                            You can now log in with your new password.
                        </p>
                        <a href="/login" class="btn btn-navy btn-block auth-primary-btn">Back to Login</a>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@code {
    private enum Step
    {
        EnterEmail,
        SendingCode,
        VerifyCode,
        NewPassword,
        Resetting,
        Success
    }

    private Step _step = Step.EnterEmail;
    private bool _busy;
    private string _email = string.Empty;
    private string? _emailError;
    private string _genericSentMessage = AuthService.PasswordResetGenericMessage;
    private readonly string[] _otp = ["", "", "", "", "", ""];
    private string? _otpError;
    private bool _codeLocked;
    private string? _resetToken;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private string? _confirmError;
    private bool _showNew;
    private bool _showConfirm;
    private DateTime _codeExpiresAtUtc = DateTime.MinValue;
    private DateTime _resendReadyAtUtc = DateTime.MinValue;
    private bool _focusOtp;
    private System.Threading.Timer? _ticker;

    private int VisualStep => _step switch
    {
        Step.EnterEmail or Step.SendingCode => 1,
        Step.VerifyCode => 2,
        _ => 3
    };

    private TimeSpan CodeRemaining =>
        _codeExpiresAtUtc == DateTime.MinValue ? TimeSpan.Zero : _codeExpiresAtUtc - DateTime.UtcNow;

    private TimeSpan ResendRemaining =>
        _resendReadyAtUtc == DateTime.MinValue ? TimeSpan.Zero : _resendReadyAtUtc - DateTime.UtcNow;

    private bool CodeExpired => _step == Step.VerifyCode && CodeRemaining <= TimeSpan.Zero;

    private bool CanVerify =>
        !_busy && !_codeLocked && !CodeExpired && _otp.All(d => d.Length == 1 && char.IsDigit(d[0]));

    private bool CanReset =>
        !_busy &&
        !string.IsNullOrWhiteSpace(_resetToken) &&
        AuthValidation.MeetsPasswordPolicy(_newPassword) &&
        string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal);

    private string StepClass(int step) =>
        VisualStep > step ? "is-done" : VisualStep == step ? "is-active" : "is-pending";

    private void OnEmailInput(ChangeEventArgs e)
    {
        _email = e.Value?.ToString() ?? string.Empty;
        _emailError = null;
    }

    private async Task SendCodeAsync()
    {
        if (_busy) return;
        _email = _email.Trim();
        if (!AuthValidation.IsValidEmail(_email))
        {
            _emailError = "Enter a valid email address.";
            return;
        }

        _busy = true;
        _step = Step.SendingCode;
        try
        {
            var result = await Auth.SendPasswordResetCodeAsync(_email);
            if (!result.Success)
            {
                _step = Step.EnterEmail;
                _emailError = result.Error ?? "Unable to send a verification code. Please try again.";
                Toast.Show(_emailError);
                return;
            }

            _genericSentMessage = result.Message;
            BeginVerifyTimers(result.ExpiresInSeconds, result.ResendCooldownSeconds);
            ClearOtp();
            _otpError = null;
            _codeLocked = false;
            _resetToken = null;
            _focusOtp = true;
            _step = Step.VerifyCode;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendCodeAsync()
    {
        if (_busy || ResendRemaining > TimeSpan.Zero) return;
        _busy = true;
        try
        {
            var result = await Auth.SendPasswordResetCodeAsync(_email);
            if (!result.Success)
            {
                _otpError = result.Error ?? "Unable to resend a verification code. Please try again.";
                Toast.Show(_otpError);
                return;
            }

            _genericSentMessage = result.Message;
            BeginVerifyTimers(result.ExpiresInSeconds, result.ResendCooldownSeconds);
            ClearOtp();
            _otpError = null;
            _codeLocked = false;
            _resetToken = null;
            _focusOtp = true;
            Toast.Show(_genericSentMessage);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task VerifyCodeAsync()
    {
        if (!CanVerify) return;
        if (CodeExpired)
        {
            _otpError = "Verification code expired.";
            _codeLocked = true;
            return;
        }

        _busy = true;
        _otpError = null;
        try
        {
            var result = await Auth.VerifyPasswordResetCodeAsync(_email, string.Concat(_otp));
            if (!result.Success || string.IsNullOrWhiteSpace(result.ResetToken))
            {
                _otpError = result.Error ?? "Invalid verification code. Please try again.";
                if (result.RequireNewCode)
                    _codeLocked = true;
                return;
            }

            _resetToken = result.ResetToken;
            StopTicker();
            _step = Step.NewPassword;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (_busy) return;
        _passwordError = null;
        _confirmError = null;

        if (string.IsNullOrWhiteSpace(_resetToken))
        {
            ReturnToEmail("This reset session is no longer valid. Please request a new code.");
            return;
        }

        if (!AuthValidation.MeetsPasswordPolicy(_newPassword))
        {
            _passwordError = $"Password must be at least {AuthValidation.MinPasswordLength} characters.";
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _confirmError = "Passwords do not match.";
            return;
        }

        _busy = true;
        _step = Step.Resetting;
        try
        {
            var result = await Auth.ResetPasswordWithTokenAsync(
                _email,
                _resetToken,
                _newPassword,
                _confirmPassword);
            if (!result.Success)
            {
                _step = Step.NewPassword;
                _passwordError = result.Error ?? "Unable to reset your password. Please try again.";
                if (_passwordError.Contains("session", StringComparison.OrdinalIgnoreCase) ||
                    _passwordError.Contains("expired", StringComparison.OrdinalIgnoreCase) ||
                    _passwordError.Contains("new code", StringComparison.OrdinalIgnoreCase))
                {
                    ReturnToEmail(_passwordError);
                }
                return;
            }

            _resetToken = null;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            _step = Step.Success;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ChangeEmail()
    {
        _resetToken = null;
        ClearOtp();
        _otpError = null;
        _codeLocked = false;
        StopTicker();
        _step = Step.EnterEmail;
    }

    private void ReturnToEmail(string message)
    {
        Toast.Show(message);
        ChangeEmail();
        _emailError = message;
    }

    private void OnNewPasswordInput(ChangeEventArgs e)
    {
        _newPassword = e.Value?.ToString() ?? string.Empty;
        _passwordError = null;
        if (!string.IsNullOrEmpty(_confirmPassword) &&
            !string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
            _confirmError = "Passwords do not match.";
        else
            _confirmError = null;
    }

    private void OnConfirmPasswordInput(ChangeEventArgs e)
    {
        _confirmPassword = e.Value?.ToString() ?? string.Empty;
        _confirmError = string.IsNullOrEmpty(_confirmPassword) ||
                        string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal)
            ? null
            : "Passwords do not match.";
    }

    private async Task OnOtpInput(int index, ChangeEventArgs e)
    {
        var digits = AuthValidation.DigitsOnly(e.Value?.ToString());
        if (digits.Length >= 6)
        {
            for (var i = 0; i < 6; i++)
                _otp[i] = digits[i].ToString();
            _otpError = null;
            await FocusOtpAsync(5);
            return;
        }

        if (digits.Length == 0)
        {
            _otp[index] = string.Empty;
            return;
        }

        _otp[index] = digits[^1].ToString();
        _otpError = null;
        if (index < 5)
            await FocusOtpAsync(index + 1);
    }

    private async Task OnOtpKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(_otp[index]) && index > 0)
        {
            _otp[index - 1] = string.Empty;
            await FocusOtpAsync(index - 1);
        }
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusOtpAsync(index - 1);
        }
        else if (e.Key == "ArrowRight" && index < 5)
        {
            await FocusOtpAsync(index + 1);
        }
    }

    private async Task FocusOtpAsync(int index)
    {
        try
        {
            await JS.InvokeVoidAsync("nubeFocusById", $"forgot-otp-{index}");
        }
        catch
        {
        }
    }

    private void ClearOtp()
    {
        for (var i = 0; i < _otp.Length; i++)
            _otp[i] = string.Empty;
    }

    private void BeginVerifyTimers(int expiresInSeconds, int cooldownSeconds)
    {
        var now = DateTime.UtcNow;
        _codeExpiresAtUtc = now.AddSeconds(Math.Max(1, expiresInSeconds));
        _resendReadyAtUtc = now.AddSeconds(Math.Max(0, cooldownSeconds));
        _ticker?.Dispose();
        _ticker = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void StopTicker()
    {
        _ticker?.Dispose();
        _ticker = null;
        _codeExpiresAtUtc = DateTime.MinValue;
        _resendReadyAtUtc = DateTime.MinValue;
    }

    private static string FormatCountdown(TimeSpan remaining)
    {
        if (remaining < TimeSpan.Zero)
            remaining = TimeSpan.Zero;
        return $"{(int)remaining.TotalMinutes:00}:{remaining.Seconds:00}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusOtp || _step != Step.VerifyCode)
            return;

        _focusOtp = false;
        await FocusOtpAsync(0);
    }

    public void Dispose() => _ticker?.Dispose();
}
