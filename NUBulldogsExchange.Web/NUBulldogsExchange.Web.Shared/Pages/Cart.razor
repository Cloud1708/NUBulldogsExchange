@page "/cart"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject CartService CartService
@implements IDisposable

<PageTitle>Cart | NU Bulldogs Exchange</PageTitle>

@if (!CartService.Items.Any())
{
    <section class="empty-cart-section">
        <div class="container">
            <div class="empty-cart">
                <div class="empty-cart-icon">
                    <Icon Name="shopping-bag" Size="40" />
                </div>
                <h1>Your cart is empty.</h1>
                <p>Looks like you haven't added any Bulldog gear yet.</p>
                <a href="/shop" class="btn btn-navy empty-cart-btn">Start Shopping</a>
            </div>
        </div>
    </section>
}
else
{
    <PageBanner Title="Shopping Cart"
                Subtitle="Review your selected merch before checkout" />

    <section class="section section-light">
        <div class="container">
            <div class="cart-layout">
                <div class="cart-list">
                    @foreach (var item in CartService.Items)
                    {
                        <div class="cart-item">
                            <img src="@item.Product.ImageUrl"
                                 alt="@item.Product.Name"
                                 onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                            <div class="cart-item-info">
                                <small>@item.Product.Category</small>
                                <a href="/product/@item.Product.Id"><h3>@item.Product.Name</h3></a>
                                @if (!string.IsNullOrWhiteSpace(item.SelectedColor) || !string.IsNullOrWhiteSpace(item.SelectedSize))
                                {
                                    <p class="cart-item-variant">
                                        @if (!string.IsNullOrWhiteSpace(item.SelectedColor))
                                        {
                                            <span>@MockData.FormatColorName(item.SelectedColor)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.SelectedColor) && !string.IsNullOrWhiteSpace(item.SelectedSize))
                                        {
                                            <span>·</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.SelectedSize))
                                        {
                                            <span>@item.SelectedSize</span>
                                        }
                                    </p>
                                }
                                <strong>₱@item.Product.Price.ToString("N0")</strong>
                            </div>
                            <div class="qty-controls">
                                <button type="button" @onclick="() => CartService.UpdateQuantity(item.Key, item.Quantity - 1)">
                                    <Icon Name="minus" Size="14" />
                                </button>
                                <span>@item.Quantity</span>
                                <button type="button" @onclick="() => CartService.UpdateQuantity(item.Key, item.Quantity + 1)">
                                    <Icon Name="plus" Size="14" />
                                </button>
                            </div>
                            <button type="button" class="link-danger" @onclick="() => CartService.Remove(item.Key)">Remove</button>
                        </div>
                    }
                </div>
                <aside class="cart-summary">
                    <h3>Order Summary</h3>
                    <div class="summary-row"><span>Items</span><span>@CartService.TotalCount</span></div>
                    <div class="summary-row"><span>Subtotal</span><strong>₱@CartService.Subtotal.ToString("N0")</strong></div>
                    <div class="summary-row"><span>Campus Pickup</span><span class="text-success">Free</span></div>
                    <div class="summary-total"><span>Total</span><strong>₱@CartService.Subtotal.ToString("N0")</strong></div>
                    <button type="button" class="btn btn-gold btn-block" @onclick="CheckoutDemo">Proceed to Checkout</button>
                    <p class="summary-note">Frontend demo only — no payment is processed.</p>
                    @if (!string.IsNullOrEmpty(_checkoutMsg))
                    {
                        <p class="newsletter-success">@_checkoutMsg</p>
                    }
                </aside>
            </div>
        </div>
    </section>
}

@code {
    private string? _checkoutMsg;

    protected override void OnInitialized() => CartService.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);

    private void CheckoutDemo()
    {
        _checkoutMsg = "Checkout mockup complete. In a real app, this would continue to payment.";
        CartService.Clear();
    }

    public void Dispose() => CartService.OnChange -= Refresh;
}
