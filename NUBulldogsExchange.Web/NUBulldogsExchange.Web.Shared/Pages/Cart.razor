@page "/cart"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject CartService CartService
@inject WishlistService Wishlist
@inject AuthService Auth
@inject ToastService Toast
@inject AdminPromotionService PromotionService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>My Shopping Cart | NU Bulldogs Exchange</PageTitle>

@if (!CartService.Items.Any())
{
    <section class="empty-cart-section">
        <div class="container">
            <div class="empty-cart">
                <div class="empty-cart-icon">
                    <Icon Name="shopping-bag" Size="40" />
                </div>
                <h1>Your cart is empty.</h1>
                <p>Looks like you haven't added any Bulldog gear yet.</p>
                <a href="/shop" class="btn btn-navy empty-cart-btn">Start Shopping</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="cart-page">
        <div class="container">
            <nav class="shop-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <Icon Name="chevron-right" Size="14" />
                <span>My Shopping Cart</span>
            </nav>

            <div class="cart-title-row">
                <h1>My Shopping Cart</h1>
                <span>@QuantityLabel(CartService.TotalCount)</span>
            </div>

            <div class="cart-layout">
                <div class="cart-list">
                    <div class="cart-select-all">
                        <label>
                            <input type="checkbox"
                                   checked="@AllSelected"
                                   @onchange="OnSelectAllChanged" />
                            <span>Select All (@LineItemLabel(CartService.Items.Count))</span>
                        </label>
                    </div>

                    @foreach (var item in CartService.Items)
                    {
                        var selected = _selected.Contains(item.Key);
                        var maxStock = item.Product.Stock > 0 ? item.Product.Stock : int.MaxValue;
                        var lineTotal = item.Product.Price * item.Quantity;

                        <article class="cart-item @(selected ? "selected" : "")">
                            <label class="cart-item-check">
                                <input type="checkbox"
                                       checked="@selected"
                                       @onchange="() => ToggleSelected(item.Key)" />
                            </label>

                            <a href="/product/@item.Product.Id" class="cart-item-image">
                                <img src="@item.Product.ImageUrl"
                                     alt="@item.Product.Name"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                            </a>

                            <div class="cart-item-body">
                                <div class="cart-item-top">
                                    <div class="cart-item-info">
                                        <small>@item.Product.Category</small>
                                        <a href="/product/@item.Product.Id"><h3>@item.Product.Name</h3></a>
                                        <p class="cart-item-variant">
                                            @if (!string.IsNullOrWhiteSpace(item.SelectedSize))
                                            {
                                                <span>Size: @item.SelectedSize</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.SelectedSize) && !string.IsNullOrWhiteSpace(item.SelectedColor))
                                            {
                                                <span>·</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.SelectedColor))
                                            {
                                                <span class="cart-item-color">
                                                    Color:
                                                    <span class="dot @item.SelectedColor" title="@MockData.FormatColorName(item.SelectedColor)"></span>
                                                </span>
                                            }
                                        </p>
                                    </div>
                                    <strong class="cart-item-price">₱@item.Product.Price.ToString("N0")</strong>
                                </div>

                                <div class="qty-controls cart-item-qty">
                                    <button type="button"
                                            disabled="@(item.Quantity <= 1)"
                                            aria-label="Decrease quantity"
                                            @onclick="() => CartService.UpdateQuantity(item.Key, item.Quantity - 1)">
                                        <Icon Name="minus" Size="14" />
                                    </button>
                                    <span>@item.Quantity</span>
                                    <button type="button"
                                            disabled="@(item.Quantity >= maxStock)"
                                            aria-label="Increase quantity"
                                            @onclick="() => CartService.UpdateQuantity(item.Key, item.Quantity + 1)">
                                        <Icon Name="plus" Size="14" />
                                    </button>
                                </div>

                                <div class="cart-item-bottom">
                                    <span class="cart-item-subtotal">Subtotal: ₱@lineTotal.ToString("N0")</span>
                                    <div class="cart-item-actions">
                                        <button type="button"
                                                class="cart-icon-btn @(Auth.IsLoggedIn && Wishlist.Contains(item.Product.Id) ? "active" : "")"
                                                title="Wishlist"
                                                @onclick="() => ToggleWishlist(item.Product)">
                                            <Icon Name="heart" Size="16" />
                                        </button>
                                        <button type="button"
                                                class="cart-icon-btn cart-icon-remove"
                                                title="Remove"
                                                @onclick="() => RemoveItem(item.Key)">
                                            <Icon Name="trash" Size="16" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }

                    <a href="/shop" class="cart-continue-link">
                        <Icon Name="arrow-left" Size="16" />
                        Continue Shopping
                    </a>
                </div>

                <aside class="cart-summary">
                    <h3>Order Summary</h3>

                    <div class="summary-row">
                        <span>Subtotal (@LineItemLabel(SelectedItems.Count()))</span>
                        <span>₱@SelectedSubtotal.ToString("N0")</span>
                    </div>
                    <div class="summary-row">
                        <span>Pickup Fee</span>
                        <span class="text-success">Free</span>
                    </div>
                    @if (_promoApplied && !string.IsNullOrWhiteSpace(CartService.AppliedPromoCode))
                    {
                        <div class="summary-row">
                            <span>Discount (@CartService.AppliedPromoCode)</span>
                            <span class="text-success">-₱@Discount.ToString("N0")</span>
                        </div>
                    }

                    <div class="summary-total">
                        <span>Estimated Total</span>
                        <strong>₱@EstimatedTotal.ToString("N0")</strong>
                    </div>

                    <div class="cart-promo">
                        <input type="text"
                               placeholder="Enter promo code"
                               value="@_promoCode"
                               disabled="@_applyingPromo"
                               @oninput="OnPromoInput" />
                        @if (_promoApplied)
                        {
                            <button type="button" class="btn btn-outline-navy cart-promo-btn" @onclick="RemovePromo" disabled="@_applyingPromo">
                                Remove
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-navy cart-promo-btn" @onclick="ApplyPromoAsync" disabled="@_applyingPromo">
                                @(_applyingPromo ? "Applying…" : "Apply")
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_promoMessage))
                    {
                        <p class="@(_promoApplied ? "cart-promo-success" : "cart-promo-error")">@_promoMessage</p>
                    }

                    <button type="button"
                            class="btn btn-navy btn-block cart-checkout-btn"
                            disabled="@(!SelectedItems.Any())"
                            @onclick="ProceedToCheckout">
                        Proceed to Checkout
                    </button>
                    <a href="/shop" class="btn btn-outline-navy btn-block">Continue Shopping</a>
                </aside>
            </div>
        </div>
    </section>
}

@code {
    private readonly HashSet<string> _selected = [];
    private readonly HashSet<string> _knownKeys = [];
    private string _promoCode = string.Empty;
    private bool _promoApplied;
    private bool _applyingPromo;
    private bool _refreshingPromo;
    private string? _promoMessage;
    private decimal _discount;

    private IEnumerable<CartItem> SelectedItems =>
        CartService.Items.Where(i => _selected.Contains(i.Key));

    private bool AllSelected =>
        CartService.Items.Count > 0 && CartService.Items.All(i => _selected.Contains(i.Key));

    private decimal SelectedSubtotal =>
        SelectedItems.Sum(i => i.Product.Price * i.Quantity);

    private decimal Discount => _promoApplied ? _discount : 0;

    private decimal EstimatedTotal => Math.Max(0, SelectedSubtotal - Discount);

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += Refresh;
        Wishlist.OnChange += Refresh;
        Auth.OnChange += Refresh;
        SyncSelection();

        if (!string.IsNullOrWhiteSpace(CartService.AppliedPromoCode))
        {
            _promoCode = CartService.AppliedPromoCode;
            _promoApplied = true;
            _discount = CartService.AppliedDiscount;
            await RevalidateAppliedPromoAsync();
        }
    }

    private void Refresh()
    {
        SyncSelection();
        _ = InvokeAsync(async () =>
        {
            if (_promoApplied && !_refreshingPromo && !_applyingPromo && !string.IsNullOrWhiteSpace(_promoCode))
                await RevalidateAppliedPromoAsync();
            StateHasChanged();
        });
    }

    private void SyncSelection()
    {
        var keys = CartService.Items.Select(i => i.Key).ToHashSet();
        _selected.RemoveWhere(k => !keys.Contains(k));

        foreach (var key in keys)
        {
            if (_knownKeys.Add(key))
                _selected.Add(key);
        }

        _knownKeys.RemoveWhere(k => !keys.Contains(k));
    }

    private void OnSelectAllChanged(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b
                    || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        _selected.Clear();
        if (check)
        {
            foreach (var item in CartService.Items)
                _selected.Add(item.Key);
        }
    }

    private void ToggleSelected(string key)
    {
        if (!_selected.Add(key))
            _selected.Remove(key);
    }

    private void RemoveItem(string key)
    {
        _selected.Remove(key);
        CartService.Remove(key);
    }

    private void ToggleWishlist(Product product)
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("/wishlist");
            return;
        }

        Wishlist.Toggle(product.Id);
        Toast.Show(Wishlist.Contains(product.Id) ? "Added to wishlist." : "Removed from wishlist.");
    }

    private void OnPromoInput(ChangeEventArgs e)
    {
        _promoCode = e.Value?.ToString() ?? string.Empty;
        if (_promoApplied)
            RemovePromo();
        else
            _promoMessage = null;
    }

    private async Task ApplyPromoAsync()
    {
        if (_applyingPromo || !SelectedItems.Any())
            return;

        _applyingPromo = true;
        _promoMessage = null;
        try
        {
            var items = SelectedItems.Select(i => new PromoCartItem
            {
                ProductId = i.Product.Id,
                Quantity = i.Quantity,
                UnitPrice = i.Product.Price,
                Category = i.Product.Category
            });

            var (success, message, promo, discount) = await PromotionService.ValidateForCartAsync(
                _promoCode,
                items,
                Auth.Email,
                Auth.UserId > 0 ? Auth.UserId : null);

            _promoApplied = success;
            _discount = discount;
            _promoMessage = success
                ? $"✓ Promo code {(promo?.Code ?? _promoCode.Trim().ToUpperInvariant())} applied. You saved ₱{discount:N0}."
                : message;

            if (success && promo is not null)
            {
                _promoCode = promo.Code;
                CartService.SetPromo(promo.Code, discount);
            }
            else
            {
                CartService.ClearPromo();
            }
        }
        catch (Exception ex)
        {
            _promoApplied = false;
            _discount = 0;
            CartService.ClearPromo();
            _promoMessage = "Unable to validate promo code. Please try again.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _applyingPromo = false;
        }
    }

    private async Task RevalidateAppliedPromoAsync()
    {
        if (_refreshingPromo) return;
        _refreshingPromo = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_promoCode) || !SelectedItems.Any())
            {
                RemovePromo();
                return;
            }

            var items = SelectedItems.Select(i => new PromoCartItem
            {
                ProductId = i.Product.Id,
                Quantity = i.Quantity,
                UnitPrice = i.Product.Price,
                Category = i.Product.Category
            });

            var (success, message, promo, discount) = await PromotionService.ValidateForCartAsync(
                _promoCode,
                items,
                Auth.Email,
                Auth.UserId > 0 ? Auth.UserId : null);

            if (success && promo is not null)
            {
                _promoApplied = true;
                _discount = discount;
                _promoCode = promo.Code;
                CartService.SetPromo(promo.Code, discount);
            }
            else
            {
                _promoApplied = false;
                _discount = 0;
                CartService.ClearPromo();
                _promoMessage = message;
            }
        }
        finally
        {
            _refreshingPromo = false;
        }
    }

    private void RemovePromo()
    {
        _promoApplied = false;
        _discount = 0;
        _promoMessage = null;
        CartService.ClearPromo();
    }

    private async Task ProceedToCheckout()
    {
        if (!SelectedItems.Any())
            return;

        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("/login?returnUrl=%2Fcheckout&redirect=%2Fcheckout");
            return;
        }

        var keep = SelectedItems.Select(i => i.Key).ToHashSet();
        foreach (var item in CartService.Items.Where(i => !keep.Contains(i.Key)).ToList())
            CartService.Remove(item.Key);

        if (_promoApplied && !string.IsNullOrWhiteSpace(_promoCode))
        {
            await RevalidateAppliedPromoAsync();
            if (!_promoApplied)
                return;
            CartService.SetPromo(_promoCode, _discount);
        }
        else
        {
            CartService.ClearPromo();
        }

        Navigation.NavigateTo("/checkout");
    }

    private static string QuantityLabel(int count) =>
        count == 1 ? "1 item" : $"{count} items";

    private static string LineItemLabel(int count) =>
        count == 1 ? "1 item" : $"{count} items";

    public void Dispose()
    {
        CartService.OnChange -= Refresh;
        Wishlist.OnChange -= Refresh;
        Auth.OnChange -= Refresh;
    }
}
