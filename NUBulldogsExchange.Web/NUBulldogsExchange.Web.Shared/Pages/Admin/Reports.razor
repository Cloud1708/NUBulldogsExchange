@page "/admin/reports"
@layout AdminLayout
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AdminReportService ReportService
@inject ToastService Toast
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Reports & Analytics | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-reports">
    <header class="admin-reports-header">
        <div>
            <h1>Reports & Analytics</h1>
            <p>Store performance at a glance</p>
        </div>
        <div class="admin-reports-controls">
            <div class="admin-reports-ranges" role="tablist" aria-label="Report range">
                @foreach (var range in AdminReportService.Ranges)
                {
                    <button type="button"
                            role="tab"
                            class="admin-reports-range @(_range == range.Key ? "active" : "")"
                            @onclick="() => SelectRange(range.Key)">
                        @range.Label
                    </button>
                }
            </div>
            <button type="button" class="btn btn-outline-navy admin-reports-export" @onclick="ExportCsv">
                <Icon Name="download" Size="15" />
                Export
            </button>
        </div>
    </header>

    @if (!_snapshot.HasData)
    {
        <section class="admin-card admin-reports-empty">
            <h2>No report data available for this period.</h2>
            <p>Try selecting another date range.</p>
        </section>
    }
    else
    {
        <div class="admin-reports-kpis">
            @foreach (var kpi in _snapshot.Kpis)
            {
                <article class="admin-reports-kpi">
                    <span>@kpi.Label</span>
                    <strong>@kpi.Value</strong>
                    <em class="@(kpi.IsPositive ? "up" : "down")">
                        <Icon Name="@(kpi.IsPositive ? "trending-up" : "trending-down")" Size="12" />
                        @kpi.Change
                    </em>
                </article>
            }
        </div>

        <div class="admin-reports-mid">
            <section class="admin-card admin-reports-sales">
                <div class="admin-card-head">
                    <div>
                        <h2>Sales Trend</h2>
                        <p>Monthly revenue and orders</p>
                    </div>
                </div>
                <div class="admin-reports-dual-chart" aria-label="Sales trend chart">
                    <div class="admin-reports-y-left">
                        <span>₱140K</span><span>₱105K</span><span>₱70K</span><span>₱35K</span><span>₱0K</span>
                    </div>
                    <div class="admin-reports-plot">
                        <svg viewBox="0 0 480 200" preserveAspectRatio="none" class="admin-reports-svg">
                            @for (var i = 0; i < 5; i++)
                            {
                                var y = 10 + i * 45;
                                <line x1="0" y1="@y" x2="480" y2="@y" class="admin-grid-line" />
                            }
                            <path d="@RevenueLine" class="admin-reports-line revenue" fill="none" />
                            <path d="@OrdersLine" class="admin-reports-line orders" fill="none" />
                            @foreach (var p in RevenuePoints)
                            {
                                <circle cx="@p.X.ToString("0.##")" cy="@p.Y.ToString("0.##")" r="3.5" class="admin-reports-dot revenue" />
                            }
                            @foreach (var p in OrdersPoints)
                            {
                                <circle cx="@p.X.ToString("0.##")" cy="@p.Y.ToString("0.##")" r="3.5" class="admin-reports-dot orders" />
                            }
                        </svg>
                        <div class="admin-line-x">
                            @foreach (var point in _snapshot.SalesTrend)
                            {
                                <span>@point.Month</span>
                            }
                        </div>
                    </div>
                    <div class="admin-reports-y-right">
                        <span>260</span><span>195</span><span>130</span><span>65</span><span>0</span>
                    </div>
                </div>
                <div class="admin-reports-legend">
                    <span><i class="dot orders"></i> Orders</span>
                    <span><i class="dot revenue"></i> Revenue</span>
                </div>
            </section>

            <section class="admin-card admin-reports-distribution">
                <div class="admin-card-head">
                    <div>
                        <h2>Order Distribution</h2>
                        <p>By status</p>
                    </div>
                </div>
                <div class="admin-donut-wrap">
                    <div class="admin-donut" style="background: @DonutGradient;" aria-hidden="true">
                        <div class="admin-donut-hole"></div>
                    </div>
                </div>
                <ul class="admin-status-legend">
                    @foreach (var slice in _snapshot.OrderDistribution)
                    {
                        <li>
                            <span class="admin-legend-dot" style="background: @slice.Color;"></span>
                            <span class="admin-legend-label">@slice.Label</span>
                            <strong>@slice.Count</strong>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <div class="admin-reports-secondary">
            <section class="admin-card">
                <div class="admin-card-head">
                    <div>
                        <h2>Revenue by Category</h2>
                        <p>Sales breakdown</p>
                    </div>
                </div>
                <div class="admin-reports-hbar" aria-label="Revenue by category">
                    @{
                        var maxCat = _snapshot.RevenueByCategory.DefaultIfEmpty().Max(c => c?.Revenue ?? 0);
                        if (maxCat <= 0) maxCat = 1;
                    }
                    @foreach (var cat in _snapshot.RevenueByCategory)
                    {
                        var width = (double)(cat.Revenue / maxCat) * 100;
                        <div class="admin-reports-hbar-row">
                            <span class="admin-reports-hbar-label">@cat.Category</span>
                            <div class="admin-reports-hbar-track">
                                <div class="admin-reports-hbar-fill" style="@($"width:{width:0.##}%")"></div>
                            </div>
                            <strong>₱@((cat.Revenue / 1000m).ToString("0"))K</strong>
                        </div>
                    }
                    @if (_snapshot.RevenueByCategory.Count == 0)
                    {
                        <p class="admin-reports-section-empty">No completed sales in this period.</p>
                    }
                    else
                    {
                        <div class="admin-reports-hbar-axis">
                            <span>₱0K</span><span>₱15K</span><span>₱30K</span><span>₱45K</span><span>₱60K</span>
                        </div>
                    }
                </div>
            </section>

            <section class="admin-card">
                <div class="admin-card-head">
                    <div>
                        <h2>Avg. Order Value</h2>
                        <p>Monthly trend</p>
                    </div>
                </div>
                <div class="admin-reports-aov" aria-label="Average order value chart">
                    <div class="admin-reports-y-left aov">
                        <span>₱600</span><span>₱450</span><span>₱300</span><span>₱150</span><span>₱0</span>
                    </div>
                    <div class="admin-reports-plot">
                        <svg viewBox="0 0 480 180" preserveAspectRatio="none" class="admin-reports-svg">
                            <defs>
                                <linearGradient id="aovFill" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#F9C424" stop-opacity="0.35" />
                                    <stop offset="100%" stop-color="#F9C424" stop-opacity="0.02" />
                                </linearGradient>
                            </defs>
                            @for (var i = 0; i < 5; i++)
                            {
                                var y = 10 + i * 40;
                                <line x1="0" y1="@y" x2="480" y2="@y" class="admin-grid-line" />
                            }
                            <path d="@AovArea" fill="url(#aovFill)" />
                            <path d="@AovLine" class="admin-reports-line aov" fill="none" />
                        </svg>
                        <div class="admin-line-x">
                            @foreach (var point in _snapshot.SalesTrend)
                            {
                                <span>@point.Month</span>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="admin-reports-product-analytics">
            <section class="admin-card admin-reports-top-card">
                <div class="admin-card-head">
                    <div>
                        <h2>Top Selling Products</h2>
                        <p>Based on units sold (@_snapshot.RangeLabel)</p>
                    </div>
                    <button type="button" class="admin-view-all" @onclick='() => ViewAllProducts("units")'>
                        View All
                    </button>
                </div>
                @if (_snapshot.TopSellingProducts.Count == 0)
                {
                    <p class="admin-reports-section-empty">No completed sales in this period.</p>
                }
                else
                {
                    <ol class="admin-reports-rank-list">
                        @foreach (var row in _snapshot.TopSellingProducts)
                        {
                            <li>
                                <span class="admin-reports-rank-num">@row.Rank</span>
                                <img src="@row.ImageUrl"
                                     alt="@row.Name"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                <div class="admin-reports-rank-body">
                                    <strong title="@row.Name">@row.Name</strong>
                                    <div class="admin-reports-rank-bar">
                                        <span style="@($"width:{row.ProgressPct:0.##}%")"></span>
                                    </div>
                                    <div class="admin-reports-rank-meta">
                                        <em>@row.UnitsSold.ToString("N0") sold</em>
                                        <span>₱@row.Revenue.ToString("N2")</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="admin-card admin-reports-top-card">
                <div class="admin-card-head">
                    <div>
                        <h2>Top Selling Variants</h2>
                        <p>Based on units sold (@_snapshot.RangeLabel)</p>
                    </div>
                    <button type="button" class="admin-view-all" @onclick='() => ViewAllProducts("units")'>
                        View All
                    </button>
                </div>
                @if (_snapshot.TopSellingVariants.Count == 0)
                {
                    <p class="admin-reports-section-empty">No variant sales in this period.</p>
                }
                else
                {
                    <ol class="admin-reports-rank-list variants">
                        @foreach (var row in _snapshot.TopSellingVariants)
                        {
                            <li>
                                <span class="admin-reports-rank-num">@row.Rank</span>
                                <img src="@row.ImageUrl"
                                     alt="@row.ProductName"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                <div class="admin-reports-rank-body">
                                    <strong title="@row.ProductName">@row.ProductName</strong>
                                    <small>@row.VariantLabel</small>
                                    <div class="admin-reports-rank-meta">
                                        <em>@row.UnitsSold.ToString("N0") sold</em>
                                        <span>₱@row.Revenue.ToString("N2")</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="admin-card admin-reports-top-card">
                <div class="admin-card-head">
                    <div>
                        <h2>Top Products by Revenue</h2>
                        <p>Total sales amount (@_snapshot.RangeLabel)</p>
                    </div>
                    <button type="button" class="admin-view-all" @onclick='() => ViewAllProducts("revenue")'>
                        View All
                    </button>
                </div>
                @if (_snapshot.TopProductsByRevenue.Count == 0)
                {
                    <p class="admin-reports-section-empty">No sales data in this period.</p>
                }
                else
                {
                    <ol class="admin-reports-rank-list revenue">
                        @foreach (var row in _snapshot.TopProductsByRevenue)
                        {
                            <li>
                                <span class="admin-reports-rank-num">@row.Rank</span>
                                <img src="@row.ImageUrl"
                                     alt="@row.Name"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                <div class="admin-reports-rank-body">
                                    <strong title="@row.Name">@row.Name</strong>
                                    <div class="admin-reports-revenue-value">₱@row.Revenue.ToString("N2")</div>
                                    <em>@row.UnitsSold.ToString("N0") sold</em>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>

        <section class="admin-card admin-reports-performance" @ref="_performanceSection">
            <div class="admin-card-head admin-reports-perf-head">
                <div>
                    <h2>Product Performance</h2>
                    <p>Detailed performance of all products (@_snapshot.RangeLabel)</p>
                </div>
                <div class="admin-reports-perf-tools">
                    <label class="admin-reports-search">
                        <Icon Name="search" Size="14" />
                        <input type="search"
                               placeholder="Search products..."
                               @bind="_perfSearch"
                               @bind:event="oninput" />
                    </label>
                    <button type="button" class="btn btn-outline-navy admin-reports-export" @onclick="ExportCsv">
                        <Icon Name="download" Size="15" />
                        Export
                    </button>
                </div>
            </div>

            <div class="admin-reports-table-wrap">
                <table class="admin-reports-table admin-reports-perf-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>
                                <button type="button" class="admin-reports-sort" @onclick='() => SetPerfSort("units")'>
                                    Units Sold
                                </button>
                            </th>
                            <th>
                                <button type="button" class="admin-reports-sort" @onclick='() => SetPerfSort("revenue")'>
                                    Revenue (₱)
                                </button>
                            </th>
                            <th>Avg. Price (₱)</th>
                            <th>
                                <button type="button" class="admin-reports-sort" @onclick='() => SetPerfSort("orders")'>
                                    Orders
                                </button>
                            </th>
                            <th>
                                <button type="button" class="admin-reports-sort" @onclick='() => SetPerfSort("stock")'>
                                    Current Stock
                                </button>
                            </th>
                            <th>Performance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in VisiblePerformance)
                        {
                            <tr>
                                <td>
                                    <span class="admin-reports-rank rank-@Math.Min(row.Rank, 4)">@row.Rank</span>
                                </td>
                                <td>
                                    <div class="admin-inventory-product">
                                        <img src="@row.ImageUrl"
                                             alt="@row.Name"
                                             loading="lazy"
                                             onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                        <strong title="@row.Name">@row.Name</strong>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(row.Category) ? "—" : row.Category)</td>
                                <td><strong>@row.UnitsSold.ToString("N0")</strong></td>
                                <td><strong>₱@row.Revenue.ToString("N2")</strong></td>
                                <td>@(row.UnitsSold <= 0 ? "—" : $"₱{row.AvgPrice:N2}")</td>
                                <td>@row.Orders.ToString("N0")</td>
                                <td>@row.CurrentStock.ToString("N0")</td>
                                <td>
                                    <span class="admin-reports-perf-badge @row.PerformanceKey">@row.Performance</span>
                                </td>
                            </tr>
                        }
                        @if (!VisiblePerformance.Any())
                        {
                            <tr>
                                <td colspan="9" class="admin-reports-table-empty">
                                    No products match your search.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@if (_showCustom)
{
    <div class="admin-modal-backdrop" @onclick="CloseCustom">
        <div class="admin-modal admin-promo-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>Custom Report Range</h2>
            <form class="admin-category-form" @onsubmit="ApplyCustom" @onsubmit:preventDefault="true">
                <label class="admin-field">
                    <span>Start Date</span>
                    <input type="date" @bind="_customStart" />
                </label>
                <label class="admin-field">
                    <span>End Date</span>
                    <input type="date" @bind="_customEnd" />
                </label>
                @if (!string.IsNullOrEmpty(_customError))
                {
                    <p class="admin-staff-error">@_customError</p>
                }
                <div class="admin-modal-actions">
                    <button type="button" class="btn btn-outline-navy" @onclick="CloseCustom">Cancel</button>
                    <button type="submit" class="btn btn-navy">Apply</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private string _range = "30days";
    private ReportSnapshot _snapshot = new();
    private bool _showCustom;
    private DateTime _customStart = new(2026, 8, 1);
    private DateTime _customEnd = new(2026, 8, 14);
    private string? _customError;

    private string _perfSearch = string.Empty;
    private string _perfSort = "units";
    private ElementReference _performanceSection;

    private IEnumerable<ReportProductPerformance> VisiblePerformance
    {
        get
        {
            IEnumerable<ReportProductPerformance> query = _snapshot.ProductPerformance;

            if (!string.IsNullOrWhiteSpace(_perfSearch))
            {
                var term = _perfSearch.Trim();
                query = query.Where(r =>
                    r.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || r.Category.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || r.Sku.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            query = _perfSort switch
            {
                "revenue" => query.OrderByDescending(r => r.Revenue).ThenByDescending(r => r.UnitsSold),
                "orders" => query.OrderByDescending(r => r.Orders).ThenByDescending(r => r.UnitsSold),
                "stock" => query.OrderByDescending(r => r.CurrentStock).ThenBy(r => r.Name),
                _ => query.OrderByDescending(r => r.UnitsSold).ThenByDescending(r => r.Revenue)
            };

            return query.Select((r, i) => new ReportProductPerformance
            {
                Rank = i + 1,
                ProductId = r.ProductId,
                Name = r.Name,
                Category = r.Category,
                Sku = r.Sku,
                ImageUrl = r.ImageUrl,
                UnitsSold = r.UnitsSold,
                Revenue = r.Revenue,
                AvgPrice = r.AvgPrice,
                Orders = r.Orders,
                CurrentStock = r.CurrentStock,
                Performance = r.Performance,
                PerformanceKey = r.PerformanceKey
            });
        }
    }

    private IEnumerable<(double X, double Y)> RevenuePoints =>
        BuildPoints(_snapshot.SalesTrend.Select(p => (double)p.Revenue).ToArray(), 140000);

    private IEnumerable<(double X, double Y)> OrdersPoints =>
        BuildPoints(_snapshot.SalesTrend.Select(p => (double)p.Orders).ToArray(), 260);

    private IEnumerable<(double X, double Y)> AovPoints =>
        BuildPoints(_snapshot.SalesTrend.Select(p => (double)p.AvgOrderValue).ToArray(), 600, height: 160, bottom: 170);

    private string RevenueLine => ToLine(RevenuePoints);
    private string OrdersLine => ToLine(OrdersPoints);
    private string AovLine => ToLine(AovPoints);
    private string AovArea => ToArea(AovPoints, bottom: 170);

    private string DonutGradient
    {
        get
        {
            var total = _snapshot.OrderDistribution.Sum(s => s.Count);
            if (total <= 0) return "#E2E8F0";
            var stops = new List<string>();
            double cursor = 0;
            foreach (var slice in _snapshot.OrderDistribution)
            {
                var pct = slice.Count * 100.0 / total;
                var next = cursor + pct;
                stops.Add($"{slice.Color} {cursor:0.##}% {next:0.##}%");
                cursor = next;
            }
            return $"conic-gradient({string.Join(", ", stops)})";
        }
    }

    protected override void OnInitialized()
    {
        ReportService.OnChange += Refresh;
        _range = ReportService.SelectedRange;
        Reload();
    }

    private void SelectRange(string key)
    {
        if (key == "custom")
        {
            _showCustom = true;
            _customError = null;
            return;
        }

        _range = key;
        ReportService.SetRange(key);
        Reload();
    }

    private void CloseCustom() => _showCustom = false;

    private void ApplyCustom()
    {
        var (success, message) = ReportService.ApplyCustomRange(_customStart, _customEnd);
        if (!success)
        {
            _customError = message;
            return;
        }

        _range = "custom";
        _showCustom = false;
        Toast.Show(message);
        Reload();
    }

    private void SetPerfSort(string sort)
    {
        _perfSort = sort;
    }

    private async Task ViewAllProducts(string sort)
    {
        _perfSort = sort;
        _perfSearch = string.Empty;
        await InvokeAsync(StateHasChanged);
        try
        {
            await JS.InvokeVoidAsync("nubeScrollIntoView", _performanceSection);
        }
        catch
        {
            // Ignore if helper is unavailable; sort still applied.
        }
    }

    private async Task ExportCsv()
    {
        var csv = ReportService.BuildCsv(_snapshot);
        var fileName = $"NU-Bulldogs-Report-{DateTime.Now:yyyy-MM-dd}.csv";
        try
        {
            await JS.InvokeVoidAsync("nubeDownloadTextFile", fileName, csv, "text/csv;charset=utf-8");
            Toast.Show("Report exported as CSV.");
        }
        catch
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", csv);
            Toast.Show("CSV copied to clipboard.");
        }
    }

    private void Reload()
    {
        _snapshot = ReportService.GetSnapshot();
        _range = ReportService.SelectedRange;
    }

    private void Refresh()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private static IEnumerable<(double X, double Y)> BuildPoints(
        double[] values,
        double max,
        double width = 480,
        double height = 180,
        double top = 10,
        double bottom = 190)
    {
        if (values.Length == 0) yield break;
        var usable = bottom - top;
        for (var i = 0; i < values.Length; i++)
        {
            var x = values.Length == 1 ? width / 2 : (i / (double)(values.Length - 1)) * width;
            var y = bottom - (Math.Clamp(values[i], 0, max) / max) * usable;
            yield return (x, y);
        }
    }

    private static string ToLine(IEnumerable<(double X, double Y)> points)
    {
        var list = points.ToList();
        if (list.Count == 0) return string.Empty;
        var parts = new List<string> { $"M {list[0].X:0.##} {list[0].Y:0.##}" };
        for (var i = 1; i < list.Count; i++)
            parts.Add($"L {list[i].X:0.##} {list[i].Y:0.##}");
        return string.Join(" ", parts);
    }

    private static string ToArea(IEnumerable<(double X, double Y)> points, double bottom)
    {
        var list = points.ToList();
        if (list.Count == 0) return string.Empty;
        var parts = new List<string> { $"M {list[0].X:0.##} {bottom:0.##}" };
        parts.Add($"L {list[0].X:0.##} {list[0].Y:0.##}");
        for (var i = 1; i < list.Count; i++)
            parts.Add($"L {list[i].X:0.##} {list[i].Y:0.##}");
        parts.Add($"L {list[^1].X:0.##} {bottom:0.##} Z");
        return string.Join(" ", parts);
    }

    public void Dispose() => ReportService.OnChange -= Refresh;
}
