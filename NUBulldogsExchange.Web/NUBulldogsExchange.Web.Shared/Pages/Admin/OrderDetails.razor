@page "/admin/orders/{Id}"
@layout AdminLayout
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AdminOrderService OrderService
@inject ToastService Toast
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(Order?.Id ?? "Order") | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-order-details">
    @if (Order is null)
    {
        <div class="admin-card admin-placeholder-card">
            <h2>Order not found</h2>
            <p>This order may have been removed from the mock catalog.</p>
            <a href="/admin/orders" class="btn btn-navy">Back to Orders</a>
        </div>
    }
    else
    {
        <header class="admin-products-header">
            <div>
                <h1>@Order.Id</h1>
                <p>Order details</p>
            </div>
            <a href="/admin/orders" class="btn btn-outline-navy">Back to Orders</a>
        </header>

        <div class="admin-order-details-grid">
            <section class="admin-card admin-order-summary">
                <h2>Summary</h2>
                <dl>
                    <div><dt>Customer</dt><dd><strong>@Order.CustomerName</strong><span>@Order.CustomerEmail</span></dd></div>
                    <div><dt>Date</dt><dd>@Order.DateLabel</dd></div>
                    <div><dt>Total</dt><dd><strong>₱@Order.Total.ToString("N0")</strong></dd></div>
                    <div><dt>Payment</dt><dd><span class="admin-payment-badge payment-@Order.PaymentKey">@Order.PaymentStatus</span></dd></div>
                    <div><dt>Fulfillment</dt><dd>@Order.Fulfillment</dd></div>
                    <div><dt>Status</dt><dd><span class="order-status status-@Order.StatusKey">@Order.Status</span></dd></div>
                </dl>

                <label class="admin-field">
                    <span>Update status (frontend demo)</span>
                    <select value="@Order.Status" @onchange="OnStatusChange">
                        <option>Pending</option>
                        <option>Confirmed</option>
                        <option>Processing</option>
                        <option>Ready for Pickup</option>
                        <option>Completed</option>
                        <option>Cancelled</option>
                    </select>
                </label>
            </section>

            <section class="admin-card admin-order-items">
                <h2>Products</h2>
                <div class="admin-order-item-list">
                    @foreach (var item in Order.Items)
                    {
                        <article class="admin-order-item-row">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                            <div>
                                <strong>@item.Name</strong>
                                <span>Qty @item.Quantity · ₱@item.Price.ToString("N0")</span>
                            </div>
                            <strong>₱@((item.Price * item.Quantity).ToString("N0"))</strong>
                        </article>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private AdminOrder? Order => OrderService.GetById(Id);

    protected override void OnInitialized() => OrderService.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task OnStatusChange(ChangeEventArgs e)
    {
        var status = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(status) || Order is null)
            return;

        if (await OrderService.UpdateStatusAsync(Order.Id, status))
            Toast.Show($"Order status updated to {status}.");
    }

    public void Dispose() => OrderService.OnChange -= Refresh;
}
