@page "/admin/inventory"
@layout AdminLayout
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AdminInventoryService InventoryService
@inject AuthService Auth
@inject ToastService Toast
@implements IDisposable

<PageTitle>Inventory | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-inventory">
    <header class="admin-products-header">
        <div>
            <h1>Inventory</h1>
            <p>Monitor and manage stock levels</p>
        </div>
        <a href="/admin/inventory/history" class="btn btn-outline-navy admin-inventory-history-btn">
            <Icon Name="clock" Size="15" />
            View History
        </a>
    </header>

    <div class="admin-inventory-stats">
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-blue"><Icon Name="boxes" Size="18" /></div>
            <div>
                <strong>@InventoryService.TotalInventory.ToString("N0")</strong>
                <span>Total Inventory</span>
            </div>
        </article>
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-green"><Icon Name="check-circle" Size="18" /></div>
            <div>
                <strong>@InventoryService.InStockCount</strong>
                <span>In Stock</span>
            </div>
        </article>
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-gold"><Icon Name="alert-triangle" Size="18" /></div>
            <div>
                <strong>@InventoryService.LowStockCount</strong>
                <span>Low Stock</span>
            </div>
        </article>
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-red"><Icon Name="x-circle" Size="18" /></div>
            <div>
                <strong>@InventoryService.OutOfStockCount</strong>
                <span>Out of Stock</span>
            </div>
        </article>
    </div>

    <section class="admin-inventory-table-card">
        <div class="admin-inventory-table-wrap">
            <table class="admin-inventory-table">
                <thead>
                    <tr>
                        <th class="col-product">Product</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th>Total Stock</th>
                        <th>Stock Alerts</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in InventoryService.Rows)
                    {
                        var expanded = _expandedProductId == row.ProductId;
                        <tr class="@(expanded ? "is-expanded" : "")">
                            <td>
                                <div class="admin-inventory-product">
                                    @if (row.HasVariants)
                                    {
                                        <button type="button"
                                                class="admin-inventory-expand"
                                                aria-expanded="@expanded"
                                                aria-label="@(expanded ? "Collapse variants" : "Expand variants")"
                                                @onclick="() => ToggleExpand(row.ProductId)">
                                            @(expanded ? "▾" : "▸")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="admin-inventory-expand-spacer" aria-hidden="true"></span>
                                    }
                                    <img src="@row.ImageUrl"
                                         alt="@row.Name"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                    <div>
                                        <strong title="@row.Name">@row.Name</strong>
                                    </div>
                                </div>
                            </td>
                            <td><code>@row.Sku</code></td>
                            <td>@row.Category</td>
                            <td>
                                <strong class="@(row.IsLowOrOut ? "is-warning" : "")">@row.TotalStock</strong>
                            </td>
                            <td>
                                @if (!row.HasStockAlerts)
                                {
                                    <span class="admin-inventory-alert-none">None</span>
                                }
                                else
                                {
                                    <div class="admin-inventory-alerts">
                                        @foreach (var alert in row.StockAlertLines)
                                        {
                                            <span class="@(alert.Contains("Out", StringComparison.OrdinalIgnoreCase) ? "is-out" : "is-low")">@alert</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="admin-stock-badge stock-@row.StockStateKey">@row.StockState</span>
                            </td>
                            <td>
                                <div class="admin-inventory-actions">
                                    <button type="button" class="btn btn-navy admin-adjust-btn" @onclick="() => OpenAdjust(row)">
                                        <Icon Name="plus" Size="13" />
                                        Adjust
                                    </button>
                                    <button type="button"
                                            class="admin-history-icon-btn"
                                            title="View product history"
                                            aria-label="@($"History for {row.Name}")"
                                            @onclick="() => OpenProductHistory(row)">
                                        <Icon Name="clock" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @if (row.HasVariants && expanded)
                        {
                            <tr class="admin-inventory-variant-row">
                                <td colspan="7">
                                    <div class="admin-inventory-variant-panel">
                                        <div class="admin-inventory-variant-title">Variant Stock (@row.VariantMode)</div>

                                        @if (row.HasColors && row.HasSizes)
                                        {
                                            @foreach (var colorGroup in row.Variants.GroupBy(v => v.ColorName?.Trim() ?? "—", StringComparer.OrdinalIgnoreCase))
                                            {
                                                var subtotal = colorGroup.Sum(v => Math.Max(0, v.StockQuantity));
                                                var hex = ProductVariantLogic.ColorHex(row.Variants, colorGroup.Key);
                                                <div class="admin-inventory-color-group">
                                                    <div class="admin-inventory-color-heading">
                                                        <span class="admin-inventory-swatch" style="background:@hex"></span>
                                                        COLOR: @colorGroup.Key.ToUpperInvariant()
                                                    </div>
                                                    <table class="admin-inventory-variant-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Size</th>
                                                                <th>Stock</th>
                                                                <th>Low Stock Level</th>
                                                                <th>Status</th>
                                                                <th>Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var variant in colorGroup)
                                                            {
                                                                <tr>
                                                                    <td>@(string.IsNullOrWhiteSpace(variant.Size) ? "—" : variant.Size)</td>
                                                                    <td><strong>@variant.StockQuantity</strong></td>
                                                                    <td>@row.LowStockLevel</td>
                                                                    <td>
                                                                        <span class="admin-stock-badge stock-@InventoryRow.VariantStatusKey(variant.StockQuantity, row.LowStockLevel)">
                                                                            @InventoryRow.VariantStatus(variant.StockQuantity, row.LowStockLevel)
                                                                        </span>
                                                                    </td>
                                                                    <td>
                                                                        <button type="button"
                                                                                class="btn btn-outline-navy admin-variant-adjust-btn"
                                                                                @onclick="() => OpenAdjust(row, variant.Id)">
                                                                            Adjust
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                    <div class="admin-inventory-subtotal">Subtotal: @subtotal</div>
                                                </div>
                                            }
                                            <div class="admin-inventory-variant-total">TOTAL PRODUCT STOCK: @row.TotalStock</div>
                                        }
                                        else if (row.HasColors)
                                        {
                                            <table class="admin-inventory-variant-table">
                                                <thead>
                                                    <tr>
                                                        <th>Color</th>
                                                        <th>Stock</th>
                                                        <th>Low Stock Level</th>
                                                        <th>Status</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var variant in row.Variants)
                                                    {
                                                        var hex = ProductVariantLogic.NormalizeHex(variant.ColorHex)
                                                                  ?? ProductVariantLogic.DefaultHex(variant.ColorName);
                                                        <tr>
                                                            <td>
                                                                <span class="admin-inventory-color-cell">
                                                                    <span class="admin-inventory-swatch" style="background:@hex"></span>
                                                                    @(variant.ColorName ?? "—")
                                                                </span>
                                                            </td>
                                                            <td><strong>@variant.StockQuantity</strong></td>
                                                            <td>@row.LowStockLevel</td>
                                                            <td>
                                                                <span class="admin-stock-badge stock-@InventoryRow.VariantStatusKey(variant.StockQuantity, row.LowStockLevel)">
                                                                    @InventoryRow.VariantStatus(variant.StockQuantity, row.LowStockLevel)
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <button type="button"
                                                                        class="btn btn-outline-navy admin-variant-adjust-btn"
                                                                        @onclick="() => OpenAdjust(row, variant.Id)">
                                                                    Adjust
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <div class="admin-inventory-variant-total">Total @row.TotalStock</div>
                                        }
                                        else
                                        {
                                            <table class="admin-inventory-variant-table">
                                                <thead>
                                                    <tr>
                                                        <th>Size</th>
                                                        <th>Stock</th>
                                                        <th>Low Stock Level</th>
                                                        <th>Status</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var variant in row.Variants)
                                                    {
                                                        <tr>
                                                            <td>@(string.IsNullOrWhiteSpace(variant.Size) ? "—" : variant.Size)</td>
                                                            <td><strong>@variant.StockQuantity</strong></td>
                                                            <td>@row.LowStockLevel</td>
                                                            <td>
                                                                <span class="admin-stock-badge stock-@InventoryRow.VariantStatusKey(variant.StockQuantity, row.LowStockLevel)">
                                                                    @InventoryRow.VariantStatus(variant.StockQuantity, row.LowStockLevel)
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <button type="button"
                                                                        class="btn btn-outline-navy admin-variant-adjust-btn"
                                                                        @onclick="() => OpenAdjust(row, variant.Id)">
                                                                    Adjust
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <div class="admin-inventory-variant-total">Total @row.TotalStock</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (_adjustRow is not null)
{
    var currentStock = CurrentAdjustStock;
    <div class="admin-modal-backdrop" @onclick="CloseAdjust">
        <div class="admin-modal admin-inventory-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>Adjust Stock — @_adjustRow.Name</h2>

            <form class="admin-category-form" @onsubmit="SaveAdjust" @onsubmit:preventDefault="true">
                @if (_adjustRow.HasVariants)
                {
                    <label class="admin-field">
                        <span>Variant</span>
                        <select @bind="_selectedVariantId" @bind:after="OnVariantChanged">
                            <option value="0">Select variant…</option>
                            @foreach (var variant in _adjustRow.Variants)
                            {
                                <option value="@variant.Id">@InventoryRow.FormatVariantLabel(variant)</option>
                            }
                        </select>
                    </label>
                }

                <p class="admin-modal-note">Current Stock: <strong>@currentStock</strong></p>

                <label class="admin-field">
                    <span>Adjustment Type</span>
                    <select @bind="_adjustType">
                        @foreach (var type in AdminInventoryService.AdjustmentTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </label>

                <label class="admin-field">
                    <span>Quantity</span>
                    <input type="number" min="0" @bind="_quantity" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_quantityError))
                    {
                        <em>@_quantityError</em>
                    }
                </label>

                <label class="admin-field">
                    <span>Reason</span>
                    <select @bind="_reason">
                        @foreach (var reason in AdminInventoryService.AdjustmentReasons)
                        {
                            <option value="@reason">@reason</option>
                        }
                    </select>
                </label>

                <label class="admin-field">
                    <span>Notes</span>
                    <textarea rows="3" @bind="_notes" @bind:event="oninput" placeholder="Optional notes..."></textarea>
                </label>

                <div class="admin-modal-actions">
                    <button type="button" class="btn btn-outline-navy" @onclick="CloseAdjust">Cancel</button>
                    <button type="submit" class="btn btn-navy">Save Adjustment</button>
                </div>
            </form>
        </div>
    </div>
}

@if (_historyRow is not null)
{
    <div class="admin-modal-backdrop" @onclick="CloseProductHistory">
        <div class="admin-modal admin-inventory-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>Inventory History – @_historyRow.Name</h2>
            @{
                var entries = InventoryService.HistoryForProduct(_historyRow.ProductId).ToList();
            }
            @if (!entries.Any())
            {
                <p class="admin-modal-note">No history yet for this product.</p>
            }
            else
            {
                <div class="admin-inventory-history-list">
                    @foreach (var entry in entries)
                    {
                        <article class="admin-inventory-history-item">
                            <strong>@entry.DateTimeLabel</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.VariantLabel))
                            {
                                <span>Variant: @entry.VariantLabel</span>
                            }
                            <span>@entry.PreviousStock → @entry.NewStock (@entry.ChangeLabel)</span>
                            <span>@entry.Reason · @entry.Type</span>
                            @if (!string.IsNullOrWhiteSpace(entry.Reference))
                            {
                                <span>Ref: @entry.Reference</span>
                            }
                            <span class="muted">@entry.AdminName</span>
                        </article>
                    }
                </div>
            }
            <div class="admin-modal-actions">
                <button type="button" class="btn btn-navy" @onclick="CloseProductHistory">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private InventoryRow? _adjustRow;
    private InventoryRow? _historyRow;
    private int? _expandedProductId;
    private int _selectedVariantId;
    private string _adjustType = "Add Stock";
    private int _quantity;
    private string _reason = "Restock";
    private string _notes = string.Empty;
    private string? _quantityError;

    private int CurrentAdjustStock
    {
        get
        {
            if (_adjustRow is null) return 0;
            if (!_adjustRow.HasVariants) return _adjustRow.TotalStock;
            var variant = _adjustRow.Variants.FirstOrDefault(v => v.Id == _selectedVariantId);
            return variant?.StockQuantity ?? 0;
        }
    }

    protected override void OnInitialized()
    {
        InventoryService.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void ToggleExpand(int productId) =>
        _expandedProductId = _expandedProductId == productId ? null : productId;

    private void OpenAdjust(InventoryRow row, int? variantId = null)
    {
        _adjustRow = row;
        _selectedVariantId = variantId ?? (row.HasVariants && row.Variants.Count == 1 ? row.Variants[0].Id : 0);
        _adjustType = "Add Stock";
        _quantity = 0;
        _reason = "Restock";
        _notes = string.Empty;
        _quantityError = null;
    }

    private void OnVariantChanged() => _quantityError = null;

    private void CloseAdjust()
    {
        _adjustRow = null;
        _selectedVariantId = 0;
        _quantityError = null;
    }

    private async Task SaveAdjust()
    {
        if (_adjustRow is null) return;
        _quantityError = null;

        int? variantId = _adjustRow.HasVariants ? _selectedVariantId : null;
        if (_adjustRow.HasVariants && (_selectedVariantId <= 0))
        {
            _quantityError = "Select a variant to adjust.";
            return;
        }

        var (success, message) = await InventoryService.AdjustAsync(
            _adjustRow.ProductId,
            _adjustType,
            _quantity,
            _reason,
            _notes,
            Auth.DisplayName,
            variantId);

        if (!success)
        {
            _quantityError = message;
            return;
        }

        Toast.Show(message);
        // Keep expanded product if still viewing variants.
        var keepExpanded = _expandedProductId;
        CloseAdjust();
        _expandedProductId = keepExpanded;
    }

    private void OpenProductHistory(InventoryRow row) => _historyRow = row;
    private void CloseProductHistory() => _historyRow = null;

    public void Dispose() => InventoryService.OnChange -= Refresh;
}
