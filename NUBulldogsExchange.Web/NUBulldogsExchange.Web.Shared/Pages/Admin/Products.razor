    private void ResetForm()
    {
        _editProductId = null;
        _originalCategory = string.Empty;
        _formSold = 0;
        _formName = string.Empty;
        _formDescription = string.Empty;
        _formCategory = string.Empty;
        _formStatus = "Active";
        _formPriceText = string.Empty;
        _formSku = string.Empty;
        _formStockText = string.Empty;
        _formColors = string.Empty;
        _hasVariants = false;
        _useDifferentPrices = false;
        _formVariants = [];
        _previewImages.Clear();
        _formErrors.Clear();
        _formDirty = false;
        _isDragOver = false;
    }

    private void MarkDirty() => _formDirty = true;

    private void OnNameInput(ChangeEventArgs e)
    {
        _formName = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
        _formErrors.Remove("name");
    }

    private void OnDescriptionInput(ChangeEventArgs e)
    {
        _formDescription = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
    }

    private void OnCategorySelect(ChangeEventArgs e)
    {
        _formCategory = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
        _formErrors.Remove("category");
        _formErrors.Remove("sku");

        // Add mode: always regenerate product SKU from category.
        // Edit mode: keep existing SKU (read-only).
        if (!_isEditMode && !string.IsNullOrWhiteSpace(_formCategory))
            _formSku = ProductService.SuggestSku(_formCategory);
    }

    private void OnStatusSelect(ChangeEventArgs e)
    {
        _formStatus = e.Value?.ToString() ?? "Active";
        MarkDirty();
        _formErrors.Remove("status");
    }

    private void OnPriceInput(ChangeEventArgs e)
    {
        _formPriceText = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
        _formErrors.Remove("price");
        if (_hasVariants && !_useDifferentPrices)
            ProductVariantLogic.ApplySamePriceMode(_formVariants);
    }

    private Task OnPriceInputFromVariants(string value)
    {
        _formPriceText = value ?? string.Empty;
        MarkDirty();
        _formErrors.Remove("price");
        if (_hasVariants && !_useDifferentPrices)
            ProductVariantLogic.ApplySamePriceMode(_formVariants);
        return Task.CompletedTask;
    }

    private Task OnPricingModeChanged(bool different)
    {
        _useDifferentPrices = different;
        MarkDirty();
        if (!different)
            ProductVariantLogic.ApplySamePriceMode(_formVariants);
        return Task.CompletedTask;
    }

    private void OnColorsInput(ChangeEventArgs e)
    {
        _formColors = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
    }

    private void OnStockInput(ChangeEventArgs e)
    {
        _formStockText = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
        _formErrors.Remove("stock");
    }

    private Task OnStockTextChanged(string value)
    {
        _formStockText = value;
        MarkDirty();
        _formErrors.Remove("stock");
        return Task.CompletedTask;
    }

    private Task OnHasVariantsChanged(bool value)
    {
        _hasVariants = value;
        MarkDirty();
        _formErrors.Remove("stock");
        _formErrors.Remove("variants");
        return Task.CompletedTask;
    }

    private Task OnVariantsChanged(List<ProductVariant> variants)
    {
