    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) || !IsAll(_category) || !IsAll(_status);

    private List<AdminProduct> Filtered => Sort(ProductService.Filter(_search, _category, _status)).ToList();

    private IEnumerable<AdminProduct> Sort(IEnumerable<AdminProduct> query) => _sort switch
    {
        "oldest" => query.OrderBy(p => p.CreatedAt).ThenBy(p => p.Id),
        "name-asc" => query.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
        "name-desc" => query.OrderByDescending(p => p.Name, StringComparer.OrdinalIgnoreCase),
        "price-asc" => query.OrderBy(p => DescribePrice(p).Min ?? decimal.MaxValue).ThenBy(p => p.Name),
        "price-desc" => query.OrderByDescending(p => DescribePrice(p).Max ?? -1).ThenBy(p => p.Name),
        "best-selling" => query.OrderByDescending(SoldFor).ThenBy(p => p.Name),
        "low-stock" => query
            .Select(p => (Product: p, Stock: StockFor(p)))
            .OrderBy(x => x.Stock.Key switch { "low" => 0, "out" => 1, _ => 2 })
            .ThenBy(x => x.Stock.Total)
            .ThenBy(x => x.Product.Name)
            .Select(x => x.Product),
        _ => query.OrderByDescending(p => p.CreatedAt).ThenByDescending(p => p.Id)
    };

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));

    private int CurrentPage => Math.Clamp(_currentPage, 1, TotalPages);

    private List<AdminProduct> Paged =>
        Filtered
            .Skip((CurrentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();

    private string ResultLabel
    {
        get
        {
            var total = Filtered.Count;
            if (total == 0)
                return "Showing 0 products";
            var start = (CurrentPage - 1) * _pageSize + 1;
            var end = Math.Min(start + _pageSize - 1, total);
            return $"Showing {start}–{end} of {total} product{(total == 1 ? "" : "s")}";
        }
    }

    private string RangeLabel
    {
        get
        {
            var total = Filtered.Count;
            if (total == 0) return "0 to 0 of 0";
            var start = (CurrentPage - 1) * _pageSize + 1;
            var end = Math.Min(CurrentPage * _pageSize, total);
            return $"{start} to {end} of {total}";
        }
    }

    private sealed record StockDisplay(int Total, int VariantCount, string Key, string Label, string? Detail);

    /// <summary>Reuses the Inventory module's row (same totals, per-product low-stock level and states).</summary>
    private StockDisplay StockFor(AdminProduct product)
    {
        var row = InventoryService.GetRow(product.Id);
        if (row is null)
            return new StockDisplay(Math.Max(0, product.Stock), 0, product.StockStateKey, product.StockState, null);

        // Inventory's Attention/Critical health maps onto the product table's Low/Out badges.
        var key = row.StockStateKey switch
        {
            "attention" => "low",
            "critical" => "out",
            "healthy" => "in",
            _ => row.StockStateKey
        };
        var label = key switch { "out" => "Out of Stock", "low" => "Low Stock", _ => "In Stock" };
        var alerts = string.Join(", ", row.StockAlertLines);
        var detail = $"Low-stock level: {row.LowStockLevel}" + (alerts.Length > 0 ? $" · {alerts}" : "");
        return new StockDisplay(row.TotalStock, row.Variants.Count, key, label, detail);
    }

    private Dictionary<int, int>? _soldCache;

    /// <summary>Fulfilled units (Completed pickup / Delivered delivery), all variants summed per product.</summary>
    private int SoldFor(AdminProduct product)
    {
        _soldCache ??= OrderService.All
            .Where(AdminReportService.IsFulfilledSale)
            .SelectMany(o => o.Items)
            .Where(i => i.ProductId > 0 && i.Quantity > 0)
            .GroupBy(i => i.ProductId)
            .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));

        return _soldCache.GetValueOrDefault(product.Id);
    }

    private void OnOrdersChanged()
    {
        _soldCache = null;
        Refresh();
    }

    private bool HasOrderHistory(int productId) =>
        OrderService.All.Any(o => o.Items.Any(i => i.ProductId == productId));

    /// <summary>Visible reviews only, rounded like AdminReviewService's product stats.</summary>
    private (double Average, int Count) ReviewStatsFor(AdminProduct product)
    {
        if (ReviewService.All.Count == 0)
            return (product.Rating, product.Reviews);

        var visible = ReviewService.ForProduct(product.Id).Where(r => r.IsVisible).ToList();
        return visible.Count == 0
            ? (0, 0)
            : (Math.Round(visible.Average(r => r.Rating), 1, MidpointRounding.AwayFromZero), visible.Count);
    }

    private List<AdminProduct> DeleteTargets =>
