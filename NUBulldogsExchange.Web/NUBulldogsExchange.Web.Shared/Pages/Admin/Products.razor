    /// <summary>
    /// Products referenced by past orders are set to Inactive instead of hard-deleted,
    /// so order history is never removed. Only products with no orders are deleted.
    /// </summary>
    private async Task ConfirmDeleteAction()
    {
        if (_busy) return;
        var targets = DeleteTargets;
        if (targets.Count == 0)
        {
            CancelDelete();
            return;
        }

        _busy = true;
        try
        {
            var keep = targets.Where(p => HasOrderHistory(p.Id)).ToList();
            var remove = targets.Where(p => !HasOrderHistory(p.Id)).ToList();

            if (keep.Count > 0)
                await ProductService.SetStatusManyAsync(keep.Select(p => p.Id), "Inactive");

            var deletedIds = remove.Count > 0
                ? await ProductService.DeleteManyAsync(remove.Select(p => p.Id))
                : [];
            foreach (var group in remove.Where(p => deletedIds.Contains(p.Id)).GroupBy(p => p.Category))
                await CategoryService.AdjustProductCountAsync(group.Key, -group.Count());

            foreach (var product in targets)
                _selectedIds.Remove(product.Id);

            var failed = remove.Count - deletedIds.Count;
            var parts = new List<string>();
            if (deletedIds.Count > 0)
                parts.Add($"{deletedIds.Count} deleted");
            if (keep.Count > 0)
                parts.Add($"{keep.Count} set to Inactive (has order history)");
            if (failed > 0)
                parts.Add($"{failed} could not be deleted");
            Toast.Show(string.Join(" · ", parts) + ".");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Toast.Show("Unable to delete products. Please try again.");
        }
        finally
        {
            _busy = false;
            CancelDelete();
        }
    }

    private async Task RequestBulkStatus(string status)
    {
        if (_busy || _selectedIds.Count == 0) return;
        _busy = true;
        try
        {
            var count = _selectedIds.Count;
            await ProductService.SetStatusManyAsync(_selectedIds, status);
            Toast.Show($"{count} product{(count == 1 ? "" : "s")} set to {status}.");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Toast.Show("Unable to update product status.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportCsv()
    {
        var rows = _selectedIds.Count > 0
            ? Filtered.Where(p => _selectedIds.Contains(p.Id)).ToList()
            : Filtered;
        if (rows.Count == 0)
            return;

        var lines = new List<string> { "SKU,Product Name,Category,Price,Price Type,Total Stock,Variants,Stock Status,Sold,Rating,Reviews,Status" };
        foreach (var product in rows)
        {
            var price = DescribePrice(product);
            var stock = StockFor(product);
            var reviews = ReviewStatsFor(product);
            var priceText = price.Min is decimal min && price.Max is decimal max
                ? min == max ? min.ToString("0.00") : $"{min:0.00} - {max:0.00}"
                : "";
            var priceType = price.Mode switch
            {
                ProductVariantLogic.AdminPriceMode.Variable => "Variable Price",
                ProductVariantLogic.AdminPriceMode.Unresolved => "Unresolved",
                _ => "Same Price"
            };
            lines.Add(string.Join(",",
                Csv(product.Sku), Csv(product.Name), Csv(product.Category), Csv(priceText), priceType,
                stock.Total, stock.VariantCount, stock.Label, SoldFor(product),
                reviews.Count > 0 ? reviews.Average.ToString("0.0") : "", reviews.Count, Csv(product.Status)));
        }

        var csv = string.Join("\n", lines);
        var fileName = $"NU-Bulldogs-Products-{DateTime.Now:yyyy-MM-dd}.csv";
        try
        {
            await JS.InvokeVoidAsync("nubeDownloadTextFile", fileName, csv, "text/csv;charset=utf-8");
            Toast.Show($"Exported {rows.Count} product{(rows.Count == 1 ? "" : "s")} as CSV.");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Toast.Show("Unable to export products.");
        }
    }

    private static string Csv(string? value)
    {
        var text = value ?? string.Empty;
        // Spreadsheet apps execute cells starting with these characters as formulas.
        if (text.Length > 0 && "=+-@".Contains(text[0]))
            text = "'" + text;
        return text.IndexOfAny([',', '"', '\n', '\r']) >= 0
            ? $"\"{text.Replace("\"", "\"\"")}\""
            : text;
    }

    private async Task OpenAddModal()
    {
        CloseMenu();
        ResetForm();
        _productModalOpen = true;
        _discardConfirm = false;
        await SetBodyScrollLock(true);
