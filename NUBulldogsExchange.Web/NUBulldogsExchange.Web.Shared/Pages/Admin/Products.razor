    private void OnDragEnter(DragEventArgs _) => _isDragOver = true;
    private void OnDragOver(DragEventArgs _) => _isDragOver = true;
    private void OnDragLeave(DragEventArgs _) => _isDragOver = false;

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        _isDragOver = false;
        _formErrors.Remove("images");
        MarkDirty();

        foreach (var file in e.GetMultipleFiles(12))
        {
            var dataUrl = await ReadImageDataUrlAsync(file);
            if (dataUrl is null) continue;
            _previewImages.Add(new ImagePreview(dataUrl));
        }
    }

    private async Task OnReplaceImageSelected(InputFileChangeEventArgs e)
    {
        _isDragOver = false;
        _formErrors.Remove("images");
        MarkDirty();

        var file = e.File;
        if (file is null) return;

        var dataUrl = await ReadImageDataUrlAsync(file);
        if (dataUrl is null) return;

        _previewImages.Clear();
        _previewImages.Add(new ImagePreview(dataUrl));
    }

    private async Task<string?> ReadImageDataUrlAsync(IBrowserFile file)
    {
        var contentType = file.ContentType?.ToLowerInvariant() ?? string.Empty;
        var name = file.Name?.ToLowerInvariant() ?? string.Empty;
        var isPng = contentType is "image/png" || name.EndsWith(".png");
        var isJpg = contentType is "image/jpeg" or "image/jpg" ||
                    name.EndsWith(".jpg") || name.EndsWith(".jpeg");

        if (!isPng && !isJpg)
        {
            _formErrors["images"] = "Image must be PNG or JPG.";
            return null;
        }

        if (file.Size > MaxImageBytes)
        {
            _formErrors["images"] = "Image must not exceed 10MB.";
            return null;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            if (bytes.Length == 0) return null;

            var mime = isPng ? "image/png" : "image/jpeg";
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            _formErrors["images"] = "Image must not exceed 10MB.";
            return null;
        }
    }

    private void RemoveImage(int index)
    {
        if (index < 0 || index >= _previewImages.Count) return;
        _previewImages.RemoveAt(index);
        MarkDirty();
        if (_previewImages.Count > 0)
            _formErrors.Remove("images");
    }

    private bool ValidateForm(bool requireImages)
    {
        _formErrors.Clear();

        if (string.IsNullOrWhiteSpace(_formName))
            _formErrors["name"] = "Product name is required.";

        if (string.IsNullOrWhiteSpace(_formCategory))
            _formErrors["category"] = "Please select a category.";
        else if (!IsKnownCategory(_formCategory))
            _formErrors["category"] = "Please select a valid category.";

        if (string.IsNullOrWhiteSpace(_formStatus))
            _formErrors["status"] = "Status is required.";

        if (_hasVariants && _useDifferentPrices)
        {
            // PriceAdjustment holds absolute amount while editing (no starting price).
            if (_formVariants.Any(v => v.PriceAdjustment <= 0))
                _formErrors["variants"] = "Each variant price must be greater than 0.";
            else
            {
                var variantError = ProductSizeVariantEditor.Validate(_formVariants);
                if (variantError is not null)
                    _formErrors["variants"] = variantError;
            }
        }
        else
        {
            if (!decimal.TryParse(_formPriceText, out var price) || price < 0)
                _formErrors["price"] = "Price must be greater than 0.";
            else if (price <= 0)
                _formErrors["price"] = "Price must be greater than 0.";

            if (_hasVariants)
            {
                var variantError = ProductSizeVariantEditor.Validate(_formVariants);
                if (variantError is not null)
                    _formErrors["variants"] = variantError;
            }
            else if (!int.TryParse(_formStockText, out var stock))
                _formErrors["stock"] = "Stock quantity is required.";
            else if (stock < 0)
                _formErrors["stock"] = "Stock quantity cannot be negative.";
        }

        if (string.IsNullOrWhiteSpace(_formSku))
            _formErrors["sku"] = "SKU is required.";
        else if (ProductService.SkuExists(_formSku, _editProductId))
            _formErrors["sku"] = "This SKU already exists.";

        return _formErrors.Count == 0;
    }

    private bool IsKnownCategory(string category) =>
        FormCategoryNames.Any(c => c.Equals(category, StringComparison.OrdinalIgnoreCase))
        || CategoryService.All.Any(c => c.Name.Equals(category, StringComparison.OrdinalIgnoreCase))
        || AdminProductService.Categories.Any(c => c.Equals(category, StringComparison.OrdinalIgnoreCase));

    private void EnsureSku()
    {
        if (string.IsNullOrWhiteSpace(_formSku) && !string.IsNullOrWhiteSpace(_formCategory))
            _formSku = ProductService.SuggestSku(_formCategory);
    }

    private async Task SaveProduct()
    {
        EnsureSku();
        if (!ValidateForm(requireImages: false))
        {
            Toast.Show(_formErrors.Values.FirstOrDefault() ?? "Please complete the required fields.");
            return;
        }

        try
        {
            await PersistProductAsync(_formStatus);
            Toast.Show("Product added successfully.");
            await CloseProductModalAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(string.IsNullOrWhiteSpace(ex.Message)
                ? "Product could not be saved."
                : ex.Message);
        }
    }

    private async Task SaveEditedProduct()
    {
        if (!_isEditMode)
            return;

        // Edit keeps existing image if present; only require an image when none is set.
        if (!ValidateForm(requireImages: _previewImages.Count == 0))
            return;

        try
        {
            var ok = await PersistProductAsync(_formStatus);
            if (!ok)
            {
                Toast.Show("Product could not be updated.");
                return;
            }

            Toast.Show("Product updated successfully.");
            await CloseProductModalAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(string.IsNullOrWhiteSpace(ex.Message)
                ? "Product could not be updated."
                : ex.Message);
        }
    }

    private async Task SaveDraft()
    {
        // Draft allows incomplete fields except a usable name when possible;
        // still validate core fields so the catalog stays coherent.
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formErrors.Clear();
            _formErrors["name"] = "Product name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formCategory))
        {
            _formErrors.Clear();
            _formErrors["category"] = "Please select a category.";
            return;
        }

        if (!IsKnownCategory(_formCategory))
        {
            _formErrors.Clear();
            _formErrors["category"] = "Please select a valid category.";
            return;
        }

        EnsureSku();

        if (!string.IsNullOrWhiteSpace(_formSku) && ProductService.SkuExists(_formSku, _editProductId))
        {
            _formErrors.Clear();
            _formErrors["sku"] = "This SKU already exists.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formPriceText))
            _formPriceText = "0";
        if (string.IsNullOrWhiteSpace(_formStockText))
            _formStockText = "0";

        if (!_hasVariants)
        {
            if (!decimal.TryParse(_formPriceText, out var price) || price < 0)
            {
                _formErrors.Clear();
                _formErrors["price"] = "Price cannot be negative.";
                return;
            }

            if (!int.TryParse(_formStockText, out var stock) || stock < 0)
            {
                _formErrors.Clear();
                _formErrors["stock"] = "Stock quantity cannot be negative.";
                return;
            }
        }
        else
        {
            var variantError = ProductSizeVariantEditor.Validate(_formVariants);
            if (variantError is not null)
            {
                _formErrors.Clear();
                _formErrors["variants"] = variantError;
                return;
            }
        }

        try
        {
            await PersistProductAsync("Draft");
            Toast.Show("Product saved as draft.");
            await CloseProductModalAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(string.IsNullOrWhiteSpace(ex.Message)
                ? "Draft could not be saved."
                : ex.Message);
        }
    }

    private async Task<bool> PersistProductAsync(string status)
    {
        decimal.TryParse(_formPriceText, out var price);
        int.TryParse(_formStockText, out var stock);
        price = Math.Max(0, price);
        stock = Math.Max(0, stock);

        var hasVariants = _hasVariants;
        var variants = hasVariants
            ? _formVariants.Select(v => v.Clone()).ToList()
            : [];

        if (hasVariants)
        {
            stock = variants.Sum(v => Math.Max(0, v.StockQuantity));
            if (_useDifferentPrices)
            {
                // While editing, PriceAdjustment holds absolute variant prices.
                // Persist as products.price = min absolute, with deltas on each variant.
                var absolutePrices = variants
                    .Select(v => v.PriceAdjustment)
                    .Where(p => p > 0)
                    .ToList();
                price = absolutePrices.Count > 0 ? absolutePrices.Min() : 0;
                foreach (var variant in variants)
                {
                    var absolute = variant.PriceAdjustment > 0 ? variant.PriceAdjustment : price;
                    ProductVariantLogic.SetAbsolutePrice(variant, price, absolute);
                }
            }
            else
            {
                ProductVariantLogic.ApplySamePriceMode(variants);
            }
        }

        var sku = string.IsNullOrWhiteSpace(_formSku)
            ? ProductService.SuggestSku(_formCategory)
            : _formSku.Trim().ToUpperInvariant();

        foreach (var variant in variants)
        {
            if (string.IsNullOrWhiteSpace(variant.Sku)
                || variant.Sku.Contains("_formSku", StringComparison.Ordinal))
            {
                variant.Sku = ProductVariantLogic.SuggestSku(sku, variant.ColorName, variant.Size) ?? sku;
            }
        }

        var images = _previewImages
            .Select(p => p.DataUrl)
            .Where(u => !string.IsNullOrWhiteSpace(u))
            .ToList();
        var model = new AdminProduct
        {
            Id = _editProductId ?? 0,
            Name = _formName.Trim(),
            Description = _formDescription.Trim(),
            Category = _formCategory.Trim(),
            Status = status,
            Price = price,
            Sku = sku,
            Stock = stock,
            Sold = _isEditMode ? _formSold : 0,
            Images = images,
            ImageUrl = images.Count > 0 ? images[0]! : MockData.PlaceholderImage,
            Colors = hasVariants
                ? variants
                    .Select(v => v.ColorName)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Select(c => c!)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList()
                : SplitColors(_formColors),
            Sizes = variants.Select(v => v.Size).Where(s => !string.IsNullOrWhiteSpace(s)).ToList(),
            Variants = variants,
            CreatedAt = DateTime.Now
        };

        if (_isEditMode)
        {
            var ok = await ProductService.UpdateAsync(model);
            if (!ok) return false;

            if (!string.Equals(_originalCategory, model.Category, StringComparison.OrdinalIgnoreCase))
            {
                await CategoryService.AdjustProductCountAsync(_originalCategory, -1);
                await CategoryService.AdjustProductCountAsync(model.Category, 1);
            }

            return true;
        }

        await ProductService.AddAsync(model);
        await CategoryService.AdjustProductCountAsync(model.Category, 1);
        _currentPage = 1;
        return true;
    }

    private static List<string> SplitColors(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task SetBodyScrollLock(bool locked)
    {
        try
        {
            await JS.InvokeVoidAsync("nubeSetBodyScrollLock", locked);
        }
        catch
