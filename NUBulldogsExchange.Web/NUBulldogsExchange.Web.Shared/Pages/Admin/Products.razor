@page "/admin/products"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Forms
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Components.Admin
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AdminProductService ProductService
@inject AdminCategoryService CategoryService
@inject AdminReviewService ReviewService
@inject AdminInventoryService InventoryService
@inject AdminOrderService OrderService
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Products | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-products">
    <header class="admin-products-header">
        <div>
            <h1>Products</h1>
            <p>Manage your merchandise catalog</p>
        </div>
        <button type="button" class="btn btn-navy admin-add-product-btn" @onclick="OpenAddModal">
            <Icon Name="plus" Size="16" />
            Add Product
        </button>
    </header>

    <section class="admin-products-stats" aria-label="Product summary">
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-blue"><Icon Name="package" Size="18" /></div>
            <div>
                <span>Total Products</span>
                <strong>@ProductService.All.Count.ToString("N0")</strong>
            </div>
        </article>
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-green"><Icon Name="check-circle" Size="18" /></div>
            <div>
                <span>Active Products</span>
                <strong>@ActiveCount.ToString("N0")</strong>
            </div>
        </article>
        <article class="admin-inventory-stat" title="@(DraftCount > 0 ? $"Includes {DraftCount} draft product{(DraftCount == 1 ? "" : "s")}" : null)">
            <div class="admin-inventory-stat-icon tone-gold"><Icon Name="clock" Size="18" /></div>
            <div>
                <span>Inactive Products</span>
                <strong>@InactiveCount.ToString("N0")</strong>
            </div>
        </article>
        <article class="admin-inventory-stat">
            <div class="admin-inventory-stat-icon tone-purple"><Icon Name="tag" Size="18" /></div>
            <div>
                <span>Total Categories</span>
                <strong>@CategoryCount.ToString("N0")</strong>
            </div>
        </article>
    </section>

    <section class="admin-products-filters">
        <div class="admin-products-toolbar">
            <div class="admin-products-search">
                <Icon Name="search" Size="16" CssClass="admin-products-search-icon" />
                <input type="search"
                       placeholder="Search products (name, SKU, category)..."
                       aria-label="Search products"
                       value="@_search"
                       @oninput="OnSearchInput" />
            </div>
            <select class="admin-products-select" aria-label="Filter by category" value="@_category" @onchange="OnCategoryChange">
                <option value="All">All Categories</option>
                @foreach (var category in FilterCategoryNames)
                {
                    <option value="@category">@category</option>
                }
            </select>
            <select class="admin-products-select" aria-label="Filter by status" value="@_status" @onchange="OnStatusChange">
                @foreach (var (value, label) in StatusOptions)
                {
                    <option value="@value">@label</option>
                }
            </select>
            <select class="admin-products-select" aria-label="Sort products" value="@_sort" @onchange="OnSortChange">
                @foreach (var (value, label) in SortOptions)
                {
                    <option value="@value">Sort By: @label</option>
                }
            </select>
        </div>

        @if (HasActiveFilters)
        {
            <div class="admin-filter-chips">
                <span class="admin-filter-chips-label">Active Filters:</span>
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <span class="admin-filter-chip">
                        Search: @_search.Trim()
                        <button type="button" aria-label="Remove search filter" @onclick="ClearSearch"><Icon Name="x" Size="12" /></button>
                    </span>
                }
                @if (!IsAll(_category))
                {
                    <span class="admin-filter-chip">
                        Category: @_category
                        <button type="button" aria-label="Remove category filter" @onclick="ClearCategory"><Icon Name="x" Size="12" /></button>
                    </span>
                }
                @if (!IsAll(_status))
                {
                    <span class="admin-filter-chip">
                        Status: @_status
                        <button type="button" aria-label="Remove status filter" @onclick="ClearStatus"><Icon Name="x" Size="12" /></button>
                    </span>
                }
                <button type="button" class="admin-filter-clear" @onclick="ClearFilters">Clear Filters</button>
            </div>
        }
    </section>

    <section class="admin-products-table-card @(_openMenuId is not null ? "is-menu-open" : null)">
        <div class="admin-products-actionbar">
            @if (_selectedIds.Count > 0)
            {
                <div class="admin-bulk-bar" role="region" aria-label="Bulk actions">
                    <span class="admin-bulk-count">
                        <input type="checkbox" checked disabled aria-hidden="true" tabindex="-1" />
                        @_selectedIds.Count product@(_selectedIds.Count == 1 ? "" : "s") selected
                    </span>
                    <button type="button" class="admin-bulk-btn is-activate" @onclick='() => RequestBulkStatus("Active")'>
                        <Icon Name="check-circle" Size="14" /> Set Active
                    </button>
                    <button type="button" class="admin-bulk-btn is-deactivate" @onclick='() => RequestBulkStatus("Inactive")'>
                        <Icon Name="clock" Size="14" /> Set Inactive
                    </button>
                    <button type="button" class="admin-bulk-btn is-delete" @onclick="ConfirmBulkDelete">
                        <Icon Name="trash" Size="14" /> Delete
                    </button>
                    <button type="button" class="admin-bulk-clear" @onclick="() => _selectedIds.Clear()">Clear selection</button>
                </div>
            }
            else
            {
                <span class="admin-products-actionbar-hint">@ResultLabel</span>
            }
            <button type="button"
                    class="btn btn-outline-navy admin-products-export"
                    disabled="@(!Filtered.Any())"
                    title="@(_selectedIds.Count > 0 ? "Export selected products as CSV" : "Export filtered products as CSV")"
                    @onclick="ExportCsv">
                <Icon Name="download" Size="15" />
                Export CSV
            </button>
        </div>

        @if (!Filtered.Any())
        {
            <div class="admin-products-empty">
                <div class="admin-products-empty-icon" aria-hidden="true">
                    <Icon Name="package" Size="36" />
                </div>
                <h2>No products found.</h2>
                <p>Try adjusting your search or filters.</p>
                @if (HasActiveFilters)
                {
                    <button type="button" class="btn btn-navy" @onclick="ClearFilters">Clear Filters</button>
                }
            </div>
        }
        else
        {
            <div class="admin-products-table-wrap">
                <table class="admin-products-table">
                    <thead>
                        <tr>
                            <th class="col-check">
                                <input type="checkbox"
                                       checked="@AllVisibleSelected"
                                       @onchange="ToggleSelectAll"
                                       aria-label="Select all products" />
                            </th>
                            <th class="col-image">Image</th>
                            <th class="col-sku">SKU</th>
                            <th class="col-name">Product Name</th>
                            <th class="col-category">Category</th>
                            <th class="col-price">Price</th>
                            <th class="col-stock">Stock</th>
                            <th class="col-sold">Sold</th>
                            <th class="col-rating">Rating</th>
                            <th class="col-reviews">Reviews</th>
                            <th class="col-status">Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Paged.Any())
                        {
                            <tr>
                                <td colspan="12" class="admin-products-empty-page">No products on this page.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Paged)
                            {
                                <tr class="@(_selectedIds.Contains(product.Id) ? "is-selected" : "")">
                                    <td class="col-check">
                                        <input type="checkbox"
                                               checked="@_selectedIds.Contains(product.Id)"
                                               @onchange="e => ToggleRow(product.Id, e)"
                                               aria-label="@($"Select {product.Name}")" />
                                    </td>
                                    <td class="col-image">
                                        <button type="button"
                                                class="admin-product-thumb"
                                                aria-label="@($"View {product.Name}")"
                                                @onclick="() => ViewProduct(product.Id)">
                                            <img src="@(string.IsNullOrWhiteSpace(product.ImageUrl) ? MockData.PlaceholderImage : product.ImageUrl)"
                                                 alt="@product.Name"
                                                 loading="lazy"
                                                 onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                        </button>
                                    </td>
                                    <td class="col-sku"><code>@product.Sku</code></td>
                                    <td class="col-name">
                                        <button type="button"
                                                class="admin-product-name-link"
                                                title="@product.Name"
                                                @onclick="() => ViewProduct(product.Id)">
                                            @product.Name
                                        </button>
                                    </td>
                                    <td class="col-category">@product.Category</td>
                                    @{ var priceDisplay = DescribePrice(product); }
                                    <td class="col-price">
                                        <div class="admin-price-cell">
                                            <strong title="@priceDisplay.Issue">@priceDisplay.Text</strong>
                                            @if (priceDisplay.Mode == ProductVariantLogic.AdminPriceMode.Same)
                                            {
                                                <span class="admin-price-badge is-same"
                                                      title="All variants currently use the same selling price.">Same Price</span>
                                            }
                                            else if (priceDisplay.Mode == ProductVariantLogic.AdminPriceMode.Fixed)
                                            {
                                                <span class="admin-price-badge is-same"
                                                      title="Single selling price (no variants).">Same Price</span>
                                            }
                                            else if (priceDisplay.Mode == ProductVariantLogic.AdminPriceMode.Variable)
                                            {
                                                <span class="admin-price-badge is-variable"
                                                      title="Prices vary by product variant.">Variable Price</span>
                                            }
                                        </div>
                                    </td>
                                    @{
                                        var stock = StockFor(product);
                                        var reviewStats = ReviewStatsFor(product);
                                    }
                                    <td class="col-stock">
                                        <div class="admin-stock-cell" title="@stock.Detail">
                                            <strong>@stock.Total.ToString("N0")@(stock.VariantCount > 0 ? " total" : "")</strong>
                                            @if (stock.VariantCount > 0)
                                            {
                                                <small>@stock.VariantCount variant@(stock.VariantCount == 1 ? "" : "s")</small>
                                            }
                                            <span class="admin-stock-badge stock-@stock.Key">@stock.Label</span>
                                        </div>
                                    </td>
                                    <td class="col-sold">@SoldFor(product).ToString("N0")</td>
                                    <td class="col-rating">
                                        <button type="button"
                                                class="ar-rating-link"
                                                title="View reviews"
                                                @onclick="() => OpenProductReviews(product)">
                                            @if (reviewStats.Count <= 0)
                                            {
                                                <span class="ar-rating-empty">—</span>
                                            }
                                            else
                                            {
                                                <span class="ar-rating-value"><span class="ar-star-icon">★</span> @reviewStats.Average.ToString("0.0")</span>
                                            }
                                        </button>
                                    </td>
                                    <td class="col-reviews">
                                        <button type="button"
                                                class="ar-reviews-link"
                                                title="View reviews"
                                                @onclick="() => OpenProductReviews(product)">
                                            @reviewStats.Count
                                        </button>
                                    </td>
                                    <td class="col-status">
                                        <span class="admin-product-status @product.StatusCssClass">
                                            @product.Status
                                        </span>
                                    </td>
                                    <td class="col-actions">
                                        <div class="admin-products-row-actions">
                                            <button type="button"
                                                    class="btn btn-outline-navy admin-products-inline-btn"
                                                    aria-label="@($"Edit {product.Name}")"
                                                    @onclick="() => EditProduct(product.Id)">
                                                <Icon Name="pencil" Size="13" /> Edit
                                            </button>
                                            <button type="button"
                                                    class="btn btn-navy admin-products-inline-btn"
                                                    aria-label="@($"Adjust price for {product.Name}")"
                                                    @onclick="() => OpenAdjustPrice(product)">
                                                <Icon Name="tag" Size="13" /> Adjust Price
                                            </button>
                                            <div class="admin-row-menu-wrap">
                                                <button type="button"
                                                        class="admin-row-action"
                                                        title="More actions"
                                                        aria-label="Product actions"
                                                        @onclick="() => ToggleMenu(product.Id)"
                                                        @onclick:stopPropagation="true">
                                                    <Icon Name="more-horizontal" Size="16" />
                                                </button>

                                                @if (_openMenuId == product.Id)
                                                {
                                                    <div class="admin-row-menu" role="menu" @onclick:stopPropagation="true">
                                                        <button type="button" class="admin-row-menu-item" @onclick="() => ViewProduct(product.Id)">
                                                            <Icon Name="eye" Size="14" /> View Product
                                                        </button>
                                                        <button type="button" class="admin-row-menu-item" @onclick="() => OpenProductReviews(product)">
                                                            <Icon Name="star" Size="14" /> View Reviews
                                                        </button>
                                                        <button type="button" class="admin-row-menu-item" @onclick="() => OpenPriceHistory(product)">
                                                            <Icon Name="clock" Size="14" /> View Price History
                                                        </button>
                                                        <button type="button" class="admin-row-menu-item" @onclick="() => DuplicateProduct(product.Id)">
                                                            <Icon Name="copy" Size="14" /> Duplicate Product
                                                        </button>
                                                        <button type="button" class="admin-row-menu-item" @onclick="() => ToggleStatus(product)">
                                                            <Icon Name="refresh" Size="14" />
                                                            @(product.IsActive ? "Set Inactive" : "Set Active")
                                                        </button>
                                                        <div class="admin-row-menu-sep"></div>
                                                        <button type="button" class="admin-row-menu-item danger" @onclick="() => ConfirmDelete(product)">
                                                            <Icon Name="trash" Size="14" /> Delete Product
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="admin-products-footer">
                @if (Filtered.Count > 0 && TotalPages > 1)
                {
                    <div class="shop-pager admin-products-pager" role="navigation" aria-label="Products pagination">
                        <label class="shop-pager-size">
                            <span>Page size:</span>
                            <select value="@_pageSize" @onchange="OnPageSizeChanged" aria-label="Products per page">
                                @foreach (var size in PageSizes)
                                {
                                    <option value="@size">@size</option>
                                }
                            </select>
                        </label>

                        <span class="shop-pager-range">@RangeLabel</span>

                        <div class="shop-pager-nav">
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(CurrentPage <= 1)"
                                    title="First page"
                                    aria-label="First page"
                                    @onclick="() => GoToPage(1)">«</button>
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(CurrentPage <= 1)"
                                    title="Previous page"
                                    aria-label="Previous page"
                                    @onclick="() => GoToPage(CurrentPage - 1)">‹</button>
                            <span class="shop-pager-status">
                                Page <strong>@CurrentPage</strong> of @TotalPages
                            </span>
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(CurrentPage >= TotalPages)"
                                    title="Next page"
                                    aria-label="Next page"
                                    @onclick="() => GoToPage(CurrentPage + 1)">›</button>
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(CurrentPage >= TotalPages)"
                                    title="Last page"
                                    aria-label="Last page"
                                    @onclick="() => GoToPage(TotalPages)">»</button>
                        </div>
                    </div>
                }
                else
                {
                    <span>@ResultLabel</span>
                }
            </div>
        }
    </section>
</div>

@if (_openMenuId is not null)
{
    <div class="admin-menu-backdrop" @onclick="CloseMenu"></div>
}

@if (_productModalOpen)
{
    <div class="admin-modal-backdrop admin-product-modal-backdrop" @onclick="RequestCloseProductModal">
        <div class="admin-product-modal" role="dialog" aria-modal="true" aria-labelledby="product-modal-title" @onclick:stopPropagation="true">
            <header class="admin-product-modal-header">
                <h2 id="product-modal-title">@(_isEditMode ? "Edit Product" : "Add New Product")</h2>
                <button type="button" class="admin-product-modal-close" aria-label="Close" @onclick="RequestCloseProductModal">
                    <Icon Name="x" Size="18" />
                </button>
            </header>

            <div class="admin-product-modal-body">
                <label class="admin-field">
                    <span>Product Name</span>
                    <input type="text"
                           value="@_formName"
                           @oninput="OnNameInput"
                           placeholder="NU Bulldogs Classic Shirt" />
                    @if (_formErrors.ContainsKey("name"))
                    {
                        <em>@_formErrors["name"]</em>
                    }
                </label>

                <label class="admin-field">
                    <span>Description</span>
                    <textarea rows="4"
                              value="@_formDescription"
                              @oninput="OnDescriptionInput"
                              placeholder="Product description..."></textarea>
                </label>

                <div class="admin-product-modal-grid">
                    <label class="admin-field">
                        <span>Category</span>
                        <select value="@_formCategory" @onchange="OnCategorySelect">
                            <option value="">Select category</option>
                            @foreach (var category in FormCategoryNames)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                        @if (_formErrors.ContainsKey("category"))
                        {
                            <em>@_formErrors["category"]</em>
                        }
                        else if (!FormCategoryNames.Any())
                        {
                            <em>No categories yet. Add one in Categories first.</em>
                        }
                    </label>

                    <label class="admin-field">
                        <span>Status</span>
                        <select value="@_formStatus" @onchange="OnStatusSelect">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            @if (_isEditMode && string.Equals(_formStatus, "Draft", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Draft">Draft</option>
                            }
                        </select>
                        @if (_formErrors.ContainsKey("status"))
                        {
                            <em>@_formErrors["status"]</em>
                        }
                    </label>
                </div>

                <div class="admin-product-modal-grid">
                    @if (!_hasVariants)
                    {
                        @if (_isEditMode)
                        {
                            <label class="admin-field">
                                <span>Price (₱)</span>
                                <input type="text"
                                       value="@($"₱{_formPriceText}")"
                                       disabled
                                       readonly />
                                <small class="ar-hint">Use <strong>Adjust Price</strong> to change pricing.</small>
                            </label>
                        }
                        else
                        {
                            <label class="admin-field">
                                <span>Price (₱)</span>
                                <input type="number"
                                       min="0.01"
                                       step="0.01"
                                       value="@_formPriceText"
                                       @oninput="OnPriceInput"
                                       placeholder="499" />
                                @if (_formErrors.ContainsKey("price"))
                                {
                                    <em>@_formErrors["price"]</em>
                                }
                            </label>
                        }
                    }

                    <label class="admin-field">
                        <span>SKU</span>
                        <input type="text"
                               value="@(string.IsNullOrWhiteSpace(_formSku) ? "Auto-generated from category" : _formSku)"
                               disabled
                               readonly
                               class="admin-sku-readonly" />
                        <small class="ar-hint">Auto-generated from category. Variant SKUs are derived from this.</small>
                        @if (_formErrors.ContainsKey("sku"))
                        {
                            <em>@_formErrors["sku"]</em>
                        }
                    </label>
                </div>

                <ProductSizeVariantEditor HasVariants="_hasVariants"
                                          HasVariantsChanged="OnHasVariantsChanged"
                                          Variants="_formVariants"
                                          VariantsChanged="OnVariantsChanged"
                                          StockText="_formStockText"
                                          StockTextChanged="OnStockTextChanged"
                                          StockError="@(_formErrors.GetValueOrDefault("stock"))"
                                          VariantsError="@(_formErrors.GetValueOrDefault("variants"))"
                                          BaseSku="@_formSku"
                                          BasePriceText="_formPriceText"
                                          BasePriceTextChanged="OnPriceInputFromVariants"
                                          BasePriceError="@(_formErrors.GetValueOrDefault("price"))"
                                          BasePriceReadOnly="_isEditMode"
                                          UseDifferentPrices="_useDifferentPrices"
                                          UseDifferentPricesChanged="OnPricingModeChanged"
                                          PriceModeLocked="_isEditMode"
                                          PriceInputsReadOnly="_isEditMode" />

                @if (_isEditMode && !_hasVariants)
                {
                    <label class="admin-field">
                        <span>Colors</span>
                        <input type="text"
                               value="@_formColors"
                               @oninput="OnColorsInput"
                               placeholder="navy, white" />
                    </label>
                }

                <div class="admin-field admin-product-image-section">
                    <span>Product Image@(_isEditMode ? "" : "s")</span>
                    @if (_isEditMode)
                    {
                        @if (_previewImages.Count > 0)
                        {
                            <div class="admin-product-image-current">
                                <img src="@_previewImages[0].DataUrl"
                                     alt="Product preview"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                <div class="admin-product-image-actions">
                                    <button type="button" class="btn btn-outline-navy">
                                        Replace Image
                                        <InputFile OnChange="OnReplaceImageSelected"
                                                   accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                                                   class="admin-product-upload-input" />
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="admin-product-upload @(_isDragOver ? "is-dragover" : "")"
                                 @ondragenter="OnDragEnter"
                                 @ondragenter:preventDefault
                                 @ondragover="OnDragOver"
                                 @ondragover:preventDefault
                                 @ondragleave="OnDragLeave">
                                <InputFile OnChange="OnImagesSelected"
                                           accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                                           multiple
                                           class="admin-product-upload-input" />
                                <div class="admin-product-upload-content" aria-hidden="true">
                                    <Icon Name="upload" Size="28" CssClass="admin-product-upload-icon" />
                                    <p>Drag &amp; drop images here, or click to upload</p>
                                    <small>PNG, JPG up to 10MB each</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="admin-product-upload @(_isDragOver ? "is-dragover" : "") @(_previewImages.Count > 0 ? "has-previews" : "")"
                             @ondragenter="OnDragEnter"
                             @ondragenter:preventDefault
                             @ondragover="OnDragOver"
                             @ondragover:preventDefault
                             @ondragleave="OnDragLeave">
                            @if (_previewImages.Count == 0)
                            {
                                <InputFile OnChange="OnImagesSelected"
                                           accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                                           multiple
                                           class="admin-product-upload-input" />
                                <div class="admin-product-upload-content" aria-hidden="true">
                                    <Icon Name="upload" Size="28" CssClass="admin-product-upload-icon" />
                                    <p>Drag &amp; drop images here, or click to upload</p>
                                    <small>PNG, JPG up to 10MB each</small>
                                </div>
                            }
                            else
                            {
                                <div class="admin-product-previews">
                                    @for (var i = 0; i < _previewImages.Count; i++)
                                    {
                                        var index = i;
                                        var preview = _previewImages[index];
                                        <div class="admin-product-preview">
                                            <img src="@preview.DataUrl" alt="@($"Product image {index + 1}")" />
                                            @if (index == 0)
                                            {
                                                <span class="admin-product-preview-main">Main</span>
                                            }
                                            <button type="button"
                                                    class="admin-product-preview-remove"
                                                    aria-label="Remove image"
                                                    @onclick="() => RemoveImage(index)">
                                                <Icon Name="x" Size="12" />
                                            </button>
                                        </div>
                                    }
                                    <div class="admin-product-preview admin-product-preview-add">
                                        <InputFile OnChange="OnImagesSelected"
                                                   accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                                                   multiple
                                                   class="admin-product-upload-input" />
                                        <Icon Name="plus" Size="22" CssClass="admin-product-upload-icon" />
                                        <span>Add</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @if (_formErrors.ContainsKey("images"))
                    {
                        <em>@_formErrors["images"]</em>
                    }
                </div>
            </div>

            <footer class="admin-product-modal-footer @(_isEditMode ? "is-edit" : null)">
                @if (_isEditMode)
                {
                    <button type="button" class="btn btn-outline-navy" @onclick="RequestCloseProductModal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-navy admin-product-save-btn" @onclick="SaveEditedProduct">
                        Save Changes
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-navy admin-product-save-btn" @onclick="SaveProduct">
                        Save Product
                    </button>
                    <button type="button" class="btn btn-outline-navy" @onclick="SaveDraft">
                        Save Draft
                    </button>
                    <button type="button" class="btn btn-outline-navy" @onclick="RequestCloseProductModal">
                        Cancel
                    </button>
                }
            </footer>
        </div>
    </div>
}

@if (_discardConfirm)
{
    <div class="admin-modal-backdrop admin-discard-confirm-backdrop" @onclick="KeepEditing">
        <div class="admin-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>Discard unsaved changes?</h2>
            <p>Your changes will be lost if you close this form.</p>
            <p class="admin-modal-note">This action cannot be undone.</p>
            <div class="admin-modal-actions">
                <button type="button" class="btn btn-outline-navy" @onclick="KeepEditing">Keep Editing</button>
                <button type="button" class="btn admin-btn-danger" @onclick="DiscardAndClose">Discard</button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is not null || _bulkDelete)
{
    <div class="admin-modal-backdrop" @onclick="CancelDelete">
        <div class="admin-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            @{
                var targets = DeleteTargets;
                var withHistory = targets.Count(p => HasOrderHistory(p.Id));
            }
            <h2>@(_bulkDelete ? "Delete the selected products?" : "Delete Product?")</h2>
            @if (_bulkDelete)
            {
                <p><strong>@targets.Count</strong> product@(targets.Count == 1 ? "" : "s") selected.</p>
            }
            else if (_deleteTarget is not null)
            {
                <p>Are you sure you want to delete <strong>"@_deleteTarget.Name"</strong>?</p>
            }
            @if (withHistory > 0)
            {
                <p class="admin-modal-note">
                    @withHistory product@(withHistory == 1 ? " has" : "s have") order history and will be set to
                    <strong>Inactive</strong> instead, so past orders stay intact.
                </p>
            }
            @if (withHistory < targets.Count)
            {
                <p class="admin-modal-note">Products without orders are permanently deleted. This cannot be undone.</p>
            }
            <div class="admin-modal-actions">
                <button type="button" class="btn btn-outline-navy" @onclick="CancelDelete" disabled="@_busy">Cancel</button>
                <button type="button" class="btn admin-btn-danger" @onclick="ConfirmDeleteAction" disabled="@_busy">
                    @(_busy ? "Working…" : withHistory == targets.Count ? "Set Inactive" : "Delete")
                </button>
            </div>
        </div>
    </div>
}

