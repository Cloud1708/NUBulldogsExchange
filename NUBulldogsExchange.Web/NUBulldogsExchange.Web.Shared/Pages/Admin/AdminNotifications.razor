@page "/admin/notifications"
@layout AdminLayout
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AdminNotificationService NotificationHub
@inject ToastService Toast
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Notifications | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-notifs">
    <header class="admin-notifs-header">
        <div>
            <div class="admin-notifs-title-row">
                <h1>Notifications</h1>
                @if (NotificationHub.UnreadCount > 0)
                {
                    <span class="admin-notifs-new">@NotificationHub.UnreadCount new</span>
                }
            </div>
            <p>Stay on top of your store activity</p>
        </div>
        <div class="admin-notifs-actions">
            <button type="button" class="btn btn-outline-navy admin-notifs-action" @onclick="MarkAllRead">
                <Icon Name="check" Size="14" />
                Mark All Read
            </button>
            <button type="button" class="btn btn-outline-navy admin-notifs-action muted" @onclick="OpenClear">
                <Icon Name="trash" Size="14" />
                Clear Read
            </button>
        </div>
    </header>

    <div class="admin-notifs-stats">
        <article class="admin-notifs-stat">
            <strong class="tone-red">@NotificationHub.UnreadCount</strong>
            <span>Unread</span>
        </article>
        <article class="admin-notifs-stat">
            <strong class="tone-blue">@NotificationHub.OrderCount</strong>
            <span>Order Alerts</span>
        </article>
        <article class="admin-notifs-stat">
            <strong class="tone-gold">@NotificationHub.StockCount</strong>
            <span>Stock Alerts</span>
        </article>
    </div>

    <nav class="admin-notifs-tabs" aria-label="Notification filters">
        @foreach (var tab in AdminNotificationService.Tabs)
        {
            <button type="button"
                    class="admin-notifs-tab @(_tab == tab.Key ? "active" : "")"
                    @onclick="() => SetTab(tab.Key)">
                @tab.Label
                <strong>@NotificationHub.CountByTab(tab.Key)</strong>
            </button>
        }
    </nav>

    <section class="admin-notifs-list">
        @{
            var items = NotificationHub.Filter(_tab).ToList();
            var totalPages = Math.Max(1, (int)Math.Ceiling(items.Count / (double)_pageSize));
            if (_currentPage > totalPages) _currentPage = totalPages;
            if (_currentPage < 1) _currentPage = 1;
            var pageItems = items.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
            var rangeStart = items.Count == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
            var rangeEnd = Math.Min(_currentPage * _pageSize, items.Count);
        }
        @if (!items.Any())
        {
            <div class="admin-notifs-empty">
                <div class="admin-products-empty-icon" aria-hidden="true">
                    <Icon Name="bell" Size="36" />
                </div>
                @if (NotificationHub.TotalCount == 0)
                {
                    <h2>You're all caught up.</h2>
                    <p>There are no notifications to display.</p>
                }
                else
                {
                    <h2>No notifications here.</h2>
                    <p>You're all caught up.</p>
                }
            </div>
        }
        else
        {
            @foreach (var item in pageItems)
            {
                <article class="admin-notif-card @(item.Read ? "is-read" : "is-unread")"
                         @onclick="() => OnCardClick(item)">
                    <div class="admin-notif-icon tone-@item.Tone" aria-hidden="true">
                        <Icon Name="@item.IconName" Size="18" />
                    </div>
                    <div class="admin-notif-body">
                        <h3>@item.Title</h3>
                        <p>@item.Message</p>
                        @if (!string.IsNullOrWhiteSpace(item.RelatedLabel))
                        {
                            @if (!string.IsNullOrWhiteSpace(item.RelatedHref))
                            {
                                <a class="admin-notif-badge"
                                   href="@item.RelatedHref"
                                   @onclick:stopPropagation="true">
                                    @item.RelatedLabel
                                </a>
                            }
                            else
                            {
                                <span class="admin-notif-badge">@item.RelatedLabel</span>
                            }
                        }
                        <time>@item.TimeLabel</time>
                    </div>
                    @if (!item.Read)
                    {
                        <span class="admin-notif-unread-dot" aria-hidden="true"></span>
                    }
                </article>
            }

            <div class="shop-pager admin-products-pager" role="navigation" aria-label="Notifications pagination">
                <label class="shop-pager-size">
                    <span>Page size:</span>
                    <select value="@_pageSize" @onchange="OnPageSizeChanged" aria-label="Notifications per page">
                        @foreach (var size in PageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </label>

                <span class="shop-pager-range">@rangeStart to @rangeEnd of @items.Count</span>

                <div class="shop-pager-nav">
                    <button type="button"
                            class="shop-pager-btn"
                            disabled="@(_currentPage <= 1)"
                            title="First page"
                            aria-label="First page"
                            @onclick="() => GoToPage(1, totalPages)">«</button>
                    <button type="button"
                            class="shop-pager-btn"
                            disabled="@(_currentPage <= 1)"
                            title="Previous page"
                            aria-label="Previous page"
                            @onclick="() => GoToPage(_currentPage - 1, totalPages)">‹</button>
                    <span class="shop-pager-status">
                        Page <strong>@_currentPage</strong> of @totalPages
                    </span>
                    <button type="button"
                            class="shop-pager-btn"
                            disabled="@(_currentPage >= totalPages)"
                            title="Next page"
                            aria-label="Next page"
                            @onclick="() => GoToPage(_currentPage + 1, totalPages)">›</button>
                    <button type="button"
                            class="shop-pager-btn"
                            disabled="@(_currentPage >= totalPages)"
                            title="Last page"
                            aria-label="Last page"
                            @onclick="() => GoToPage(totalPages, totalPages)">»</button>
                </div>
            </div>
        }
    </section>
</div>

@if (_showClear)
{
    <div class="admin-modal-backdrop" @onclick="CloseClear">
        <div class="admin-modal admin-promo-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>Clear Read Notifications?</h2>
            <p>This will remove all notifications that have already been read.</p>
            <div class="admin-modal-actions">
                <button type="button" class="btn btn-outline-navy" @onclick="CloseClear">Cancel</button>
                <button type="button" class="btn admin-btn-danger" @onclick="ConfirmClear">Clear</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly int[] PageSizes = [5, 8, 10, 12, 24];

    private string _tab = "all";
    private bool _showClear;
    private int _pageSize = 10;
    private int _currentPage = 1;

    protected override void OnInitialized() => NotificationHub.OnChange += Refresh;

    private void SetTab(string tab)
    {
        _tab = tab;
        _currentPage = 1;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var size) && PageSizes.Contains(size)
            ? size
            : 10;
        _currentPage = 1;
    }

    private void GoToPage(int page, int totalPages) =>
        _currentPage = Math.Clamp(page, 1, totalPages);

    private void OnCardClick(AdminNotificationItem item)
    {
        if (!item.Read)
            NotificationHub.MarkRead(item.Id);

        if (!string.IsNullOrWhiteSpace(item.RelatedHref) && item.Type != "system")
            Navigation.NavigateTo(item.RelatedHref);
    }

    private async Task MarkAllRead()
    {
        await NotificationHub.MarkAllReadAsync();
        Toast.Show("All notifications marked as read.");
    }

    private void OpenClear() => _showClear = true;
    private void CloseClear() => _showClear = false;

    private async Task ConfirmClear()
    {
        var removed = await NotificationHub.ClearReadAsync();
        _showClear = false;
        Toast.Show(removed > 0
            ? "Read notifications cleared."
            : "No read notifications to clear.");
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => NotificationHub.OnChange -= Refresh;
}
