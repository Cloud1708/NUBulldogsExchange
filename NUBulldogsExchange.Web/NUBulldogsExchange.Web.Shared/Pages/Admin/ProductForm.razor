@page "/admin/products/new"
@page "/admin/products/{Id:int}/edit"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Forms
@using NUBulldogsExchange.Web.Shared.Components.Admin
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AdminProductService ProductService
@inject AdminCategoryService CategoryService
@inject ToastService Toast
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(IsEdit ? "Edit Product" : "Add Product") | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-product-form-page">
    <header class="admin-products-header">
        <div>
            <h1>@(IsEdit ? "Edit Product" : "Add Product")</h1>
            <p>@(IsEdit ? "Update merchandise details." : "Create a new catalog item.")</p>
        </div>
        <a href="/admin/products" class="btn btn-outline-navy">Back to Products</a>
    </header>

    @if (_notFound)
    {
        <div class="admin-card admin-placeholder-card">
            <h2>Product not found</h2>
            <p>This product may have been deleted.</p>
            <a href="/admin/products" class="btn btn-navy">Back to Products</a>
        </div>
    }
    else
    {
        <form class="admin-card admin-product-form" @onsubmit="Save" @onsubmit:preventDefault="true">
            <div class="admin-form-grid">
                <label class="admin-field admin-field-full">
                    <span>Product Name *</span>
                    <input type="text" @bind="_name" @bind:event="oninput" placeholder="NU Bulldogs Classic Shirt" />
                    @if (_errors.ContainsKey(nameof(_name)))
                    {
                        <em>@_errors[nameof(_name)]</em>
                    }
                </label>

                <label class="admin-field admin-field-full">
                    <span>Description</span>
                    <textarea rows="4" @bind="_description" @bind:event="oninput" placeholder="Product description"></textarea>
                </label>

                <label class="admin-field">
                    <span>Category *</span>
                    <select @bind="_category">
                        <option value="">Select category</option>
                        @foreach (var category in FormCategoryNames)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                    @if (_errors.ContainsKey(nameof(_category)))
                    {
                        <em>@_errors[nameof(_category)]</em>
                    }
                    else if (!FormCategoryNames.Any())
                    {
                        <em>No categories yet. Add one in Categories first.</em>
                    }
                </label>

                <label class="admin-field">
                    <span>Status *</span>
                    <select @bind="_status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </label>

                <label class="admin-field">
                    <span>Price *</span>
                    <input type="number" min="0" step="1" @bind="_price" @bind:event="oninput" />
                    @if (_errors.ContainsKey(nameof(_price)))
                    {
                        <em>@_errors[nameof(_price)]</em>
                    }
                </label>

                <label class="admin-field">
                    <span>SKU *</span>
                    <input type="text" @bind="_sku" @bind:event="oninput" placeholder="NUBE-TS-001" />
                    @if (_errors.ContainsKey(nameof(_sku)))
                    {
                        <em>@_errors[nameof(_sku)]</em>
                    }
                </label>

                <div class="admin-field-full">
                    <ProductSizeVariantEditor HasSizeVariants="_hasSizeVariants"
                                              HasSizeVariantsChanged="OnHasSizeVariantsChanged"
                                              Variants="_variants"
                                              VariantsChanged="OnVariantsChanged"
                                              StockText="@_stock.ToString()"
                                              StockTextChanged="OnStockTextChanged"
                                              StockError="@(_errors.GetValueOrDefault(nameof(_stock)))"
                                              VariantsError="@(_errors.GetValueOrDefault("variants"))"
                                              BaseSku="_sku" />
                </div>

                <label class="admin-field admin-field-full">
                    <span>Colors (comma-separated)</span>
                    <input type="text" @bind="_colors" @bind:event="oninput" placeholder="navy, gold, white" />
                </label>

                <div class="admin-field admin-field-full admin-product-image-section">
                    <span>Product Image</span>
                    @if (!string.IsNullOrWhiteSpace(_imageUrl))
                    {
                        <div class="admin-product-image-current">
                            <img src="@_imageUrl"
                                 alt="Preview"
                                 onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                            <div class="admin-product-image-actions">
                                <button type="button" class="btn btn-outline-navy">
                                    Replace Image
                                    <InputFile OnChange="OnReplaceImageSelected"
                                               accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                                               class="admin-product-upload-input" />
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="admin-product-upload">
                            <InputFile OnChange="OnReplaceImageSelected"
                                       accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                                       class="admin-product-upload-input" />
                            <div class="admin-product-upload-content" aria-hidden="true">
                                <Icon Name="upload" Size="28" CssClass="admin-product-upload-icon" />
                                <p>Click to upload a product image</p>
                                <small>PNG, JPG up to 10MB</small>
                            </div>
                        </div>
                    }
                    @if (_errors.ContainsKey(nameof(_imageUrl)))
                    {
                        <em>@_errors[nameof(_imageUrl)]</em>
                    }
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="btn btn-navy">@(IsEdit ? "Save Changes" : "Add Product")</button>
                <a href="/admin/products" class="btn btn-outline-navy">Cancel</a>
            </div>
        </form>
    }
</div>

@code {
    private const long MaxImageBytes = 10 * 1024 * 1024;

    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id is > 0;
    private bool _notFound;
    private int _editId;

    private string _name = string.Empty;
    private string _sku = string.Empty;
    private string _category = string.Empty;
    private string _status = "Active";
    private decimal _price;
    private int _stock;
    private string _imageUrl = string.Empty;
    private string _description = string.Empty;
    private string _colors = string.Empty;
    private bool _hasSizeVariants;
    private List<ProductVariant> _variants = [];
    private int _sold;
    private readonly Dictionary<string, string> _errors = new(StringComparer.Ordinal);

    private IEnumerable<string> FormCategoryNames =>
        CategoryService.All
            .Where(c => c.IsActive)
            .Select(c => c.Name)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized() => CategoryService.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        _errors.Clear();
        _notFound = false;

        if (!IsEdit)
        {
            _editId = 0;
            _name = string.Empty;
            _sku = string.Empty;
            _category = string.Empty;
            _status = "Active";
            _price = 0;
            _stock = 0;
            _sold = 0;
            _imageUrl = string.Empty;
            _description = string.Empty;
            _colors = string.Empty;
            _hasSizeVariants = false;
            _variants = [];
            return;
        }

        var product = ProductService.GetById(Id!.Value);
        if (product is null)
        {
            _notFound = true;
            return;
        }

        _editId = product.Id;
        _name = product.Name;
        _sku = product.Sku;
        _category = product.Category;
        _status = product.Status;
        _price = product.Price;
        _stock = product.Stock;
        _sold = product.Sold;
        _imageUrl = product.ImageUrl;
        _description = product.Description;
        _colors = string.Join(", ", product.Colors);
        _hasSizeVariants = product.HasSizeVariants;
        _variants = product.Variants.Select(v => v.Clone()).ToList();
    }

    private Task OnHasSizeVariantsChanged(bool value)
    {
        _hasSizeVariants = value;
        _errors.Remove(nameof(_stock));
        _errors.Remove("variants");
        return Task.CompletedTask;
    }

    private Task OnVariantsChanged(List<ProductVariant> variants)
    {
        _variants = variants;
        _errors.Remove("variants");
        return Task.CompletedTask;
    }

    private Task OnStockTextChanged(string value)
    {
        if (!int.TryParse(value, out var stock) || stock < 0)
            stock = 0;
        _stock = stock;
        _errors.Remove(nameof(_stock));
        return Task.CompletedTask;
    }

    private async Task OnReplaceImageSelected(InputFileChangeEventArgs e)
    {
        _errors.Remove(nameof(_imageUrl));
        var file = e.File;
        if (file is null) return;

        var contentType = file.ContentType?.ToLowerInvariant() ?? string.Empty;
        var name = file.Name?.ToLowerInvariant() ?? string.Empty;
        var isPng = contentType is "image/png" || name.EndsWith(".png");
        var isJpg = contentType is "image/jpeg" or "image/jpg" ||
                    name.EndsWith(".jpg") || name.EndsWith(".jpeg");

        if (!isPng && !isJpg)
        {
            _errors[nameof(_imageUrl)] = "Image must be PNG or JPG.";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            _errors[nameof(_imageUrl)] = "Image must not exceed 10MB.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            if (bytes.Length == 0) return;

            var mime = isPng ? "image/png" : "image/jpeg";
            _imageUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            _errors[nameof(_imageUrl)] = "Image must not exceed 10MB.";
        }
    }

    private bool Validate()
    {
        _errors.Clear();

        if (string.IsNullOrWhiteSpace(_name))
            _errors[nameof(_name)] = "Product name is required.";
        if (string.IsNullOrWhiteSpace(_sku))
            _errors[nameof(_sku)] = "SKU is required.";
        else if (ProductService.SkuExists(_sku, IsEdit ? _editId : null))
            _errors[nameof(_sku)] = "This SKU already exists.";
        if (string.IsNullOrWhiteSpace(_category))
            _errors[nameof(_category)] = "Category is required.";
        else if (!FormCategoryNames.Any(c => c.Equals(_category, StringComparison.OrdinalIgnoreCase)) &&
                 !CategoryService.All.Any(c => c.Name.Equals(_category, StringComparison.OrdinalIgnoreCase)))
            _errors[nameof(_category)] = "Please select a valid category.";
        if (_price <= 0)
            _errors[nameof(_price)] = "Price must be greater than 0.";

        if (_hasSizeVariants)
        {
            var variantError = ProductSizeVariantEditor.Validate(true, _variants);
            if (variantError is not null)
                _errors["variants"] = variantError;
        }
        else if (_stock < 0)
        {
            _errors[nameof(_stock)] = "Stock must be 0 or greater.";
        }

        return _errors.Count == 0;
    }

    private async Task Save()
    {
        if (!Validate()) return;

        var variants = _hasSizeVariants
            ? _variants.Select(v => v.Clone()).ToList()
            : [];

        var model = new AdminProduct
        {
            Id = _editId,
            Name = _name.Trim(),
            Sku = _sku.Trim().ToUpperInvariant(),
            Category = _category,
            Status = _status,
            Price = _price,
            Stock = _hasSizeVariants ? variants.Sum(v => Math.Max(0, v.StockQuantity)) : _stock,
            Sold = _sold,
            ImageUrl = string.IsNullOrWhiteSpace(_imageUrl) ? MockData.PlaceholderImage : _imageUrl.Trim(),
            Images = string.IsNullOrWhiteSpace(_imageUrl) ? [] : [_imageUrl.Trim()],
            Description = _description.Trim(),
            Colors = SplitList(_colors),
            Sizes = _hasSizeVariants ? variants.Select(v => v.Size).ToList() : [],
            Variants = variants
        };

        if (IsEdit)
        {
            if (!await ProductService.UpdateAsync(model))
            {
                _notFound = true;
                return;
            }

            Toast.Show("Product updated successfully.");
        }
        else
        {
            await ProductService.AddAsync(model);
            Toast.Show("Product added successfully.");
        }

        Navigation.NavigateTo("/admin/products");
    }

    private static List<string> SplitList(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    public void Dispose() => CategoryService.OnChange -= Refresh;
}
