@page "/admin/change-password"
@layout AdminLayout
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Change Password | Admin | NU Bulldogs Exchange</PageTitle>

<div class="admin-force-password">
    <div class="admin-force-password-card">
        <h1>Change Your Password</h1>
        <p>For security, you need to create a new password before continuing.</p>

        <form class="admin-force-password-form" @onsubmit="Submit" @onsubmit:preventDefault="true">
            <label class="admin-field">
                <span>New Password <em class="admin-req">*</em></span>
                <div class="admin-password-wrap">
                    <input type="@(_showPassword ? "text" : "password")"
                           @bind="_newPassword"
                           @bind:event="oninput"
                           autocomplete="new-password"
                           disabled="@_saving" />
                    <button type="button"
                            class="admin-password-toggle"
                            aria-label="@(_showPassword ? "Hide password" : "Show password")"
                            @onclick="() => _showPassword = !_showPassword">
                        <Icon Name="@(_showPassword ? "eye-off" : "eye")" Size="16" />
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_passwordError))
                {
                    <span class="admin-field-error">@_passwordError</span>
                }
            </label>

            <label class="admin-field">
                <span>Confirm New Password <em class="admin-req">*</em></span>
                <div class="admin-password-wrap">
                    <input type="@(_showConfirm ? "text" : "password")"
                           @bind="_confirmPassword"
                           @bind:event="oninput"
                           autocomplete="new-password"
                           disabled="@_saving" />
                    <button type="button"
                            class="admin-password-toggle"
                            aria-label="@(_showConfirm ? "Hide password" : "Show password")"
                            @onclick="() => _showConfirm = !_showConfirm">
                        <Icon Name="@(_showConfirm ? "eye-off" : "eye")" Size="16" />
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_confirmError))
                {
                    <span class="admin-field-error">@_confirmError</span>
                }
            </label>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <p class="admin-staff-error">@_formError</p>
            }

            <button type="submit" class="btn btn-navy" disabled="@_saving">
                @(_saving ? "Updating..." : "Update Password")
            </button>
        </form>
    </div>
</div>

@code {
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private string? _confirmError;
    private string? _formError;
    private bool _showPassword;
    private bool _showConfirm;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn || !Auth.CanAccessAdmin)
        {
            Navigation.NavigateTo("/login?returnUrl=%2Fadmin%2Fdashboard");
            return;
        }

        if (!Auth.MustChangePassword)
            Navigation.NavigateTo("/admin/dashboard");
    }

    private async Task Submit()
    {
        _passwordError = null;
        _confirmError = null;
        _formError = null;

        var ok = true;
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < AuthValidation.MinPasswordLength)
        {
            _passwordError = $"Password must contain at least {AuthValidation.MinPasswordLength} characters.";
            ok = false;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _confirmError = "Passwords do not match.";
            ok = false;
        }

        if (!ok) return;

        _saving = true;
        try
        {
            var result = await Auth.CompleteForcedPasswordChangeAsync(new ForcedPasswordChangeRequest
            {
                NewPassword = _newPassword,
                ConfirmNewPassword = _confirmPassword
            });

            if (!result.Success)
            {
                _formError = result.Error ?? "Unable to update your password.";
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
                return;
            }

            await Auth.PersistAsync(JS);
            Toast.Show("Password updated successfully.");
            Navigation.NavigateTo("/admin/dashboard");
        }
        finally
        {
            _saving = false;
        }
    }
}
