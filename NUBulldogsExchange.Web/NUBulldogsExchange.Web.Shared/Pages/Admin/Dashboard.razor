@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Layout

<PageTitle>Admin Dashboard | NU Bulldogs Exchange</PageTitle>

<div class="admin-dashboard">
    <header class="admin-page-intro">
        <h1>Store Overview</h1>
        <p>Welcome back — here's what's happening in your store.</p>
    </header>

    <div class="admin-stat-grid">
        @foreach (var stat in MockAdminData.Stats)
        {
            <article class="admin-stat-card">
                <div class="admin-stat-top">
                    <div class="admin-stat-icon tone-@stat.Tone" aria-hidden="true">
                        <Icon Name="@stat.Icon" Size="16" />
                    </div>
                    <span class="admin-stat-change @(stat.IsPositive ? "up" : "down")">
                        <Icon Name="@(stat.IsPositive ? "trending-up" : "trending-down")" Size="12" />
                        @stat.Change
                    </span>
                </div>
                <strong>@stat.Value</strong>
                <span>@stat.Label</span>
            </article>
        }
    </div>

    <div class="admin-mid-grid">
        <section class="admin-card admin-sales-card">
            <div class="admin-card-head">
                <div>
                    <h2>Sales Analytics</h2>
                    <p>Revenue and orders over time</p>
                </div>
                <div class="admin-range-tabs" role="tablist" aria-label="Sales range">
                    @foreach (var range in _ranges)
                    {
                        <button type="button"
                                role="tab"
                                class="admin-range-tab @(_activeRange == range ? "active" : "")"
                                @onclick="() => _activeRange = range">
                            @range
                        </button>
                    }
                </div>
            </div>
            <div class="admin-line-chart" aria-label="Sales line chart">
                <div class="admin-line-y">
                    <span>₱140K</span>
                    <span>₱105K</span>
                    <span>₱70K</span>
                    <span>₱35K</span>
                    <span>₱0K</span>
                </div>
                <div class="admin-line-plot">
                    <svg viewBox="0 0 400 180" preserveAspectRatio="none" class="admin-line-svg">
                        <defs>
                            <linearGradient id="salesFill" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#123A63" stop-opacity="0.22" />
                                <stop offset="100%" stop-color="#123A63" stop-opacity="0.02" />
                            </linearGradient>
                        </defs>
                        @for (var i = 0; i < 5; i++)
                        {
                            var y = 10 + i * 40;
                            <line x1="0" y1="@y" x2="400" y2="@y" class="admin-grid-line" />
                        }
                        <path d="@AreaPath" fill="url(#salesFill)" />
                        <path d="@LinePath" class="admin-line-path" fill="none" />
                        @foreach (var point in ChartPoints)
                        {
                            <circle cx="@point.X.ToString("0.##")" cy="@point.Y.ToString("0.##")" r="3.5" class="admin-line-dot" />
                        }
                    </svg>
                    <div class="admin-line-x">
                        @foreach (var month in MockAdminData.SalesMonths)
                        {
                            <span>@month</span>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="admin-card admin-status-card">
            <div class="admin-card-head">
                <div>
                    <h2>Order Status</h2>
                    <p>Distribution of order states</p>
                </div>
            </div>
            <div class="admin-donut-wrap">
                <div class="admin-donut" style="background: @DonutGradient;" aria-hidden="true">
                    <div class="admin-donut-hole"></div>
                </div>
            </div>
            <ul class="admin-status-legend">
                @foreach (var slice in MockAdminData.OrderStatus)
                {
                    <li>
                        <span class="admin-legend-dot" style="background: @slice.Color;"></span>
                        <span class="admin-legend-label">@slice.Label</span>
                        <strong>@slice.Count</strong>
                    </li>
                }
            </ul>
        </section>
    </div>

    <div class="admin-bottom-grid">
        <section class="admin-card admin-orders-card">
            <div class="admin-card-head">
                <div>
                    <h2>Recent Orders</h2>
                    <p>Latest transactions</p>
                </div>
                <a href="/admin/orders" class="admin-view-all">
                    View All
                    <Icon Name="arrow-right" Size="14" />
                </a>
            </div>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in MockAdminData.RecentOrders)
                        {
                            <tr>
                                <td><strong>@order.Id</strong></td>
                                <td>
                                    <div class="admin-customer-cell">
                                        <strong>@order.Customer</strong>
                                        <span>@order.Fulfillment</span>
                                    </div>
                                </td>
                                <td>@order.Date</td>
                                <td><strong>₱@order.Total.ToString("N0")</strong></td>
                                <td>
                                    <span class="order-status status-@MockAdminData.StatusKey(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="admin-row-action" title="Actions" aria-label="Order actions">
                                        <Icon Name="more-horizontal" Size="16" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="admin-card admin-topselling-card">
            <div class="admin-card-head">
                <div>
                    <h2>Top Selling</h2>
                </div>
                <a href="/admin/products" class="admin-view-all">View All</a>
            </div>

            <div class="admin-top-list">
                @foreach (var product in _topProducts)
                {
                    <article class="admin-top-item">
                        <span class="admin-top-rank">@product.Rank</span>
                        <img src="@product.ImageUrl"
                             alt="@product.Name"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                        <div class="admin-top-meta">
                            <strong>@product.Name</strong>
                            <span>@product.Sold.ToString("N0") sold</span>
                        </div>
                        <strong class="admin-top-revenue">₱@product.Revenue.ToString("N0")</strong>
                    </article>
                }
            </div>

            <div class="admin-revenue-block">
                <h3>Revenue by Product</h3>
                <div class="admin-bar-chart" aria-label="Revenue by product">
                    @{
                        var maxRevenue = _topProducts.Max(p => p.Revenue);
                    }
                    @foreach (var product in _topProducts)
                    {
                        var height = maxRevenue <= 0 ? 0 : (double)(product.Revenue / maxRevenue) * 100;
                        <div class="admin-bar-col">
                            <div class="admin-bar" style="height: @height.ToString("0.##")%;"></div>
                            <span>@product.ShortLabel</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private readonly string[] _ranges = ["Today", "7 Days", "30 Days", "This Year", "Custom"];
    private string _activeRange = "30 Days";
    private readonly List<AdminTopProduct> _topProducts = MockAdminData.TopSelling();

    private IEnumerable<(double X, double Y)> ChartPoints
    {
        get
        {
            var values = MockAdminData.SalesByMonth;
            var max = 140.0;
            var count = values.Length;
            for (var i = 0; i < count; i++)
            {
                var x = count == 1 ? 200 : (i / (double)(count - 1)) * 400;
                var y = 170 - (values[i] / max) * 160;
                yield return (x, y);
            }
        }
    }

    private string LinePath
    {
        get
        {
            var points = ChartPoints.ToList();
            if (points.Count == 0) return string.Empty;
            var parts = new List<string> { $"M {points[0].X:0.##} {points[0].Y:0.##}" };
            for (var i = 1; i < points.Count; i++)
                parts.Add($"L {points[i].X:0.##} {points[i].Y:0.##}");
            return string.Join(" ", parts);
        }
    }

    private string AreaPath
    {
        get
        {
            var points = ChartPoints.ToList();
            if (points.Count == 0) return string.Empty;
            var parts = new List<string> { $"M {points[0].X:0.##} 170" };
            parts.Add($"L {points[0].X:0.##} {points[0].Y:0.##}");
            for (var i = 1; i < points.Count; i++)
                parts.Add($"L {points[i].X:0.##} {points[i].Y:0.##}");
            parts.Add($"L {points[^1].X:0.##} 170 Z");
            return string.Join(" ", parts);
        }
    }

    private string DonutGradient
    {
        get
        {
            var total = MockAdminData.OrderStatus.Sum(s => s.Count);
            if (total <= 0) return "#E2E8F0";

            var stops = new List<string>();
            double cursor = 0;
            foreach (var slice in MockAdminData.OrderStatus)
            {
                var pct = slice.Count * 100.0 / total;
                var next = cursor + pct;
                stops.Add($"{slice.Color} {cursor:0.##}% {next:0.##}%");
                cursor = next;
            }
            return $"conic-gradient({string.Join(", ", stops)})";
        }
    }
}
