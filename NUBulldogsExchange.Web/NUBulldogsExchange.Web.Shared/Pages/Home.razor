@page "/"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Components.Mobile
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject IFormFactor FormFactor
@inject ProductCatalogService Catalog
@inject AdminCategoryService Categories
@inject AdminProductService Products
@implements IDisposable

<PageTitle>NU Bulldogs Exchange | Official Merchandise</PageTitle>

@if (FormFactor.IsMobile)
{
    <MobileHomeView />
}
else
{
    @if (_loading)
    {
        <section class="section section-light">
            <div class="container">
                <p>Loading catalog…</p>
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="section section-light">
            <div class="container">
                <p class="text-danger">@_error</p>
            </div>
        </section>
    }
    else
    {
        <HeroSection />

        <section class="section section-light" id="categories">
            <div class="container">
                <SectionHeader Title="Shop by Category"
                               Subtitle="Find exactly what you're looking for"
                               ViewAllHref="/shop" />
                @if (!Catalog.Categories.Any())
                {
                    <div class="empty-state">
                        <p>No categories available.</p>
                    </div>
                }
                else
                {
                    <div class="category-grid">
                        @foreach (var category in Catalog.Categories)
                        {
                            <CategoryCard Category="category" />
                        }
                    </div>
                }
            </div>
        </section>

        <section class="section section-light" id="products">
            <div class="container">
                <SectionHeader Title="Featured Bulldogs Picks"
                               Subtitle="Handpicked favorites for every Bulldog"
                               ViewAllHref="/shop" />
                <ProductGrid Products="Catalog.Featured" />
            </div>
        </section>

        <section class="section section-light" id="fresh">
            <div class="container">
                <SectionHeader Label="JUST DROPPED"
                               Title="Fresh Drops"
                               Subtitle="New merchandise just landed."
                               ViewAllHref="/new-arrivals" />
                <ProductGrid Products="Catalog.FreshDrops" />
            </div>
        </section>

        <section class="section section-light" id="favorites">
            <div class="container">
                <SectionHeader Label="TOP PICKS"
                               Title="Bulldog Favorites"
                               Subtitle="What the community loves most"
                               ViewAllHref="/best-sellers" />
                <ProductGrid Products="Catalog.Favorites" ShowRank="true" />
            </div>
        </section>

        <WhyShopSection />
        <NewsletterSection />
    }
}

@code {
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Catalog.OnChange += Refresh;
        try
        {
            await Categories.EnsureLoadedAsync();
            await Products.EnsureLoadedAsync();
            await Catalog.EnsureLoadedAsync();
        }
        catch (Exception ex)
        {
            _error = "Unable to load catalog. Please try again later.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Catalog.OnChange -= Refresh;
}
