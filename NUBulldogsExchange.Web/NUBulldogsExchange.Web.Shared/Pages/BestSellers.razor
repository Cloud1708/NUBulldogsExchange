@page "/best-sellers"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data

<PageTitle>Best Sellers | NU Bulldogs Exchange</PageTitle>

<ProductListingPage Title="Best Sellers"
                    Breadcrumb="_breadcrumb"
                    BaseProducts="MockData.BestSellers"
                    DefaultSort="best-selling"
                    RadioGroupPrefix="best-sellers" />

@code {
    private readonly List<BreadcrumbItem> _breadcrumb =
    [
        new("Home", "/"),
        new("Shop", "/shop"),
        new("Best Sellers")
    ];
}
