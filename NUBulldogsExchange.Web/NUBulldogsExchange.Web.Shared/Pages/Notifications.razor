@page "/notifications"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Services
@inject AuthService Auth
@inject NotificationService NotificationService
@implements IDisposable

<PageTitle>Notifications | NU Bulldogs Exchange</PageTitle>

@if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
{
    <section class="wishlist-guest-section">
        <div class="container">
            <div class="wishlist-guest">
                <div class="wishlist-guest-icon" aria-hidden="true">
                    <Icon Name="bell" Size="34" />
                </div>
                <h1>Sign in to view your account</h1>
                <p>Track orders, manage your wishlist, and more.</p>
                <a href="/login?returnUrl=%2Fnotifications" class="btn btn-navy wishlist-signin-btn">Sign In</a>
            </div>
        </div>
    </section>
}
else
{
    <AccountShell Active="notifications">
        <div class="account-panel account-notifications-panel">
            <div class="account-panel-head">
                <h1>Notifications</h1>
                <button type="button"
                        class="account-mark-read"
                        disabled="@(NotificationService.UnreadCount == 0)"
                        @onclick="NotificationService.MarkAllAsRead">
                    Mark All as Read
                </button>
            </div>

            @{
                var all = NotificationService.Items.ToList();
                var totalPages = Math.Max(1, (int)Math.Ceiling(all.Count / (double)_pageSize));
                if (_currentPage > totalPages) _currentPage = totalPages;
                if (_currentPage < 1) _currentPage = 1;
                var pageItems = all.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
                var rangeStart = all.Count == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
                var rangeEnd = Math.Min(_currentPage * _pageSize, all.Count);
            }

            @if (all.Count == 0)
            {
                <div class="wishlist-empty">
                    <div class="wishlist-empty-icon" aria-hidden="true">
                        <Icon Name="bell" Size="42" />
                    </div>
                    <h2>No notifications yet</h2>
                    <p>Updates about your orders will appear here.</p>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var note in pageItems)
                    {
                        var href = string.IsNullOrWhiteSpace(note.RelatedHref) ? "/orders" : note.RelatedHref;
                        <a href="@href" class="notification-card @(note.IsRead ? "is-read" : "is-unread")">
                            <div class="notification-icon tone-@note.Tone" aria-hidden="true">
                                <Icon Name="@note.Icon" Size="18" />
                            </div>
                            <div class="notification-body">
                                <strong>@note.Title</strong>
                                <p>@note.Message</p>
                                <span>@note.TimeAgo</span>
                            </div>
                            @if (!note.IsRead)
                            {
                                <span class="notification-dot" aria-label="Unread"></span>
                            }
                        </a>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <div class="shop-pager" role="navigation" aria-label="Notification pages">
                        <label class="shop-pager-size">
                            <span>Page size:</span>
                            <select value="@_pageSize" @onchange="OnPageSizeChanged" aria-label="Notifications per page">
                                @foreach (var size in PageSizes)
                                {
                                    <option value="@size">@size</option>
                                }
                            </select>
                        </label>

                        <span class="shop-pager-range">@rangeStart to @rangeEnd of @all.Count</span>

                        <div class="shop-pager-nav">
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(_currentPage <= 1)"
                                    title="First page"
                                    aria-label="First page"
                                    @onclick="() => GoToPage(1, totalPages)">«</button>
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(_currentPage <= 1)"
                                    title="Previous page"
                                    aria-label="Previous page"
                                    @onclick="() => GoToPage(_currentPage - 1, totalPages)">‹</button>
                            <span class="shop-pager-status">
                                Page <strong>@_currentPage</strong> of @totalPages
                            </span>
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(_currentPage >= totalPages)"
                                    title="Next page"
                                    aria-label="Next page"
                                    @onclick="() => GoToPage(_currentPage + 1, totalPages)">›</button>
                            <button type="button"
                                    class="shop-pager-btn"
                                    disabled="@(_currentPage >= totalPages)"
                                    title="Last page"
                                    aria-label="Last page"
                                    @onclick="() => GoToPage(totalPages, totalPages)">»</button>
                        </div>
                    </div>
                }
            }
        </div>
    </AccountShell>
}

@code {
    private static readonly int[] PageSizes = [5, 8, 12, 24];

    private int _pageSize = 5;
    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += OnAuthChanged;
        NotificationService.OnChange += Refresh;
        if (Auth.IsLoggedIn)
            await NotificationService.EnsureLoadedAsync(Auth.Email);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var size) && PageSizes.Contains(size)
            ? size
            : 5;
        _currentPage = 1;
    }

    private void GoToPage(int page, int totalPages) =>
        _currentPage = Math.Clamp(page, 1, totalPages);

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        _currentPage = 1;
        if (Auth.IsLoggedIn)
            await NotificationService.EnsureLoadedAsync(Auth.Email);
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChanged;
        NotificationService.OnChange -= Refresh;
    }
}
