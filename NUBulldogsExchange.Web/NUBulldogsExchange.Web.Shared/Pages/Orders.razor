@page "/orders"
@page "/my-orders"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Components.Mobile
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject IFormFactor FormFactor
@inject AuthService Auth
@inject OrderService OrderService
@inject ToastService Toast
@implements IDisposable

<PageTitle>My Orders | NU Bulldogs Exchange</PageTitle>

@if (FormFactor.IsMobile)
{
    <MobileOrdersView />
}
else
{
    @if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
    {
        <section class="wishlist-guest-section">
            <div class="container">
                <div class="wishlist-guest">
                    <div class="wishlist-guest-icon" aria-hidden="true">
                        <Icon Name="package" Size="34" />
                    </div>
                    <h1>Sign in to view your orders</h1>
                    <p>Track campus pickup and past purchases from your account.</p>
                    <a href="/login?returnUrl=%2Forders" class="btn btn-navy wishlist-signin-btn">Sign In</a>
                </div>
            </div>
        </section>
    }
    else
    {
        <AccountShell Active="orders">
            <div class="account-panel account-orders-panel">
                <h1>My Orders</h1>

                <div class="order-filter-tabs" role="tablist" aria-label="Filter orders">
                    @foreach (var filter in OrderFlow.CustomerTabs)
                    {
                        <button type="button"
                                role="tab"
                                class="order-filter-tab @(_filter == filter ? "active" : "")"
                                aria-selected="@(_filter == filter)"
                                @onclick="() => _filter = filter">
                            @filter
                        </button>
                    }
                </div>

                @{
                    var visible = OrderService.Filter(_filter).ToList();
                }

                @if (!visible.Any())
                {
                    <div class="wishlist-empty">
                        <div class="wishlist-empty-icon" aria-hidden="true">
                            <Icon Name="package" Size="42" />
                        </div>
                        <h2>No orders found</h2>
                        <p>There are no orders in this filter.</p>
                    </div>
                }
                else
                {
                    <div class="order-card-list">
                        @foreach (var order in visible)
                        {
                            <article class="order-card">
                                <div class="order-card-top">
                                    <div>
                                        <strong>@order.Id</strong>
                                        <span>@order.FormattedDate • @order.ItemCountLabel</span>
                                    </div>
                                    <span class="order-status status-@order.CustomerStatusKey">@order.CustomerCategory</span>
                                </div>

                                <div class="order-card-fulfillment @(order.IsDelivery ? "is-delivery" : "is-pickup")">
                                    <span class="order-fulfillment-badge">
                                        @(order.IsDelivery ? "🚚 Delivery" : "📍 Campus Pickup")
                                    </span>
                                    <span class="order-fulfillment-location">
                                        @(string.IsNullOrWhiteSpace(order.FulfillmentLocationLabel)
                                            ? (order.IsDelivery ? "Delivery address on file" : OrderFlow.PickupLocation)
                                            : order.FulfillmentLocationLabel)
                                    </span>
                                </div>

                                <div class="order-card-payment">
                                    <span>Payment: @(string.IsNullOrWhiteSpace(order.PaymentMethod) ? "—" : order.PaymentMethod)</span>
                                    <span>Payment Status: @order.PaymentStatus</span>
                                </div>

                                <div class="order-card-items">
                                    @foreach (var item in order.Items)
                                    {
                                        <div class="order-card-item">
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                                            <div class="order-card-item-copy">
                                                <span class="order-card-item-name">@item.Name</span>
                                                @if (item.HasDisplayColor)
                                                {
                                                    <span class="order-card-item-size">Color: @item.Color</span>
                                                }
                                                @if (item.HasDisplaySize)
                                                {
                                                    <span class="order-card-item-size">Size: @item.Size</span>
                                                }
                                            </div>
                                            <span class="order-card-item-qty">Qty: @item.Quantity</span>
                                        </div>
                                    }
                                </div>

                                <div class="order-card-footer">
                                    <strong>₱@order.Total.ToString("N0")</strong>
                                    <div class="order-card-actions">
                                        @if (order.CanConfirmReceived)
                                        {
                                            <button type="button"
                                                    class="btn btn-navy btn-order-received"
                                                    @onclick="() => AskReceived(order)">
                                                Order Received
                                            </button>
                                        }
                                        @if (OrderService.CanCancel(order))
                                        {
                                            <button type="button" class="btn btn-cancel-order" @onclick="() => Cancel(order.Id)">
                                                Cancel Order
                                            </button>
                                        }
                                        @if (order.CanWriteReview && order.Items.Count > 0)
                                        {
                                            @if (order.HasUnreviewedItems)
                                            {
                                                <button type="button"
                                                        class="btn btn-navy btn-write-review"
                                                        @onclick="() => OpenReview(order)">
                                                    Write Review
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-reviewed" disabled>
                                                    ✓ Reviewed
                                                </button>
                                            }
                                        }
                                        <button type="button" class="btn btn-navy btn-view-order" @onclick="() => ViewOrder(order)">
                                            View Order
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </AccountShell>

        <CustomerOrderDetailsModal Order="_selectedOrder"
                                   OnClose="CloseDetails"
                                   OnRequestReceived="AskReceived"
                                   OnWriteReview="OpenReviewFromDetails" />
        <ConfirmOrderReceivedModal Order="_pendingReceived"
                                   Saving="_savingReceived"
                                   OnCancel="CloseReceivedConfirm"
                                   OnConfirm="ConfirmReceived" />
        <WriteReviewModal Order="_reviewOrder"
                          SelectedItem="_reviewItem"
                          OnClose="CloseReview"
                          OnSubmitted="OnReviewSubmitted" />
    }
}

@code {
    [SupplyParameterFromQuery(Name = "order")]
    public string? RequestedOrderId { get; set; }

    private string _filter = "All";
    private string? _openedRequestedOrderId;
    private MockOrder? _selectedOrder;
    private MockOrder? _pendingReceived;
    private MockOrder? _reviewOrder;
    private MockOrderItem? _reviewItem;
    private bool _savingReceived;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += OnAuthChanged;
        OrderService.OnChange += Refresh;
        await OrderService.EnsureLoadedAsync(Auth.Email);
        OpenRequestedOrder();
    }

    protected override void OnParametersSet() => OpenRequestedOrder();

    private void OpenRequestedOrder()
    {
        if (string.IsNullOrWhiteSpace(RequestedOrderId)
            || string.Equals(_openedRequestedOrderId, RequestedOrderId, StringComparison.OrdinalIgnoreCase))
            return;

        var match = OrderService.Orders.FirstOrDefault(o =>
            o.Id.Equals(RequestedOrderId.Trim(), StringComparison.OrdinalIgnoreCase));
        if (match is null)
            return;

        _openedRequestedOrderId = RequestedOrderId;
        _selectedOrder = match;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        await OrderService.EnsureLoadedAsync(Auth.Email);
        OpenRequestedOrder();
        StateHasChanged();
    });

    private void ViewOrder(MockOrder order) => _selectedOrder = order;

    private void CloseDetails() => _selectedOrder = null;

    private void OpenReview(MockOrder order, MockOrderItem? item = null)
    {
        if (!order.CanWriteReview)
            return;
        _reviewOrder = order;
        _reviewItem = item;
    }

    private void OpenReviewFromDetails(MockOrderItem item)
    {
        if (_selectedOrder is null)
            return;
        OpenReview(_selectedOrder, item);
    }

    private void CloseReview()
    {
        _reviewOrder = null;
        _reviewItem = null;
    }

    private void OnReviewSubmitted()
    {
        if (_selectedOrder is not null)
        {
            _selectedOrder = OrderService.Orders.FirstOrDefault(o => o.Id == _selectedOrder.Id)
                ?? _selectedOrder;
        }

        if (_reviewOrder is not null)
        {
            _reviewOrder = OrderService.Orders.FirstOrDefault(o => o.Id == _reviewOrder.Id)
                ?? _reviewOrder;
        }
    }

    private void AskReceived(MockOrder order)
    {
        if (!order.CanConfirmReceived)
            return;
        _pendingReceived = order;
    }

    private void CloseReceivedConfirm()
    {
        if (_savingReceived) return;
        _pendingReceived = null;
    }

    private async Task ConfirmReceived()
    {
        if (_pendingReceived is null || _savingReceived)
            return;

        _savingReceived = true;
        try
        {
            var updated = await OrderService.ConfirmReceivedAsync(_pendingReceived.Id);
            _pendingReceived = null;
            if (_selectedOrder?.Id.Equals(updated.Id, StringComparison.OrdinalIgnoreCase) == true)
                _selectedOrder = updated;
            if (_filter == OrderFlow.ToReceive)
                _filter = OrderFlow.Completed;
            Toast.Show("Order marked as received.");
        }
        catch (Exception ex)
        {
            Toast.Show(string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to confirm this order."
                : ex.Message);
        }
        finally
        {
            _savingReceived = false;
        }
    }

    private void Cancel(string orderId)
    {
        var cancelled = OrderService.Cancel(orderId);
        if (_selectedOrder?.Id == orderId)
            _selectedOrder = OrderService.Orders.FirstOrDefault(o => o.Id == orderId);
        Toast.Show(cancelled ? $"Order {orderId} cancelled." : "This order can no longer be cancelled.");
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChanged;
        OrderService.OnChange -= Refresh;
    }
}
