@page "/wishlist"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject WishlistService WishlistService
@inject AuthService Auth
@inject ProductCatalogService Catalog
@inject AdminProductService AdminProducts
@implements IDisposable

<PageTitle>Wishlist | NU Bulldogs Exchange</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <section class="wishlist-guest-section">
        <div class="container">
            <div class="wishlist-guest">
                <div class="wishlist-guest-icon" aria-hidden="true">
                    <Icon Name="user-round" Size="34" />
                </div>
                <h1>Sign in to view your account</h1>
                <p>Track orders, manage your wishlist, and more.</p>
                <a href="/login?returnUrl=%2Fwishlist&redirect=%2Fwishlist" class="btn btn-navy wishlist-signin-btn">Sign In</a>
            </div>
        </div>
    </section>
}
else
{
    <AccountShell Active="wishlist">
        <div class="wishlist-panel">
            <h1>My Wishlist (@ItemCountLabel)</h1>

            @if (!_products.Any())
            {
                <div class="wishlist-empty">
                    <div class="wishlist-empty-icon" aria-hidden="true">
                        <Icon Name="heart" Size="42" />
                    </div>
                    <h2>Your wishlist is empty</h2>
                    <p>Save items you love to your wishlist.</p>
                    <a href="/shop" class="btn btn-navy wishlist-browse-btn">Browse Products</a>
                </div>
            }
            else
            {
                <div class="wishlist-product-grid">
                    <ProductGrid Products="_products" />
                </div>
            }
        </div>
    </AccountShell>
}

@code {
    private IEnumerable<Product> _products = [];

    private string ItemCountLabel =>
        WishlistService.Count == 1 ? "1 item" : $"{WishlistService.Count} items";

    protected override async Task OnInitializedAsync()
    {
        WishlistService.OnChange += Refresh;
        Auth.OnChange += Refresh;
        await AdminProducts.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
        Load();
    }

    private void Load() =>
        _products = Catalog.Products.Where(p => WishlistService.Contains(p.Id)).ToList();

    private void Refresh()
    {
        Load();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WishlistService.OnChange -= Refresh;
        Auth.OnChange -= Refresh;
    }
}
