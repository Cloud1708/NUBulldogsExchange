@page "/product/{Id:int}"
@using System.Globalization
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject CartService Cart
@inject WishlistService Wishlist
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ProductCatalogService Catalog
@inject AdminProductService AdminProducts
@inject IAppDatabase Db
@implements IDisposable

<PageTitle>@(_product?.Name ?? "Product") | NU Bulldogs Exchange</PageTitle>

@if (_product is null)
{
    <section class="section section-light">
        <div class="container empty-state">
            <h2>Product not found</h2>
            <a href="/shop" class="btn btn-navy">Back to Shop</a>
        </div>
    </section>
}
else
{
    <section class="section section-light pdp-page">
        <div class="container">
            <nav class="shop-breadcrumb pdp-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <Icon Name="chevron-right" Size="14" CssClass="breadcrumb-sep" />
                <a href="/shop">Shop</a>
                <Icon Name="chevron-right" Size="14" CssClass="breadcrumb-sep" />
                <a href="@CategoryHref">@_product.Category</a>
                <Icon Name="chevron-right" Size="14" CssClass="breadcrumb-sep" />
                <span>@_product.Name</span>
            </nav>

            <div class="product-detail">
                <div class="product-detail-gallery">
                    <div class="pdp-main-image">
                        <img src="@_selectedImage"
                             alt="@_product.Name"
                             onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                    </div>
                    <div class="pdp-thumbs" role="list">
                        @for (var i = 0; i < _gallery.Count; i++)
                        {
                            var index = i;
                            var src = _gallery[index];
                            <button type="button"
                                    class="pdp-thumb @(src == _selectedImage ? "active" : "")"
                                    role="listitem"
                                    aria-label="@($"View image {index + 1}")"
                                    @onclick="() => SelectImage(src)">
                                <img src="@src"
                                     alt="@($"{_product.Name} thumbnail {index + 1}")"
                                     onerror="this.onerror=null;this.src='@MockData.PlaceholderImage';" />
                            </button>
                        }
                    </div>
                </div>

                <div class="product-detail-info">
                    <div class="pdp-info-top">
                        <p class="pdp-stock @_stockClass">
                            @if (_product.Stock <= 0)
                            {
                                <span>Out of Stock</span>
                            }
                            else if (_product.Stock <= 10)
                            {
                                <span>Only @_product.Stock left</span>
                            }
                            else
                            {
                                <span class="pdp-stock-ok"><Icon Name="check" Size="14" /> In Stock (@_product.Stock left)</span>
                            }
                        </p>
                        <button type="button"
                                class="pdp-wishlist favorite @(Auth.IsLoggedIn && Wishlist.Contains(_product.Id) ? "active" : "")"
                                title="Wishlist"
                                @onclick="ToggleWishlist">
                            <Icon Name="heart" Size="18" />
                        </button>
                    </div>

                    <h1 class="pdp-title">@_product.Name</h1>

                    <div class="rating detail-rating pdp-rating">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <span class="star @(i <= Math.Round(_product.Rating) ? "filled" : "")">★</span>
                        }
                        <strong class="pdp-rating-value">@_product.Rating.ToString("0.0")</strong>
                        <span class="pdp-rating-meta">(@_product.Reviews reviews) · @_product.Sold sold</span>
                    </div>

                    <div class="detail-price pdp-price">
                        @if (_product.OriginalPrice is decimal original)
                        {
                            <s>₱@original.ToString("N0")</s>
                            <strong>₱@_product.Price.ToString("N0")</strong>
                        }
                        else
                        {
                            <strong>₱@_product.Price.ToString("N0")</strong>
                        }
                    </div>

                    <p class="detail-desc">@_product.Description</p>

                    @if (HasColors)
                    {
                        <div class="pdp-option">
                            <div class="pdp-option-head">
                                <span>Select Color</span>
                                @if (!string.IsNullOrWhiteSpace(_selectedColor))
                                {
                                    <small>@MockData.FormatColorName(_selectedColor)</small>
                                }
                            </div>
                            <div class="pdp-swatch-list">
                                @foreach (var color in VisibleColors)
                                {
                                    var soldOut = ProductVariantLogic.ColorIsSoldOut(_product.Variants, color);
                                    var hex = ProductVariantLogic.ColorHex(_product.Variants, color);
                                    <button type="button"
                                            class="pdp-swatch-option @(_selectedColor == color ? "selected" : "") @(soldOut ? "is-sold-out" : "")"
                                            disabled="@soldOut"
                                            title="@(soldOut ? $"{color} — Sold Out" : color)"
                                            aria-label="@color"
                                            @onclick="() => SelectColor(color)">
                                        <span class="pdp-swatch pdp-swatch-hex @(IsLightHex(hex) ? "is-light" : "")"
                                              style="background:@hex"></span>
                                        <small>@color</small>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (HasSizes)
                    {
                        <div class="pdp-option">
                            <div class="pdp-option-head">
                                <span>Select Size</span>
                                <button type="button" class="pdp-size-guide-link" @onclick="() => _showSizeGuide = true">Size Guide</button>
                            </div>
                            <div class="pdp-sizes">
                                @foreach (var variant in VisibleSizeVariants)
                                {
                                    var soldOut = variant.StockQuantity <= 0;
                                    <button type="button"
                                            class="pdp-size @(_selectedVariantId == variant.Id ? "selected" : "") @(soldOut ? "is-sold-out" : "")"
                                            disabled="@soldOut"
                                            title="@(soldOut ? "Sold Out" : variant.Size)"
                                            @onclick="() => SelectVariant(variant)">
                                        @variant.Size
                                        @if (soldOut)
                                        {
                                            <span class="pdp-size-soldout">Sold Out</span>
                                        }
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_sizeError))
                            {
                                <p class="pdp-size-error">@_sizeError</p>
                            }
                        </div>
                    }

                    <div class="pdp-option">
                        <div class="pdp-option-head">
                            <span>Quantity</span>
                        </div>
                        <div class="pdp-qty-row">
                            <div class="qty-controls pdp-qty">
                                <button type="button"
                                        disabled="@(_quantity <= 1 || AvailableStock <= 0)"
                                        @onclick="DecreaseQty"
                                        aria-label="Decrease quantity">
                                    <Icon Name="minus" Size="14" />
                                </button>
                                <span>@_quantity</span>
                                <button type="button"
                                        disabled="@(_quantity >= AvailableStock || AvailableStock <= 0)"
                                        @onclick="IncreaseQty"
                                        aria-label="Increase quantity">
                                    <Icon Name="plus" Size="14" />
                                </button>
                            </div>
                            <span class="pdp-stock-hint">@AvailableStock pieces available</span>
                        </div>
                    </div>

                    <div class="detail-actions pdp-actions">
                        <button type="button"
                                class="btn btn-navy pdp-btn"
                                disabled="@(AvailableStock <= 0)"
                                @onclick="AddToCart">
                            <Icon Name="cart" Size="18" /> Add to Cart
                        </button>
                        <button type="button"
                                class="btn btn-gold pdp-btn"
                                disabled="@(AvailableStock <= 0)"
                                @onclick="BuyNow">
                            <Icon Name="zap" Size="18" /> Buy Now
                        </button>
                    </div>

                    <ul class="detail-perks pdp-perks">
                        <li><Icon Name="map-pin" Size="16" /> Free Campus Pickup available at NU Manila campus</li>
                        <li><Icon Name="clock" Size="16" /> Estimated processing time: 1–3 business days</li>
                        <li><Icon Name="refresh" Size="16" /> Easy returns within 7 days</li>
                    </ul>
                </div>
            </div>

            <div class="pdp-tabs-wrap">
                <div class="pdp-tabs" role="tablist">
                    @foreach (var tab in _tabs)
                    {
                        <button type="button"
                                role="tab"
                                class="pdp-tab @(_activeTab == tab ? "active" : "")"
                                aria-selected="@(_activeTab == tab)"
                                @onclick="() => _activeTab = tab">
                            @tab
                        </button>
                    }
                </div>

                <div class="pdp-tab-panel">
                    @if (_activeTab == "Description")
                    {
                        <div class="pdp-card">
                            <p class="pdp-full-desc">@(!string.IsNullOrWhiteSpace(_product.FullDescription) ? _product.FullDescription : _product.Description)</p>
                            <ul class="pdp-features">
                                @foreach (var feature in _product.Features)
                                {
                                    <li><Icon Name="check-circle" Size="18" /> <span>@feature</span></li>
                                }
                            </ul>
                        </div>
                    }
                    else if (_activeTab == "Specifications")
                    {
                        <div class="pdp-card">
                            <dl class="pdp-specs">
                                <div class="pdp-spec-row">
                                    <dt>Material</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(_product.Material) ? "—" : _product.Material)</dd>
                                </div>
                                @if (HasSizes)
                                {
                                    <div class="pdp-spec-row">
                                        <dt>Available Sizes</dt>
                                        <dd>@string.Join(", ", ProductVariantLogic.DistinctSizes(_product.Variants.Where(v => v.IsActive)))</dd>
                                    </div>
                                }
                                <div class="pdp-spec-row">
                                    <dt>Category</dt>
                                    <dd>@_product.Category</dd>
                                </div>
                                <div class="pdp-spec-row">
                                    <dt>SKU</dt>
                                    <dd>@_product.Sku</dd>
                                </div>
                                @if (HasColors)
                                {
                                    <div class="pdp-spec-row">
                                        <dt>Colors</dt>
                                        <dd>@string.Join(", ", VisibleColors)</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    }
                    else if (_activeTab == "Reviews")
                    {
                        <div class="pdp-card pdp-reviews">
                            <div class="pdp-reviews-summary">
                                <div class="pdp-reviews-score">
                                    <div class="pdp-avg">@_product.Rating.ToString("0.0")</div>
                                    <div class="rating">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <span class="star @(i <= Math.Round(_product.Rating) ? "filled" : "")">★</span>
                                        }
                                    </div>
                                    <p>@_product.Reviews reviews</p>
                                </div>
                                <div class="pdp-rating-bars">
                                    @for (var star = 5; star >= 1; star--)
                                    {
                                        var pct = RatingPercent(star);
                                        <div class="pdp-bar-row">
                                            <span>@star ★</span>
                                            <div class="pdp-bar-track"><div class="pdp-bar-fill" style="width:@pct%"></div></div>
                                            <span>@pct%</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="pdp-review-list">
                                @if (_displayReviews.Count == 0)
                                {
                                    <p class="pdp-reviews-empty">No reviews yet. After your order is completed, you can write a review from My Orders.</p>
                                }
                                @foreach (var review in _displayReviews)
                                {
                                    <article class="pdp-review-card">
                                        <div class="pdp-review-avatar">@review.Initials</div>
                                        <div class="pdp-review-body">
                                            <div class="pdp-review-head">
                                                <strong>@review.PublicAuthor</strong>
                                                <span>@review.Date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                            </div>
                                            <div class="rating">
                                                @for (var i = 1; i <= 5; i++)
                                                {
                                                    <span class="star @(i <= review.Rating ? "filled" : "")">★</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(review.Title))
                                            {
                                                <h4 class="pdp-review-title">@review.Title</h4>
                                            }
                                            <p>@review.Comment</p>
                                            @if (review.Tags.Count > 0)
                                            {
                                                <div class="pdp-review-tags">
                                                    @foreach (var tag in review.Tags)
                                                    {
                                                        <span class="pdp-review-tag">@tag</span>
                                                    }
                                                </div>
                                            }
                                            @if (review.IsVerifiedPurchase)
                                            {
                                                <small class="pdp-review-verified">✓ Verified Purchase</small>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>

                            <p class="pdp-review-hint">
                                Reviews come from verified purchases.
                                <a href="/orders">Write a review from My Orders</a>
                                after pickup is completed or delivery is marked delivered.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="pdp-card pdp-shipping">
                            <div class="pdp-ship-item pdp-ship-pickup">
                                <div class="pdp-ship-icon"><Icon Name="map-pin" Size="22" /></div>
                                <div>
                                    <h3>Campus Pickup</h3>
                                    <p>Available at the NU Manila Merchandise Center (Building A, Ground Floor). Pickup hours: Monday–Friday, 8:00 AM–5:00 PM.</p>
                                </div>
                            </div>
                            <div class="pdp-ship-item">
                                <div class="pdp-ship-icon"><Icon Name="package" Size="22" /></div>
                                <div>
                                    <h3>Delivery</h3>
                                    <p>Metro Manila delivery in 3–5 business days. Provincial delivery in 5–7 business days. Delivery fees calculated at checkout.</p>
                                </div>
                            </div>
                            <div class="pdp-ship-item">
                                <div class="pdp-ship-icon"><Icon Name="refresh" Size="22" /></div>
                                <div>
                                    <h3>Returns &amp; Exchange</h3>
                                    <p>Items can be returned or exchanged within 7 days of receipt. Must be unworn with original tags. Bring your order receipt to the store.</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="section section-light pdp-related">
        <div class="container">
            <SectionHeader Title="You May Also Like"
                           Subtitle="More picks from the same category"
                           ViewAllHref="/shop" />
            <ProductGrid Products="_related" />
        </div>
    </section>

    @if (_showSizeGuide)
    {
        <div class="pdp-modal-backdrop" @onclick="() => _showSizeGuide = false">
            <div class="pdp-modal" @onclick:stopPropagation="true">
                <div class="pdp-modal-head">
                    <h3>Size Guide</h3>
                    <button type="button" class="pdp-modal-close" @onclick="() => _showSizeGuide = false" aria-label="Close">
                        <Icon Name="x" Size="18" />
                    </button>
                </div>
                @if (_product.Section == "apparel")
                {
                    <table class="pdp-size-table">
                        <thead>
                            <tr><th>Size</th><th>Chest (in)</th><th>Length (in)</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>XS</td><td>34–36</td><td>26</td></tr>
                            <tr><td>S</td><td>36–38</td><td>27</td></tr>
                            <tr><td>M</td><td>38–40</td><td>28</td></tr>
                            <tr><td>L</td><td>40–42</td><td>29</td></tr>
                            <tr><td>XL</td><td>42–44</td><td>30</td></tr>
                            <tr><td>XXL</td><td>44–46</td><td>31</td></tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="pdp-modal-note">This item is offered in <strong>One Size</strong> and is designed for a universal fit.</p>
                }
            </div>
        </div>
    }

}

@code {
    [Parameter] public int Id { get; set; }

    private static readonly string[] _tabs = ["Description", "Specifications", "Reviews", "Shipping & Pickup"];

    private Product? _product;
    private List<Product> _related = [];
    private List<string> _gallery = [];
    private List<ProductReview> _displayReviews = [];

    private string _selectedImage = string.Empty;
    private string? _selectedColor;
    private string? _selectedSize;
    private int? _selectedVariantId;
    private string? _sizeError;
    private int _quantity = 1;
    private string _activeTab = "Description";
    private string _stockClass = "in-stock";

    private bool _showSizeGuide;
    private int _loadedProductId;

    private bool HasColors =>
        _product?.Variants.Any(v => v.IsActive && !string.IsNullOrWhiteSpace(v.ColorName)) == true;

    private bool HasSizes =>
        _product?.Variants.Any(v => v.IsActive && !string.IsNullOrWhiteSpace(v.Size)) == true;

    private IEnumerable<string> VisibleColors =>
        _product is null
            ? []
            : ProductVariantLogic.DistinctColors(_product.Variants.Where(v => v.IsActive));

    private IEnumerable<ProductVariant> VisibleSizeVariants
    {
        get
        {
            if (_product is null) return [];
            var rows = _product.Variants.Where(v => v.IsActive && !string.IsNullOrWhiteSpace(v.Size));
            // Color+size products: only show sizes for the selected color.
            // Size-only products: show all size variants.
            if (HasColors && !string.IsNullOrWhiteSpace(_selectedColor))
                rows = rows.Where(v => ProductVariantLogic.SameText(v.ColorName, _selectedColor));
            else if (HasColors)
                rows = [];
            return rows;
        }
    }

    private int AvailableStock
    {
        get
        {
            if (_product is null) return 0;
            if (!_product.HasVariants)
                return Math.Max(0, _product.Stock);

            var exact = ResolveSelectedVariant();
            if (exact is not null)
                return Math.Max(0, exact.StockQuantity);

            if (HasColors && !HasSizes && !string.IsNullOrWhiteSpace(_selectedColor))
                return ProductVariantLogic.Find(_product.Variants, _selectedColor, null)?.StockQuantity ?? 0;

            if (HasColors && HasSizes && !string.IsNullOrWhiteSpace(_selectedColor))
            {
                return _product.Variants
                    .Where(v => v.IsActive && ProductVariantLogic.SameText(v.ColorName, _selectedColor))
                    .Sum(v => Math.Max(0, v.StockQuantity));
            }

            return _product.Variants.Where(v => v.IsActive).Sum(v => Math.Max(0, v.StockQuantity));
        }
    }

    private string CategoryHref =>
        _product is null
            ? "/shop"
            : $"/shop?category={Uri.EscapeDataString(_product.Category)}";

    protected override async Task OnInitializedAsync()
    {
        Wishlist.OnChange += Refresh;
        Auth.OnChange += Refresh;
        await AdminProducts.EnsureLoadedAsync();
        await Catalog.EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        LoadProduct();
        await LoadReviewsAsync();
    }

    private void LoadProduct()
    {
        var next = Catalog.GetById(Id);
        var productChanged = next?.Id != _loadedProductId;
        _product = next;
        if (_product is null)
        {
            _related = [];
            _displayReviews = [];
            _loadedProductId = 0;
            return;
        }

        if (productChanged)
        {
            ResetSelection(_product);
            _related = Catalog.GetRelated(_product).ToList();
            _activeTab = "Description";
            _showSizeGuide = false;
            _loadedProductId = _product.Id;
            UpdateStockClass();
        }

        _displayReviews = [.. _product.ProductReviews];
    }

    private async Task LoadReviewsAsync()
    {
        if (_product is null)
        {
            _displayReviews = [];
            return;
        }

        try
        {
            var reviews = await Db.GetProductReviewsAsync(_product.Id);
            ProductReviewStats.Apply(_product, reviews);
            _displayReviews = [.. reviews];
        }
        catch
        {
            ProductReviewStats.Apply(_product, _product.ProductReviews);
            _displayReviews = [.. _product.ProductReviews];
        }
    }

    private void ResetSelection(Product product)
    {
        _gallery = product.GalleryImages.ToList();
        if (_gallery.Count == 0 && !string.IsNullOrWhiteSpace(product.ImageUrl))
            _gallery = [product.ImageUrl];

        _selectedImage = _gallery.FirstOrDefault() ?? product.ImageUrl;
        _selectedColor = null;
        _selectedVariantId = null;
        _selectedSize = null;
        _sizeError = null;
        _quantity = 1;

        // Pre-select first in-stock color so color+size products show size buttons
        // (sizes are filtered by selected color — without this the size row stays empty).
        var firstColor = ProductVariantLogic
            .DistinctColors(product.Variants.Where(v => v.IsActive))
            .FirstOrDefault(c => !ProductVariantLogic.ColorIsSoldOut(product.Variants, c));

        if (!string.IsNullOrWhiteSpace(firstColor))
            SelectColor(firstColor);

        if (_quantity > AvailableStock || AvailableStock <= 0)
            _quantity = AvailableStock > 0 ? 1 : 0;
    }

    private void UpdateStockClass()
    {
        var stock = AvailableStock;
        if (_product is null || stock <= 0)
            _stockClass = "out-of-stock";
        else if (stock <= 10)
            _stockClass = "low-stock";
        else
            _stockClass = "in-stock";
    }

    private int RatingPercent(int star)
    {
        if (_product?.RatingBreakdown is null || _product.RatingBreakdown.Length < 5)
            return 0;

        var index = 5 - star;
        return Math.Clamp(_product.RatingBreakdown[index], 0, 100);
    }

    private void SelectImage(string src) => _selectedImage = src;

    private void SelectColor(string color)
    {
        if (_product is null || ProductVariantLogic.ColorIsSoldOut(_product.Variants, color))
            return;

        _selectedColor = color;
        _selectedSize = null;
        _selectedVariantId = null;
        _sizeError = null;

        if (!HasSizes)
        {
            var colorVariant = ProductVariantLogic.Find(_product.Variants, color, null);
            _selectedVariantId = colorVariant?.Id;
        }

        if (_quantity > AvailableStock)
            _quantity = Math.Max(0, AvailableStock);

        UpdateStockClass();
    }

    private static bool IsLightHex(string hex)
    {
        var normalized = ProductVariantLogic.NormalizeHex(hex);
        if (normalized is not { Length: 7 })
            return false;
        var r = Convert.ToInt32(normalized[1..3], 16);
        var g = Convert.ToInt32(normalized[3..5], 16);
        var b = Convert.ToInt32(normalized[5..7], 16);
        return ((r * 299) + (g * 587) + (b * 114)) / 1000 > 200;
    }

    private void SelectVariant(ProductVariant variant)
    {
        if (variant.StockQuantity <= 0) return;
        _selectedVariantId = variant.Id;
        _selectedSize = variant.Size;
        _sizeError = null;
        if (_quantity > variant.StockQuantity)
            _quantity = variant.StockQuantity;
        UpdateStockClass();
    }

    private void DecreaseQty()
    {
        if (_quantity > 1)
            _quantity--;
    }

    private void IncreaseQty()
    {
        if (_quantity < AvailableStock)
            _quantity++;
    }

    private ProductVariant? ResolveSelectedVariant()
    {
        if (_product is null || !_product.HasVariants)
            return null;

        if (_selectedVariantId is int id)
        {
            var byId = _product.Variants.FirstOrDefault(v => v.Id == id && v.IsActive);
            if (byId is not null)
            {
                var colorOk = !HasColors || ProductVariantLogic.SameText(byId.ColorName, _selectedColor);
                var sizeOk = !HasSizes || ProductVariantLogic.SameText(byId.Size, _selectedSize);
                if (colorOk && sizeOk)
                    return byId;
            }
        }

        return ProductVariantLogic.Find(
            _product.Variants,
            HasColors ? _selectedColor : null,
            HasSizes ? _selectedSize : null);
    }

    private bool ValidateSelection()
    {
        if (_product is null) return false;
        _sizeError = null;

        if (HasColors && string.IsNullOrWhiteSpace(_selectedColor))
        {
            Toast.Show("Please select a color.");
            return false;
        }

        if (HasSizes && string.IsNullOrWhiteSpace(_selectedSize))
        {
            _sizeError = "Please select a size.";
            Toast.Show("Please select a size.");
            return false;
        }

        if (_product.HasVariants)
        {
            var variant = ResolveSelectedVariant();
            if (variant is null)
            {
                if (HasColors && HasSizes)
                    Toast.Show("Please select a color and a size.");
                else if (HasColors)
                    Toast.Show("Please select a color.");
                else
                {
                    _sizeError = "Please select a size.";
                    Toast.Show("Please select a size.");
                }

                return false;
            }

            _selectedVariantId = variant.Id;
            _selectedColor = HasColors ? variant.ColorName : null;
            _selectedSize = HasSizes ? variant.Size : null;

            if (variant.StockQuantity <= 0)
            {
                Toast.Show("This product is out of stock.");
                return false;
            }

            if (variant.StockQuantity < _quantity)
            {
                Toast.Show(HasSizes
                    ? "Not enough stock for the selected size."
                    : "Not enough stock for the selected color.");
                return false;
            }

            return true;
        }

        if (AvailableStock <= 0)
        {
            Toast.Show("This product is out of stock.");
            return false;
        }

        _selectedVariantId = null;
        _selectedColor = null;
        _selectedSize = null;
        return true;
    }

    private void AddToCart()
    {
        if (_product is null || !ValidateSelection()) return;

        Cart.Add(
            _product,
            _quantity,
            HasColors ? _selectedColor : null,
            HasSizes ? _selectedSize : null,
            _selectedVariantId);
        Toast.Show("Product added to cart.");
    }

    private void BuyNow()
    {
        if (_product is null || !ValidateSelection()) return;

        Cart.Add(
            _product,
            _quantity,
            HasColors ? _selectedColor : null,
            HasSizes ? _selectedSize : null,
            _selectedVariantId);
        Toast.Show("Product added to cart.");
        Navigation.NavigateTo("/cart");
    }

    private void ToggleWishlist()
    {
        if (_product is null) return;

        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("/wishlist");
            return;
        }

        Wishlist.Toggle(_product.Id);
        Toast.Show(Wishlist.Contains(_product.Id) ? "Added to wishlist." : "Removed from wishlist.");
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Wishlist.OnChange -= Refresh;
        Auth.OnChange -= Refresh;
    }
}
