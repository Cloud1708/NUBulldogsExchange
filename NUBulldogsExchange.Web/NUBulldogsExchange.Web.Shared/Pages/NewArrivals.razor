@page "/new-arrivals"
@using NUBulldogsExchange.Web.Shared.Components
@using NUBulldogsExchange.Web.Shared.Data
@using NUBulldogsExchange.Web.Shared.Services
@inject ProductCatalogService Catalog

<PageTitle>New Arrivals | NU Bulldogs Exchange</PageTitle>

<ProductListingPage Title="New Arrivals"
                    Breadcrumb="_breadcrumb"
                    BaseProducts="Catalog.NewArrivals"
                    DefaultSort="newest"
                    RadioGroupPrefix="newarrivals" />

@code {
    private readonly List<BreadcrumbItem> _breadcrumb =
    [
        new("Home", "/"),
        new("Shop", "/shop"),
        new("New Arrivals")
    ];
}
