<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Override transitive 2.1.10 (NU1903) with the project's known-safe native provider. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NUBulldogsExchange.Web.Shared\NUBulldogsExchange.Web.Shared.csproj" />
  </ItemGroup>

  <!-- Avoid MSB3027/MSB3021 when a previous Web.Web process still locks Shared.dll. -->
  <Target Name="StopRunningHost" BeforeTargets="BeforeBuild">
    <Exec Command="taskkill /F /IM NUBulldogsExchange.Web.Web.exe /T 2&gt;nul" IgnoreExitCode="true" />
  </Target>

</Project>