<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Pages.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Forgot Password"
             BackgroundColor="#F6F7F9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="#0F172A" />
                <Setter Property="PlaceholderColor" Value="#94A3B8" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="22,36,22,32" Spacing="0">

                <!-- Header: Back Navigation -->
                <HorizontalStackLayout Spacing="6" Margin="0,0,0,14" HorizontalOptions="Start">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                    <Label Text="Back" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Brand Logo Badge -->
                <Border BackgroundColor="{StaticResource NuNavy}"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        Margin="0,4,0,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="NU"
                           TextColor="{StaticResource NuGold}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Multi-step Progress Bar (Breadcrumbs) -->
                <Border IsVisible="{Binding ShowStepIndicator}"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="14,10"
                        Margin="0,0,0,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*">

                        <!-- Step 1 -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border BackgroundColor="{Binding Step1Bg}"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Step1Marker}"
                                       TextColor="{Binding Step1TextColor}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Email"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Step1LabelColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Divider 1 -->
                        <BoxView Grid.Column="1" WidthRequest="18" HeightRequest="1" Color="#CBD5E1" VerticalOptions="Center" Margin="2,0" />

                        <!-- Step 2 -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border BackgroundColor="{Binding Step2Bg}"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Step2Marker}"
                                       TextColor="{Binding Step2TextColor}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Verify"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Step2LabelColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Divider 2 -->
                        <BoxView Grid.Column="3" WidthRequest="18" HeightRequest="1" Color="#CBD5E1" VerticalOptions="Center" Margin="2,0" />

                        <!-- Step 3 -->
                        <HorizontalStackLayout Grid.Column="4" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border BackgroundColor="{Binding Step3Bg}"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Step3Marker}"
                                       TextColor="{Binding Step3TextColor}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Password"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Step3LabelColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- STEP 1: ENTER EMAIL -->
                <!-- ========================================================= -->
                <VerticalStackLayout IsVisible="{Binding IsStepEnterEmail}" Spacing="0">
                    <Label Text="Forgot Password"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,6" />
                    <Label Text="Enter your registered email address and we'll send you a verification code to reset your password."
                           FontSize="13"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,22" />

                    <!-- Email Field -->
                    <Label Text="Email Address *"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           Margin="2,0,0,6" />
                    <Border BackgroundColor="White"
                            Stroke="{Binding HasEmailError, Converter={StaticResource InvertedBoolConverter}, ConverterParameter='#E2E8F0', TargetNullValue='#E2E8F0'}"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="14,0"
                            Margin="0,0,0,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="&#xe0be;" FontFamily="MaterialIcons" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Entry Grid.Column="1"
                                   Placeholder="you@example.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding SendCommand}"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   TextColor="{StaticResource NuNavy}"
                                   PlaceholderColor="{StaticResource MutedText}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding EmailError}"
                           IsVisible="{Binding HasEmailError}"
                           TextColor="#EF4444"
                           FontSize="12"
                           Margin="4,0,0,16" />

                    <!-- Submit Button -->
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            Margin="0,10,0,12"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Send Verification Code"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Back to Login Button -->
                    <Border BackgroundColor="Transparent"
                            Stroke="{StaticResource NuNavy}"
                            StrokeThickness="1.5"
                            HeightRequest="46"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Back to Login"
                               TextColor="{StaticResource NuNavy}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- ========================================================= -->
                <!-- LOADING: SENDING CODE STATE -->
                <!-- ========================================================= -->
                <VerticalStackLayout IsVisible="{Binding IsStepSendingCode}" Spacing="16" Padding="12,20">
                    <Label Text="Sending Verification Code"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Please wait while we send a 6-digit verification code to your email."
                           FontSize="13"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center" />

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="24,28"
                            Margin="0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource NuNavy}" WidthRequest="36" HeightRequest="36" />
                            <Label Text="Sending code..."
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="If an account exists for this email, a verification code will be sent."
                                   FontSize="12"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ========================================================= -->
                <!-- STEP 2: VERIFY CODE -->
                <!-- ========================================================= -->
                <VerticalStackLayout IsVisible="{Binding IsStepVerifyCode}" Spacing="0">
                    <Label Text="Verify Your Email"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,6" />
                    <Label Text="We sent a 6-digit verification code to:"
                           FontSize="13"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding MaskedEmail}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center"
                           Margin="0,2,0,6" />
                    <Label Text="{Binding GenericSentMessage}"
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,20" />

                    <!-- 6-digit Visual OTP Boxes -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8" Margin="0,0,0,10">
                        <!-- Box 0 -->
                        <Border Grid.Column="0" HeightRequest="52" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding Digit0}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Box 1 -->
                        <Border Grid.Column="1" HeightRequest="52" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding Digit1}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Box 2 -->
                        <Border Grid.Column="2" HeightRequest="52" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding Digit2}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Box 3 -->
                        <Border Grid.Column="3" HeightRequest="52" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding Digit3}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Box 4 -->
                        <Border Grid.Column="4" HeightRequest="52" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding Digit4}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Box 5 -->
                        <Border Grid.Column="5" HeightRequest="52" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding Digit5}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Real Hidden/Input Entry for OTP -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" HeightRequest="44" Padding="12,0" Margin="0,0,0,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry Placeholder="Type 6-digit code here"
                               Text="{Binding OtpCode}"
                               Keyboard="Numeric"
                               MaxLength="6"
                               HorizontalTextAlignment="Center"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}"
                               ReturnType="Done"
                               ReturnCommand="{Binding VerifyCommand}"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Timer or Error Label -->
                    <Label Text="{Binding OtpError}"
                           IsVisible="{Binding HasOtpError}"
                           TextColor="#EF4444"
                           FontSize="12"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,12" />
                    <Label Text="{Binding CodeRemainingText}"
                           IsVisible="{Binding HasOtpError, Converter={StaticResource InvertedBoolConverter}}"
                           TextColor="#64748B"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,16" />

                    <!-- Resend Code Box -->
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,12"
                            Margin="0,0,0,18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="&#xe9e0;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                <Label Text="Didn't receive the code?" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding ResendCooldownText}"
                                   IsVisible="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}}"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource NuNavy}"
                                    StrokeThickness="1"
                                    HeightRequest="38"
                                    IsEnabled="{Binding CanResend}"
                                    Opacity="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}, ConverterParameter='0.5', TargetNullValue='1'}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResendCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Resend Code"
                                       TextColor="{StaticResource NuNavy}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Verify Code Action Button -->
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            Margin="0,0,0,12"
                            IsEnabled="{Binding CanVerify}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VerifyCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Verify Code"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Change Email Button -->
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,4,0,0">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeEmailCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                        <Label Text="Change Email" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- ========================================================= -->
                <!-- STEP 3: NEW PASSWORD -->
                <!-- ========================================================= -->
                <VerticalStackLayout IsVisible="{Binding IsStepNewPassword}" Spacing="0">
                    <Label Text="Create New Password"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,6" />
                    <Label Text="Create a new secure password for your account."
                           FontSize="13"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,20" />

                    <!-- New Password Input -->
                    <Label Text="New Password *"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           Margin="2,0,0,6" />
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="14,0"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&#xe897;" FontFamily="MaterialIcons" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Entry Grid.Column="1"
                                   Placeholder="Enter a new password"
                                   Text="{Binding NewPassword}"
                                   IsPassword="{Binding IsNewPasswordHidden}"
                                   ReturnType="Next"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   TextColor="{StaticResource NuNavy}"
                                   PlaceholderColor="{StaticResource MutedText}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="2"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleNewPasswordCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding NewPasswordToggleGlyph}"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="#64748B"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Confirm Password Input -->
                    <Label Text="Confirm New Password *"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           Margin="2,0,0,6" />
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="14,0"
                            Margin="0,0,0,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&#xe897;" FontFamily="MaterialIcons" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Entry Grid.Column="1"
                                   Placeholder="Re-enter your new password"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="{Binding IsConfirmPasswordHidden}"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding ResetPasswordCommand}"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   TextColor="{StaticResource NuNavy}"
                                   PlaceholderColor="{StaticResource MutedText}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="2"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding ConfirmPasswordToggleGlyph}"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="#64748B"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Password Requirements Checklist Card -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Password Requirements"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   Margin="0,0,0,4" />

                            <!-- Rule 1: Min 8 chars -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding LengthGlyph}" FontFamily="MaterialIcons" FontSize="15" TextColor="{Binding LengthColor}" VerticalOptions="Center" />
                                <Label Text="At least 8 characters" FontSize="12" TextColor="{Binding LengthColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Rule 2: Upper & lower -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding CaseGlyph}" FontFamily="MaterialIcons" FontSize="15" TextColor="{Binding CaseColor}" VerticalOptions="Center" />
                                <Label Text="Uppercase and lowercase letter" FontSize="12" TextColor="{Binding CaseColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Rule 3: Number -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding DigitGlyph}" FontFamily="MaterialIcons" FontSize="15" TextColor="{Binding DigitColor}" VerticalOptions="Center" />
                                <Label Text="At least one number" FontSize="12" TextColor="{Binding DigitColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Rule 4: Special Char -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding SpecialGlyph}" FontFamily="MaterialIcons" FontSize="15" TextColor="{Binding SpecialColor}" VerticalOptions="Center" />
                                <Label Text="At least one special character" FontSize="12" TextColor="{Binding SpecialColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Rule 5: Passwords match -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding MatchGlyph}" FontFamily="MaterialIcons" FontSize="15" TextColor="{Binding MatchColor}" VerticalOptions="Center" />
                                <Label Text="Passwords match" FontSize="12" TextColor="{Binding MatchColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Error Labels -->
                    <Label Text="{Binding PasswordError}"
                           IsVisible="{Binding HasPasswordError}"
                           TextColor="#EF4444"
                           FontSize="12"
                           Margin="4,0,0,8" />
                    <Label Text="{Binding ConfirmError}"
                           IsVisible="{Binding HasConfirmError}"
                           TextColor="#EF4444"
                           FontSize="12"
                           Margin="4,0,0,8" />

                    <!-- Reset Password Button -->
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding CanReset}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetPasswordCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label Text="Reset Password"
                                   IsVisible="{Binding IsStepResetting, Converter={StaticResource InvertedBoolConverter}}"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Label Text="Resetting Password..."
                                   IsVisible="{Binding IsStepResetting}"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ========================================================= -->
                <!-- STEP 4: SUCCESS -->
                <!-- ========================================================= -->
                <VerticalStackLayout IsVisible="{Binding IsStepSuccess}" Spacing="16" Padding="12,24">
                    <!-- Big Green Check Circle -->
                    <Border BackgroundColor="#ECFDF5"
                            Stroke="#22C55E"
                            StrokeThickness="2"
                            WidthRequest="80"
                            HeightRequest="80"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40" />
                        </Border.StrokeShape>
                        <Label Text="&#xe5ca;"
                               FontFamily="MaterialIcons"
                               FontSize="44"
                               TextColor="#16A34A"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Password Reset Successful"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Your password has been changed successfully. You can now log in with your new password."
                           FontSize="14"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="12,0" />

                    <!-- Back to Login Button -->
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            Margin="0,16,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Back to Login"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
