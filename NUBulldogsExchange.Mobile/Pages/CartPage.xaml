<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NUBulldogsExchange.Mobile.Controls"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:models="clr-namespace:NUBulldogsExchange.Mobile.Models"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Pages.CartPage"
             x:Name="CartRoot"
             x:DataType="vm:CartViewModel"
             Title="My Cart"
             BackgroundColor="#F6F7F9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:IsStringNotNullOrEmptyConverter x:Key="HasTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Padding="0">

        <!-- Header: Back + My Cart + count -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="14,12,16,12">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">
                <Border WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="16"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="My Cart"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       VerticalOptions="Center" />

                <Label Grid.Column="2"
                       Text="{Binding ItemCountLabel}"
                       IsVisible="{Binding ShowItemCount}"
                       FontSize="12"
                       TextColor="{StaticResource MutedText}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Empty Cart -->
            <VerticalStackLayout IsVisible="{Binding IsCartEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10"
                                 Padding="32,0">

                <!-- Cart illustration (composed — no raster asset in project) -->
                <Grid WidthRequest="72"
                      HeightRequest="64"
                      HorizontalOptions="Center"
                      Margin="0,0,0,8">
                    <Border Stroke="{StaticResource NuNavy}"
                            StrokeThickness="3"
                            BackgroundColor="#EEF2F7"
                            WidthRequest="56"
                            HeightRequest="36"
                            HorizontalOptions="Center"
                            VerticalOptions="End"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4,4,8,8" />
                        </Border.StrokeShape>
                    </Border>
                    <Border Stroke="{StaticResource NuNavy}"
                            StrokeThickness="3"
                            BackgroundColor="Transparent"
                            WidthRequest="22"
                            HeightRequest="16"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,2,4,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10,10,0,0" />
                        </Border.StrokeShape>
                    </Border>
                    <Ellipse Fill="{StaticResource NuNavy}"
                             WidthRequest="10"
                             HeightRequest="10"
                             HorizontalOptions="Start"
                             VerticalOptions="End"
                             Margin="12,0,0,0" />
                    <Ellipse Fill="{StaticResource NuNavy}"
                             WidthRequest="10"
                             HeightRequest="10"
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             Margin="0,0,14,0" />
                </Grid>

                <Label Text="Your Cart is Empty"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Looks like you haven't added any Bulldog gear yet."
                       FontSize="13"
                       TextColor="{StaticResource MutedText}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="12,0" />
                <Border BackgroundColor="{StaticResource NuNavy}"
                        HeightRequest="42"
                        WidthRequest="148"
                        HorizontalOptions="Center"
                        Margin="0,14,0,0"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartShoppingCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Start Shopping"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Populated Cart -->
            <ScrollView IsVisible="{Binding HasCartItems}">
                <VerticalStackLayout Padding="16,12,16,16" Spacing="12">

                <!-- Select All -->
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,2">
                    <CheckBox IsChecked="{Binding AllSelected}"
                              Color="{StaticResource NuNavy}"
                              VerticalOptions="Center" />
                    <Label Text="{Binding SelectAllLabel}"
                           FontSize="13"
                           TextColor="#334155"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Cart lines -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CartLineItem">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12"
                                    HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                            Offset="0,2"
                                            Radius="6"
                                            Opacity="0.06" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,Auto,*"
                                          ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Color="{StaticResource NuNavy}"
                                                  VerticalOptions="Start" />

                                        <Border Grid.Column="1"
                                                WidthRequest="68"
                                                HeightRequest="68"
                                                StrokeThickness="0"
                                                BackgroundColor="#F1F5F9">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="3"
                                                             VerticalOptions="Start">
                                            <Label Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource NuNavy}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />
                                            <Label Text="{Binding VariantText}"
                                                   IsVisible="{Binding HasVariant}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource MutedText}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding PriceText}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource NuNavy}"
                                                   Margin="0,2,0,0" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1"
                                             Color="#F1F5F9"
                                             HorizontalOptions="Fill" />

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="4">
                                                <HorizontalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.RemoveCommand, Source={x:Reference CartRoot}}"
                                                        CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout.GestureRecognizers>
                                                <Label Text="🗑"
                                                       FontSize="12"
                                                       TextColor="#EF4444"
                                                       VerticalOptions="Center" />
                                                <Label Text="Remove"
                                                       FontSize="12"
                                                       TextColor="#EF4444"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="4">
                                                <HorizontalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.SaveCommand, Source={x:Reference CartRoot}}"
                                                        CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout.GestureRecognizers>
                                                <Label Text="♥"
                                                       FontSize="12"
                                                       TextColor="#F43F5E"
                                                       VerticalOptions="Center" />
                                                <Label Text="Save"
                                                       FontSize="12"
                                                       TextColor="#64748B"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>

                                        <!-- Quantity stepper -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="White"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                HeightRequest="34"
                                                Padding="4,0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="17" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto"
                                                  ColumnSpacing="8">
                                                <Label Text="−"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       WidthRequest="28"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.DecreaseQuantityCommand, Source={x:Reference CartRoot}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Grid.Column="1"
                                                       Text="{Binding QuantityText}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       WidthRequest="20"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="2"
                                                       Text="+"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       WidthRequest="28"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.IncreaseQuantityCommand, Source={x:Reference CartRoot}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Promo Code -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="14"
                        Margin="0,4,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Promo Code"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    HeightRequest="42"
                                    Padding="12,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry Placeholder="Enter promo code"
                                       Text="{Binding PromoCode}"
                                       BackgroundColor="Transparent"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource NuNavy}"
                                    HeightRequest="42"
                                    WidthRequest="78"
                                    StrokeThickness="0"
                                    IsEnabled="{Binding ApplyingPromo, Converter={StaticResource InvertedBoolConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ApplyPromoCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Apply"
                                       TextColor="White"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="Try: BULLDOG10"
                               FontSize="11"
                               TextColor="{StaticResource MutedText}" />
                        <Label Text="{Binding PromoMessage}"
                               IsVisible="{Binding HasPromoMessage}"
                               FontSize="11"
                               TextColor="#334155" />
                    </VerticalStackLayout>
                </Border>

                <!-- Order Summary -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="14"
                        Margin="0,0,0,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Order Summary"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}"
                               Margin="0,0,0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Subtotal"
                                   FontSize="13"
                                   TextColor="#64748B" />
                            <Label Grid.Column="1"
                                   Text="{Binding SubtotalText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Discount"
                                   FontSize="13"
                                   TextColor="#64748B" />
                            <Label Grid.Column="1"
                                   Text="{Binding DiscountText}"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Delivery Fee"
                                   FontSize="13"
                                   TextColor="#64748B" />
                            <Label Grid.Column="1"
                                   Text="{Binding DeliveryFeeText}"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="#E2E8F0"
                                 Margin="0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <Label Grid.Column="1"
                                   Text="{Binding TotalText}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Fixed checkout (populated only) -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasCartItems}"
                BackgroundColor="#F6F7F9"
                StrokeThickness="0"
                Padding="16,8,16,8">
            <Border BackgroundColor="{StaticResource NuNavy}"
                    HeightRequest="48"
                    StrokeThickness="0"
                    IsEnabled="{Binding CanCheckout}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CheckoutCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding CheckoutButtonText}"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Border>

        <!-- Bottom nav (Cart is not a tab) -->
        <controls:BottomNavBar Grid.Row="3"
                               ActiveTab="shop" />
    </Grid>
</ContentPage>
