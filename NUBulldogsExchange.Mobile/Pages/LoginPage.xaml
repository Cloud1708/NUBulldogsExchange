<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             BackgroundColor="#F6F7F9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="#0F172A" />
                <Setter Property="PlaceholderColor" Value="#94A3B8" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="22,40,22,28" Spacing="0">

                <!-- Back -->
                <Label Text="‹ Back"
                       FontSize="14"
                       TextColor="{StaticResource NuNavy}"
                       Margin="0,0,0,12"
                       HorizontalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Logo -->
                <Border BackgroundColor="{StaticResource NuNavy}"
                        WidthRequest="58"
                        HeightRequest="58"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        Margin="0,8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="NU"
                           TextColor="{StaticResource NuGold}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="Welcome Back!"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       HorizontalTextAlignment="Center"
                       Margin="0,16,0,4" />
                <Label Text="Login to continue shopping."
                       FontSize="13"
                       TextColor="{StaticResource MutedText}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,28" />

                <!-- Email -->
                <Label Text="Email Address"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       Margin="2,0,0,6" />
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        HeightRequest="46"
                        Padding="14,0"
                        Margin="0,0,0,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Placeholder="you@example.com"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           ReturnType="Next"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           VerticalOptions="Center" />
                </Border>

                <!-- Password -->
                <Label Text="Password"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       Margin="2,0,0,6" />
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        HeightRequest="46"
                        Padding="14,0"
                        Margin="0,0,0,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Placeholder="Password"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPasswordHidden}"
                               ReturnType="Done"
                               ReturnCommand="{Binding LoginCommand}"
                               BackgroundColor="Transparent"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                WidthRequest="36"
                                HeightRequest="36"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding PasswordToggleGlyph}"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Remember + Forgot -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding RememberMe}"
                                  Color="{StaticResource NuNavy}"
                                  VerticalOptions="Center" />
                        <Label Text="Remember Me"
                               FontSize="12"
                               TextColor="{StaticResource MutedText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1"
                           Text="Forgot Password?"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#EF4444"
                       FontSize="12"
                       Margin="0,0,0,10" />

                <!-- Login -->
                <Border BackgroundColor="{StaticResource NuNavy}"
                        HeightRequest="46"
                        StrokeThickness="0"
                        Margin="0,0,0,12"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoginCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="Login"
                               IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="White"
                                           HeightRequest="24"
                                           WidthRequest="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Continue as Guest -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        HeightRequest="46"
                        Margin="0,0,0,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContinueAsGuestCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Continue as Guest"
                           TextColor="#64748B"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Staff / Admin Portal -->
                <Border BackgroundColor="#F8FAFC"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        StrokeDashArray="4,3"
                        HeightRequest="46"
                        Margin="0,0,0,28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StaffPortalCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Staff / Admin Portal →"
                           TextColor="#64748B"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Create Account -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="Don't have an account?"
                           FontSize="13"
                           TextColor="{StaticResource MutedText}" />
                    <Label Text="Create Account"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateAccountCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
