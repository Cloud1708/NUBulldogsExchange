<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:data="clr-namespace:NUBulldogsExchange.Web.Shared.Data;assembly=NUBulldogsExchange.Web.Shared"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Pages.CheckoutPage"
             x:Name="CheckoutPageRoot"
             x:DataType="vm:CheckoutViewModel"
             Title="Checkout"
             BackgroundColor="#F6F7F9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
            <conv:ProductImageConverter x:Key="ProductImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- 1. Top Navigation Bar -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16,12,16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border WidthRequest="38"
                        HeightRequest="38"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="#0F172A"
                           FontAttributes="Bold"
                           InputTransparent="True"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                    <Label Text="Checkout"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}" />
                    <Label Text="Complete your order"
                           FontSize="11"
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="#EEF2FF"
                        Padding="8,4"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="&#xe897;" FontFamily="MaterialIcons" FontSize="13" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                        <Label Text="Secure" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,14,16,30">

                <!-- 2. Step Progress Indicator -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="14,10"
                        IsVisible="{Binding ShowCheckoutForm}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" VerticalOptions="Center">
                        <!-- Step 1: Cart (Done) -->
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Border BackgroundColor="#22C55E" WidthRequest="20" HeightRequest="20" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Cart" FontSize="11" FontAttributes="Bold" TextColor="#22C55E" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Line 1 -->
                        <BoxView Grid.Column="1" HeightRequest="2" Color="#22C55E" Margin="6,0" VerticalOptions="Center" />

                        <!-- Step 2: Information (Active) -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                            <Border BackgroundColor="{StaticResource NuNavy}" WidthRequest="20" HeightRequest="20" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label Text="2" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Info" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Line 2 -->
                        <BoxView Grid.Column="3" HeightRequest="2" Color="#CBD5E1" Margin="6,0" VerticalOptions="Center" />

                        <!-- Step 3: Payment -->
                        <HorizontalStackLayout Grid.Column="4" Spacing="4" VerticalOptions="Center">
                            <Border BackgroundColor="#E2E8F0" WidthRequest="20" HeightRequest="20" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label Text="3" TextColor="#64748B" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Pay" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Line 3 -->
                        <BoxView Grid.Column="5" HeightRequest="2" Color="#CBD5E1" Margin="6,0" VerticalOptions="Center" />

                        <!-- Step 4: Confirmation -->
                        <HorizontalStackLayout Grid.Column="6" Spacing="4" VerticalOptions="Center">
                            <Border BackgroundColor="#E2E8F0" WidthRequest="20" HeightRequest="20" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label Text="4" TextColor="#64748B" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Done" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- ==================== GUEST: Login to Continue ==================== -->
                <VerticalStackLayout IsVisible="{Binding ShowLoginGate}"
                                     Spacing="0"
                                     Padding="8,24,8,28">
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="22,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Border WidthRequest="68"
                                    HeightRequest="68"
                                    BackgroundColor="#EEF2FF"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="34" />
                                </Border.StrokeShape>
                                <Label Text="&#xe897;"
                                       FontFamily="MaterialIcons"
                                       FontSize="32"
                                       TextColor="{StaticResource NuNavy}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Text="Sign in to Checkout"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Please sign in to your NU Bulldogs account to complete your order. Your cart items are safely saved."
                                   FontSize="13"
                                   TextColor="{StaticResource MutedText}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />

                            <!-- Sign In Button -->
                            <Border BackgroundColor="{StaticResource NuNavy}"
                                    HeightRequest="48"
                                    StrokeThickness="0"
                                    Margin="0,6,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoLoginCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Sign In to Account"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Register Button -->
                            <Border BackgroundColor="White"
                                    HeightRequest="48"
                                    Stroke="{StaticResource NuNavy}"
                                    StrokeThickness="1.5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoRegisterCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Create New Account"
                                       TextColor="{StaticResource NuNavy}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,8,0,0">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoCartCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                                <Label Text="Back to Cart"
                                       FontSize="13"
                                       TextColor="{StaticResource MutedText}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== EMPTY CART ==================== -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     Spacing="14"
                                     Padding="8,40">
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="24,36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="&#xf1cc;"
                                   FontFamily="MaterialIcons"
                                   FontSize="44"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalOptions="Center" />
                            <Label Text="Your cart is empty"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Add NU merch before continuing to checkout."
                                   FontSize="13"
                                   TextColor="{StaticResource MutedText}"
                                   HorizontalTextAlignment="Center" />
                            <Border BackgroundColor="{StaticResource NuNavy}"
                                    HeightRequest="46"
                                    WidthRequest="180"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Center"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoShopCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Start Shopping"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== CHECKOUT FORM ==================== -->
                <VerticalStackLayout IsVisible="{Binding ShowCheckoutForm}" Spacing="14">

                    <!-- Card 1: Customer Information -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Customer Information"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="We'll use this information to contact you about your order."
                                           FontSize="11"
                                           TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Full Name -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Full Name *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="44" Padding="12,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Entry Text="{Binding FullName}" FontSize="13" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Email Address -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Email Address *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="44" Padding="12,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Entry Text="{Binding Email}" FontSize="13" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Contact Number -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Contact Number *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="44" Padding="12,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Entry Text="{Binding ContactPhone}"
                                           Placeholder="09XXXXXXXXX"
                                           Keyboard="Telephone"
                                           FontSize="13"
                                           TextColor="{StaticResource NuNavy}"
                                           VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 2: Fulfillment Method -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="&#xe558;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Fulfillment Method"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="Choose how you want to receive your order."
                                           FontSize="11"
                                           TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- 2 Options Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <!-- Campus Pickup Option -->
                                <Border BackgroundColor="{Binding PickupBackgroundColor}"
                                        Stroke="{Binding PickupStroke}"
                                        StrokeThickness="{Binding PickupStrokeThickness}"
                                        Padding="12,12"
                                        VerticalOptions="Fill">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPickupCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4" InputTransparent="True">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="&#xe0c8;" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource NuNavy}" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{StaticResource NuNavy}"
                                                    WidthRequest="18"
                                                    HeightRequest="18"
                                                    StrokeThickness="0"
                                                    IsVisible="{Binding IsCampusPickup}">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                                <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Label Text="Campus Pickup"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}" />
                                        <Label Text="Free • Ready in 1-3 days"
                                               FontSize="11"
                                               TextColor="#16A34A"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Delivery Option -->
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding DeliveryBackgroundColor}"
                                        Stroke="{Binding DeliveryStroke}"
                                        StrokeThickness="{Binding DeliveryStrokeThickness}"
                                        Padding="12,12"
                                        VerticalOptions="Fill">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectDeliveryCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4" InputTransparent="True">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="&#xe558;" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource NuNavy}" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{StaticResource NuNavy}"
                                                    WidthRequest="18"
                                                    HeightRequest="18"
                                                    StrokeThickness="0"
                                                    IsVisible="{Binding IsDelivery}">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                                <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Label Text="Delivery"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}" />
                                        <Label Text="₱150 • 3-7 days"
                                               FontSize="11"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Pickup Callout Banner -->
                            <Border IsVisible="{Binding IsCampusPickup}"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1"
                                    Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Label Text="&#xe88e;" FontFamily="MaterialIcons" TextColor="#1E40AF" FontSize="16" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Campus Pickup Details" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                        <Label Text="Your order will be available for pickup at the NU Lipa Campus Merchandise Desk. You'll receive a notification when it's ready."
                                               FontSize="11"
                                               TextColor="#1E40AF"
                                               LineHeight="1.25" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Delivery Address Section -->
                            <VerticalStackLayout IsVisible="{Binding IsDelivery}" Spacing="12" Margin="0,8,0,0">
                                <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2,0,2" />

                                <!-- Shipping Address Header -->
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Border BackgroundColor="#EFF6FF"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="&#xe0c8;"
                                               FontFamily="MaterialIcons"
                                               FontSize="18"
                                               TextColor="{StaticResource NuNavy}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="Shipping Address"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}" />
                                        <Label Text="Where should we deliver your order?"
                                               FontSize="11"
                                               TextColor="{StaticResource MutedText}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <!-- Address Mode Selector (Only if user has saved addresses) -->
                                <HorizontalStackLayout IsVisible="{Binding HasSavedAddresses}" Spacing="18" Margin="0,2,0,4">
                                    <!-- Use Saved Address Radio -->
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectSavedAddressModeCommand}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Border WidthRequest="18"
                                                HeightRequest="18"
                                                BackgroundColor="Transparent"
                                                Stroke="{Binding UseSavedAddressRadioStroke}"
                                                StrokeThickness="2"
                                                VerticalOptions="Center"
                                                InputTransparent="True">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>
                                            <Border WidthRequest="8"
                                                    HeightRequest="8"
                                                    BackgroundColor="{StaticResource NuNavy}"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding IsUseSavedAddress}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Border>
                                        <Label Text="Use saved address"
                                               FontSize="13"
                                               TextColor="{StaticResource NuNavy}"
                                               VerticalOptions="Center"
                                               InputTransparent="True" />
                                    </HorizontalStackLayout>

                                    <!-- Add New Address Radio -->
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectNewAddressModeCommand}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Border WidthRequest="18"
                                                HeightRequest="18"
                                                BackgroundColor="Transparent"
                                                Stroke="{Binding AddNewAddressRadioStroke}"
                                                StrokeThickness="2"
                                                VerticalOptions="Center"
                                                InputTransparent="True">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>
                                            <Border WidthRequest="8"
                                                    HeightRequest="8"
                                                    BackgroundColor="{StaticResource NuNavy}"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding IsAddNewAddress}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Border>
                                        <Label Text="Add new address"
                                               FontSize="13"
                                               TextColor="{StaticResource NuNavy}"
                                               VerticalOptions="Center"
                                               InputTransparent="True" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                                <!-- Saved Address Dropdown & Preview -->
                                <VerticalStackLayout IsVisible="{Binding ShowSavedAddressSection}" Spacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Saved Address" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                        <Border BackgroundColor="White"
                                                Stroke="#CBD5E1"
                                                StrokeThickness="1"
                                                HeightRequest="42"
                                                Padding="10,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Picker ItemsSource="{Binding SavedAddresses}"
                                                    SelectedItem="{Binding SelectedSavedAddress}"
                                                    ItemDisplayBinding="{Binding DisplayText}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource NuNavy}"
                                                    VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Address Preview Card -->
                                    <Border IsVisible="{Binding HasSelectedSavedAddress}"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            Padding="14,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding SelectedSavedAddress.Label}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource NuNavy}" />
                                            <Label Text="{Binding SelectedSavedAddress.RecipientName}"
                                                   FontSize="12"
                                                   TextColor="#334155" />
                                            <Label Text="{Binding SelectedSavedAddress.SummaryLine}"
                                                   FontSize="12"
                                                   TextColor="#475569" />
                                            <Label Text="{Binding SelectedSavedAddress.PhoneNumber}"
                                                   FontSize="12"
                                                   TextColor="#475569" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- New Address Manual Fields -->
                                <VerticalStackLayout IsVisible="{Binding ShowNewAddressSection}" Spacing="10">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Recipient Name *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="10,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Entry Text="{Binding ShipRecipient}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource NuNavy}"
                                                       PlaceholderColor="{StaticResource MutedText}"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="Phone Number *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="10,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Entry Text="{Binding ShipPhone}"
                                                       Keyboard="Telephone"
                                                       FontSize="12"
                                                       TextColor="{StaticResource NuNavy}"
                                                       PlaceholderColor="{StaticResource MutedText}"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Address Line *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                        <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="10,0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                            <Entry Text="{Binding ShipAddressLine}"
                                                   Placeholder="House no., street, subdivision"
                                                   FontSize="12"
                                                   TextColor="{StaticResource NuNavy}"
                                                   PlaceholderColor="{StaticResource MutedText}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Barangay *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="10,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Entry Text="{Binding ShipBarangay}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource NuNavy}"
                                                       PlaceholderColor="{StaticResource MutedText}"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="City *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="10,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Entry Text="{Binding ShipCity}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource NuNavy}"
                                                       PlaceholderColor="{StaticResource MutedText}"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Province *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="8,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Picker ItemsSource="{Binding Provinces}"
                                                        SelectedItem="{Binding ShipProvince}"
                                                        FontSize="12"
                                                        TextColor="{StaticResource NuNavy}"
                                                        TitleColor="{StaticResource MutedText}"
                                                        VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="Postal Code *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="40" Padding="10,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Entry Text="{Binding ShipPostal}"
                                                       Keyboard="Numeric"
                                                       FontSize="12"
                                                       TextColor="{StaticResource NuNavy}"
                                                       PlaceholderColor="{StaticResource MutedText}"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Save this address for future orders Checkbox -->
                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0" VerticalOptions="Center">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleSaveAddressCommand}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Border WidthRequest="18"
                                                HeightRequest="18"
                                                BackgroundColor="{Binding SaveAddressBoxBg}"
                                                Stroke="{Binding SaveAddressBoxStroke}"
                                                StrokeThickness="1.5"
                                                VerticalOptions="Center"
                                                InputTransparent="True">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                            <Label Text="&#xe5ca;"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="12"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding SaveAddress}" />
                                        </Border>
                                        <Label Text="Save this address for future orders"
                                               FontSize="12"
                                               TextColor="#334155"
                                               VerticalOptions="Center"
                                               InputTransparent="True" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 3: Payment Method -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border BackgroundColor="#EFF6FF"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Path Aspect="Uniform"
                                          WidthRequest="18"
                                          HeightRequest="18"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Stroke="{StaticResource NuNavy}"
                                          StrokeThickness="1.75"
                                          StrokeLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1 M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4" />
                                </Border>
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="Payment Method"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="Choose your preferred payment method."
                                           FontSize="11"
                                           TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- 2x2 Payment Grid -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                                <!-- Cash on Pickup / Delivery -->
                                <Border BackgroundColor="{Binding CashBackgroundColor}"
                                        Stroke="{Binding CashStroke}"
                                        StrokeThickness="{Binding CashStrokeThickness}"
                                        Padding="14,14"
                                        MinimumHeightRequest="54">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" InputTransparent="True" VerticalOptions="Center">
                                        <Label Text="{Binding CashPaymentTitle}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding CashCheckBg}"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="&#xe5ca;"
                                                   FontFamily="MaterialIcons"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsCashSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- GCash -->
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding GCashBackgroundColor}"
                                        Stroke="{Binding GCashStroke}"
                                        StrokeThickness="{Binding GCashStrokeThickness}"
                                        Padding="14,14"
                                        MinimumHeightRequest="54">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="GCash" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" InputTransparent="True" VerticalOptions="Center">
                                        <Label Text="GCash"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding GCashCheckBg}"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="&#xe5ca;"
                                                   FontFamily="MaterialIcons"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsGCashSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Maya -->
                                <Border Grid.Row="1"
                                        BackgroundColor="{Binding MayaBackgroundColor}"
                                        Stroke="{Binding MayaStroke}"
                                        StrokeThickness="{Binding MayaStrokeThickness}"
                                        Padding="14,14"
                                        MinimumHeightRequest="54">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Maya" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" InputTransparent="True" VerticalOptions="Center">
                                        <Label Text="Maya"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding MayaCheckBg}"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="&#xe5ca;"
                                                   FontFamily="MaterialIcons"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsMayaSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Credit Card -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        BackgroundColor="{Binding CreditCardBackgroundColor}"
                                        Stroke="{Binding CreditCardStroke}"
                                        StrokeThickness="{Binding CreditCardStrokeThickness}"
                                        Padding="14,14"
                                        MinimumHeightRequest="54">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Credit Card" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" InputTransparent="True" VerticalOptions="Center">
                                        <Label Text="Credit Card"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding CreditCardCheckBg}"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="&#xe5ca;"
                                                   FontFamily="MaterialIcons"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsCreditCardSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Online Note -->
                            <Border IsVisible="{Binding HasOnlineNote}"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="10,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="&#xe324;" FontFamily="MaterialIcons" FontSize="14" TextColor="#475569" VerticalOptions="Center" />
                                    <Label Text="{Binding OnlineNoteText}"
                                           FontSize="11"
                                           TextColor="#475569"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 4: Order Notes -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="&#xe3c9;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Order Notes (Optional)"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="Any special instructions or requests?"
                                           FontSize="11"
                                           TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Editor Text="{Binding OrderNotes}"
                                        Placeholder="e.g. Preferred pickup date, special instructions..."
                                        HeightRequest="72"
                                        FontSize="12"
                                        TextColor="{StaticResource NuNavy}"
                                        PlaceholderColor="{StaticResource MutedText}"
                                        AutoSize="Disabled" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 5: Order Summary -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="Order Summary"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="{Binding ItemCountText}"
                                           FontSize="12"
                                           TextColor="{StaticResource MutedText}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1"
                                       Text="Edit Cart"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoCartCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <!-- Items Preview List -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CartItems}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="data:CartItem">
                                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10" Padding="0,4">
                                            <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Image Source="{Binding Product, Converter={StaticResource ProductImageConverter}}"
                                                       Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Product.Name}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding SelectedSize, StringFormat='Size: {0}'}"
                                                           FontSize="10"
                                                           TextColor="#64748B"
                                                           IsVisible="{Binding SelectedSize, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
                                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                                           FontSize="10"
                                                           TextColor="#64748B" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource NuNavy}"
                                                   VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="₱" />
                                                        <Span Text="{Binding Product.Price, StringFormat='{0:N0}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4" />

                            <!-- Breakdown Rows -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Subtotal" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding SubtotalText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Fulfillment Fee" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding FulfillmentFeeText}" FontSize="13" FontAttributes="Bold" TextColor="#16A34A" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDiscount}">
                                <Label Text="Discount" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding DiscountText}" FontSize="13" FontAttributes="Bold" TextColor="#16A34A" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Total -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalText}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                            </Grid>

                            <!-- Savings Banner -->
                            <Border BackgroundColor="#F0FDF4"
                                    Stroke="#BBF7D0"
                                    StrokeThickness="1"
                                    Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Label Text="{Binding SavingsBannerText}"
                                       FontSize="11"
                                       TextColor="#166534"
                                       FontAttributes="Bold" />
                            </Border>

                            <!-- Promo Code Input -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" HeightRequest="42" Padding="10,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Entry Text="{Binding PromoCodeInput}"
                                           Placeholder="Enter promo code"
                                           FontSize="12"
                                           TextColor="{StaticResource NuNavy}"
                                           PlaceholderColor="{StaticResource MutedText}"
                                           VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource NuNavy}"
                                        WidthRequest="80"
                                        HeightRequest="42"
                                        StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ApplyPromoCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Apply" TextColor="White" FontSize="12" FontAttributes="Bold" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding PromoMessage}"
                                   IsVisible="{Binding HasPromoMessage}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding IsPromoSuccess, Converter={StaticResource InvertedBoolConverter}}" />

                            <!-- Terms & Policies Checkbox -->
                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding AgreeToTerms}" Color="{StaticResource NuNavy}" VerticalOptions="Center" />
                                <Label Text="I agree to the store policies and Terms of Service"
                                       FontSize="12"
                                       TextColor="{StaticResource NuNavy}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleTermsCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- Status / Error Alert -->
                            <Border IsVisible="{Binding HasStatus}"
                                    BackgroundColor="#FEF2F2"
                                    Stroke="#FECACA"
                                    StrokeThickness="1"
                                    Padding="10,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Label Text="{Binding StatusMessage}" TextColor="#DC2626" FontSize="12" FontAttributes="Bold" />
                            </Border>

                            <!-- Place Order Button -->
                            <Border BackgroundColor="{StaticResource NuNavy}"
                                    HeightRequest="50"
                                    StrokeThickness="0"
                                    Margin="0,4,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PlaceOrderCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Place Order"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Security Footnote -->
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,2,0,0">
                                <Label Text="&#xe897;" FontFamily="MaterialIcons" FontSize="13" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                                <Label Text="Secure and encrypted checkout"
                                       FontSize="11"
                                       TextColor="{StaticResource MutedText}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== ORDER CONFIRMATION ==================== -->
                <VerticalStackLayout IsVisible="{Binding IsConfirmation}" Spacing="14" Padding="2,0,2,24">

                    <!-- Breadcrumbs -->
                    <HorizontalStackLayout Spacing="6" Margin="4,4,4,0" VerticalOptions="Center">
                        <Label Text="Home" FontSize="11" TextColor="#64748B">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoShopCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center" />
                        <Label Text="My Shopping Cart" FontSize="11" TextColor="#64748B">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoCartCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center" />
                        <Label Text="Checkout" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                    </HorizontalStackLayout>

                    <!-- Page Title & Subtitle -->
                    <VerticalStackLayout Spacing="2" Margin="4,0,4,4">
                        <Label Text="Checkout"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}" />
                        <Label Text="Complete your order in a few easy steps."
                               FontSize="12"
                               TextColor="{StaticResource MutedText}" />
                    </VerticalStackLayout>

                    <!-- 4-Step Progress Indicator (Completed) -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" VerticalOptions="Center">
                            <!-- Step 1: Cart (Done) -->
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Border BackgroundColor="#22C55E" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                    <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Cart" FontSize="10" FontAttributes="Bold" TextColor="#22C55E" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Line 1 -->
                            <BoxView Grid.Column="1" HeightRequest="2" Color="#22C55E" Margin="4,0" VerticalOptions="Center" />

                            <!-- Step 2: Information (Done) -->
                            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                <Border BackgroundColor="#22C55E" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                    <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Info" FontSize="10" FontAttributes="Bold" TextColor="#22C55E" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Line 2 -->
                            <BoxView Grid.Column="3" HeightRequest="2" Color="#22C55E" Margin="4,0" VerticalOptions="Center" />

                            <!-- Step 3: Payment (Done) -->
                            <HorizontalStackLayout Grid.Column="4" Spacing="4" VerticalOptions="Center">
                                <Border BackgroundColor="#22C55E" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                    <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Payment" FontSize="10" FontAttributes="Bold" TextColor="#22C55E" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Line 3 -->
                            <BoxView Grid.Column="5" HeightRequest="2" Color="#22C55E" Margin="4,0" VerticalOptions="Center" />

                            <!-- Step 4: Confirmation (Active) -->
                            <HorizontalStackLayout Grid.Column="6" Spacing="4" VerticalOptions="Center">
                                <Border BackgroundColor="{StaticResource NuNavy}" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                    <Label Text="&#xe5ca;" FontFamily="MaterialIcons" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Confirmation" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Main Confirmation Card -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="18,22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="16">

                            <!-- Success Icon Badge -->
                            <Border WidthRequest="60"
                                    HeightRequest="60"
                                    BackgroundColor="#ECFDF5"
                                    Stroke="#A7F3D0"
                                    StrokeThickness="2"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30" />
                                </Border.StrokeShape>
                                <Label Text="&#xe5ca;"
                                       FontFamily="MaterialIcons"
                                       FontSize="30"
                                       TextColor="#10B981"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Header Titles -->
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Order Confirmed!"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource NuNavy}"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="Thank you for supporting NU Bulldogs Exchange. Your order has been placed successfully."
                                       FontSize="12"
                                       TextColor="{StaticResource MutedText}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       Margin="8,2,8,0" />
                            </VerticalStackLayout>

                            <!-- Confirmation Details Table -->
                            <Border BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="14,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <!-- Order Number -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Order Number" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ConfirmedOrderId}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Order Date -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Order Date" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ConfirmedOrderDate}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Payment Method -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Payment Method" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ConfirmedOrderPayment}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Payment Status Badge -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Payment Status" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding PaymentBadgeBg}"
                                                StrokeThickness="0"
                                                Padding="10,2"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ConfirmedOrderPaymentStatus}"
                                                   TextColor="{Binding PaymentBadgeTextColor}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Fulfillment Method -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Fulfillment Method" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ConfirmedOrderFulfillment}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Total Amount -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Total Amount" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ConfirmedOrderTotal}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Fulfillment Callout Box -->
                            <!-- Campus Pickup Information -->
                            <Border IsVisible="{Binding IsConfirmedCampusPickup}"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1"
                                    Padding="14,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Campus Pickup Information"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="Your order will be ready within 1–3 business days."
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                    <Label Text="Pick up your order at the NU Lipa Campus pickup location."
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                    <Label Text="You'll receive a notification when your order is ready."
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Delivery Information -->
                            <Border IsVisible="{Binding IsConfirmedDelivery}"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1"
                                    Padding="14,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Delivery Information"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}" />
                                    <Label Text="{Binding ConfirmedRecipientName, StringFormat='Recipient: {0}'}"
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                    <Label Text="{Binding ConfirmedAddress, StringFormat='Shipping Address: {0}'}"
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                    <Label Text="{Binding ConfirmedPhone, StringFormat='Contact Number: {0}'}"
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                    <Label Text="Estimated Delivery: 3–7 business days"
                                           FontSize="11.5"
                                           TextColor="#334155" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Itemized Product List -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Ordered Items" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConfirmedItems}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConfirmedOrderItemViewModel">
                                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10" Padding="0,2">
                                                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ProductImageConverter}}"
                                                           Aspect="AspectFill" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource NuNavy}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding SizeLabel}"
                                                               FontSize="11"
                                                               TextColor="#64748B"
                                                               IsVisible="{Binding HasSize}" />
                                                        <Label Text="{Binding QuantityLabel}"
                                                               FontSize="11"
                                                               TextColor="#64748B" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>

                                                <Label Grid.Column="2"
                                                       Text="{Binding FormattedPrice}"
                                                       FontSize="13.5"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                <!-- Track Order (Solid Navy) -->
                                <Border BackgroundColor="{StaticResource NuNavy}"
                                        HeightRequest="46"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TrackOrderCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Track Order"
                                           TextColor="White"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           InputTransparent="True"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- View My Orders (Outlined Navy) -->
                                <Border BackgroundColor="White"
                                        HeightRequest="46"
                                        Stroke="{StaticResource NuNavy}"
                                        StrokeThickness="1.5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoOrdersCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="View My Orders"
                                           TextColor="{StaticResource NuNavy}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           InputTransparent="True"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Continue Shopping Link Button -->
                            <Border BackgroundColor="White"
                                    HeightRequest="44"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoShopCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                                    <Label Text="Continue Shopping"
                                           TextColor="{StaticResource NuNavy}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Label Text="&#xe5c8;"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{StaticResource NuNavy}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
