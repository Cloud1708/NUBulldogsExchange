<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Pages.CheckoutPage"
             x:DataType="vm:CheckoutViewModel"
             Title="Checkout"
             BackgroundColor="#F6F7F9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="14,12,16,12">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  VerticalOptions="Center">
                <Border WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="16"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Text="Checkout"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <Grid Padding="22,0">

                <!-- ========== GUEST: Login to Continue ========== -->
                <VerticalStackLayout IsVisible="{Binding ShowLoginGate}"
                                     VerticalOptions="Center"
                                     Spacing="0"
                                     Padding="0,24,0,28">

                    <!-- Lock icon -->
                    <Border WidthRequest="72"
                            HeightRequest="72"
                            BackgroundColor="#F3E8FF"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            Margin="0,0,0,18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                        <Label Text="🔒"
                               FontSize="34"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Login to Continue"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,10" />

                    <Label Text="You need to be logged in to place an order. Your cart items are saved — login and pick up right where you left off."
                           FontSize="13"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="8,0,8,22" />

                    <!-- Login to My Account -->
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoLoginCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Login to My Account"
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Create New Account -->
                    <Border BackgroundColor="White"
                            HeightRequest="48"
                            Stroke="{StaticResource NuNavy}"
                            StrokeThickness="1.5"
                            Margin="0,0,0,18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoRegisterCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Create New Account"
                               TextColor="{StaticResource NuNavy}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="← Back to Cart"
                           FontSize="13"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,28">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoCartCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End"
                                           Margin="0,12,0,0">
                        <Label Text="🛡"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Label Text="Your cart is saved. Login anytime to complete your order."
                               FontSize="11"
                               TextColor="{StaticResource MutedText}"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- ========== AUTHENTICATED EMPTY ========== -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="0,40">
                    <Label Text="Your cart is empty."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           HorizontalTextAlignment="Center" />
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="44"
                            WidthRequest="160"
                            HorizontalOptions="Center"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoShopCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Start Shopping"
                               TextColor="White"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- ========== AUTHENTICATED CHECKOUT ========== -->
                <VerticalStackLayout IsVisible="{Binding ShowCheckoutForm}"
                                     Spacing="12"
                                     Padding="0,16,0,28">
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Pickup details"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <Label Text="Campus pickup at the NU Manila Merchandise Center (Building A, Ground Floor)."
                                   FontSize="12"
                                   TextColor="{StaticResource MutedText}" />
                            <Label Text="Pickup hours: Monday–Friday, 8:00 AM–5:00 PM."
                                   FontSize="12"
                                   TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Order Summary"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Subtotal" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding SubtotalText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Discount" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding DiscountText}" FontSize="13" TextColor="#64748B" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Campus Pickup" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="₱0" FontSize="13" TextColor="#16A34A" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                <Label Grid.Column="1" Text="{Binding TotalText}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatus}"
                           TextColor="#EF4444"
                           FontSize="12" />

                    <Border BackgroundColor="{StaticResource NuNavy}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PlaceOrderCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Place Order"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
