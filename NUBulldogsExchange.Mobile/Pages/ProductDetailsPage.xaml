<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:models="clr-namespace:NUBulldogsExchange.Mobile.Models"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Pages.ProductDetailsPage"
             x:Name="ProductPageRoot"
             x:DataType="vm:ProductDetailsViewModel"
             Title="Product Details"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <!-- Scrollable Product Content -->
        <ScrollView Grid.Row="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
            <VerticalStackLayout Spacing="0"
                                 HorizontalOptions="Fill">

                <!-- 1. Hero Image Container with Floating Overlays -->
                <Grid HeightRequest="380"
                      HorizontalOptions="Fill"
                      BackgroundColor="#F1F5F9">

                    <!-- Hero Image -->
                    <Image Source="{Binding DisplayImage}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextImageCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Top Floating Action Bar -->
                    <Grid Margin="16,36,16,0"
                          VerticalOptions="Start"
                          HorizontalOptions="Fill">

                        <!-- Back Button -->
                        <Border BackgroundColor="White"
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="&#xe5c4;"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource NuNavy}"
                                   FontAttributes="Bold"
                                   InputTransparent="True"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Right Actions (Share, Wishlist, Cart) -->
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8">

                            <!-- Share Button -->
                            <Border BackgroundColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShareCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xe80d;"
                                       FontFamily="MaterialIcons"
                                       FontSize="18"
                                       TextColor="#1E293B"
                                       InputTransparent="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Wishlist Button -->
                            <Border BackgroundColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleWishlistCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding WishlistGlyph}"
                                       FontFamily="MaterialIcons"
                                       FontSize="18"
                                       TextColor="{Binding WishlistColor}"
                                       InputTransparent="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Cart Button with Badge -->
                            <Grid WidthRequest="40" HeightRequest="40">
                                <Border BackgroundColor="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xe8cc;"
                                           FontFamily="MaterialIcons"
                                           FontSize="18"
                                           TextColor="#1E293B"
                                           InputTransparent="True"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Border IsVisible="{Binding HasCartItems}"
                                        BackgroundColor="#EF4444"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        StrokeThickness="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,-2,-2,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding CartCount}"
                                           TextColor="White"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           InputTransparent="True"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Bottom-Left Counter Pill (1 / 4) -->
                    <Border BackgroundColor="#99000000"
                            Padding="12,5"
                            StrokeThickness="0"
                            HorizontalOptions="Start"
                            VerticalOptions="End"
                            Margin="16,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ImageCounterText}"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Bottom-Right Pagination Dots -->
                    <HorizontalStackLayout Spacing="6"
                                           HorizontalOptions="End"
                                           VerticalOptions="End"
                                           Margin="0,0,16,24">
                        <Border BackgroundColor="{StaticResource NuNavy}"
                                WidthRequest="16"
                                HeightRequest="6"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                        <Border BackgroundColor="#CBD5E1"
                                WidthRequest="6"
                                HeightRequest="6"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                        <Border BackgroundColor="#CBD5E1"
                                WidthRequest="6"
                                HeightRequest="6"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                        <Border BackgroundColor="#CBD5E1"
                                WidthRequest="6"
                                HeightRequest="6"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- 2. Main Product Information Body -->
                <VerticalStackLayout Padding="20,18,20,24"
                                     Spacing="14"
                                     HorizontalOptions="Fill">

                    <!-- Best Seller / New Badge -->
                    <Border IsVisible="{Binding HasBadge}"
                            BackgroundColor="#FEF3C7"
                            Padding="10,4"
                            StrokeThickness="0"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Badge}"
                               TextColor="#B45309"
                               FontSize="11"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Product Name -->
                    <Label Text="{Binding Name}"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           LineBreakMode="WordWrap" />

                    <!-- Rating & Reviews & Sold Row -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="14" TextColor="#F59E0B" VerticalOptions="Center" />
                        <Label Text="{Binding RatingText}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}"
                               VerticalOptions="Center" />
                        <Label Text="|" TextColor="#CBD5E1" FontSize="13" VerticalOptions="Center" />
                        <Label Text="{Binding ReviewsText}"
                               TextColor="#64748B"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Label Text="|" TextColor="#CBD5E1" FontSize="13" VerticalOptions="Center" />
                        <Label Text="{Binding SoldText}"
                               TextColor="#64748B"
                               FontSize="13"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Price -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding PriceFormatted}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding OriginalPriceFormatted}"
                               FontSize="16"
                               TextColor="#94A3B8"
                               TextDecorations="Strikethrough"
                               IsVisible="{Binding HasOriginalPrice}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Stock Status Row -->
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="●" FontSize="10" TextColor="{Binding StockStatusColor}" VerticalOptions="Center" />
                        <Label Text="{Binding StockStatusText}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{Binding StockStatusColor}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Color Selection Section -->
                    <VerticalStackLayout IsVisible="{Binding HasColors}" Spacing="8" Margin="0,4,0,0">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Color"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <Label Text="{Binding SelectedColor}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#64748B" />
                        </HorizontalStackLayout>
                        <FlexLayout BindableLayout.ItemsSource="{Binding ColorList}"
                                    Wrap="Wrap"
                                    AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductColorItem">
                                    <Border StrokeThickness="{Binding RingThickness}"
                                            Stroke="{Binding RingStrokeColor}"
                                            BackgroundColor="Transparent"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            Padding="3"
                                            Margin="0,0,8,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="19" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.SelectColorCommand, Source={x:Reference ProductPageRoot}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border BackgroundColor="{Binding ColorValue}"
                                                InputTransparent="True"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="15" />
                                            </Border.StrokeShape>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Size Selection Section -->
                    <VerticalStackLayout IsVisible="{Binding HasSizes}" Spacing="10" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="Size"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource NuNavy}"
                                       VerticalOptions="Center" />
                                <Border IsVisible="{Binding HasSelectedSize}"
                                        BackgroundColor="#EEF2FF"
                                        Stroke="#C7D2FE"
                                        StrokeThickness="1"
                                        Padding="8,2"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding SelectedSizeTitle}"
                                           TextColor="{StaticResource NuNavy}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>

                            <Label Grid.Column="1"
                                   Text="Size Guide"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSizeGuideCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Size Pills List -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding SizeList}"
                                    Wrap="Wrap"
                                    AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductSizeItem">
                                    <Border BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="{Binding StrokeThickness}"
                                            HeightRequest="40"
                                            MinimumWidthRequest="50"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Opacity="{Binding Opacity}"
                                            IsEnabled="{Binding IsAvailable}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.SelectSizeCommand, Source={x:Reference ProductPageRoot}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4"
                                                               InputTransparent="True"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding IndicatorGlyph}"
                                                   FontFamily="MaterialIcons"
                                                   TextColor="{Binding TextColor}"
                                                   FontSize="13"
                                                   IsVisible="{Binding IsSelected}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Size}"
                                                   TextColor="{Binding TextColor}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Selected Size & Stock Feedback Banner -->
                        <Border IsVisible="{Binding HasSelectedSize}"
                                BackgroundColor="#F0FDF4"
                                Stroke="#BBF7D0"
                                StrokeThickness="1"
                                Padding="12,8"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="&#xe5ca;"
                                       FontFamily="MaterialIcons"
                                       TextColor="#16A34A"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding SelectedSizeHint}"
                                       TextColor="#166534"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Quantity Section -->
                    <VerticalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Label Text="Quantity"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">

                            <!-- Stepper Box -->
                            <Border BackgroundColor="White"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    HeightRequest="40"
                                    Padding="2,0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="36,40,36">
                                    <Border BackgroundColor="Transparent" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding DecreaseCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="−"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}"
                                               InputTransparent="True"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="{Binding Quantity}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding IncreaseCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="+"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource NuNavy}"
                                               InputTransparent="True"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Stock Remaining Text -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding StockRemainingText}"
                                       TextColor="#64748B"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Error Alert -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#EF4444"
                           FontSize="12"
                           FontAttributes="Bold"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                    <!-- 3. Expandable Accordion Sections -->
                    <VerticalStackLayout Spacing="0" Margin="0,10,0,0">

                        <!-- Description Accordion -->
                        <BoxView Color="#F1F5F9" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Description"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding DescriptionGlyph}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#94A3B8"
                                   FontSize="18"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding DescriptionText}"
                               IsVisible="{Binding IsDescriptionExpanded}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineHeight="1.35"
                               Margin="0,0,0,12" />

                        <!-- Product Details Accordion -->
                        <BoxView Color="#F1F5F9" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDetailsCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Product Details"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding DetailsGlyph}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#94A3B8"
                                   FontSize="18"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding DetailsText}"
                               IsVisible="{Binding IsDetailsExpanded}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineHeight="1.35"
                               Margin="0,0,0,12" />

                        <!-- Materials Accordion -->
                        <BoxView Color="#F1F5F9" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMaterialsCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Materials"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MaterialsGlyph}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#94A3B8"
                                   FontSize="18"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding MaterialsText}"
                               IsVisible="{Binding IsMaterialsExpanded}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineHeight="1.35"
                               Margin="0,0,0,12" />

                        <!-- Size Guide Accordion -->
                        <BoxView Color="#F1F5F9" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleSizeGuideCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Size Guide"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding SizeGuideGlyph}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#94A3B8"
                                   FontSize="18"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding SizeGuideText}"
                               IsVisible="{Binding IsSizeGuideExpanded}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineHeight="1.35"
                               Margin="0,0,0,12" />

                        <!-- Shipping & Pickup Accordion -->
                        <BoxView Color="#F1F5F9" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShippingCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Shipping &amp; Pickup"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ShippingGlyph}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#94A3B8"
                                   FontSize="18"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding ShippingText}"
                               IsVisible="{Binding IsShippingExpanded}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineHeight="1.35"
                               Margin="0,0,0,12" />

                        <!-- Return Information Accordion -->
                        <BoxView Color="#F1F5F9" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleReturnsCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Return Information"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ReturnsGlyph}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#94A3B8"
                                   FontSize="18"
                                   InputTransparent="True"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding ReturnsText}"
                               IsVisible="{Binding IsReturnsExpanded}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineHeight="1.35"
                               Margin="0,0,0,12" />
                    </VerticalStackLayout>

                    <!-- 4. Ratings & Reviews Card -->
                    <VerticalStackLayout Spacing="8" Margin="0,12,0,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Ratings &amp; Reviews"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="View All"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#2563EB"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewAllReviewsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="16" VerticalOptions="Center">

                                <!-- Overall Score -->
                                <VerticalStackLayout Spacing="2"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding RatingText}"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource NuNavy}"
                                           HorizontalOptions="Center" />
                                    <Label Text="out of 5"
                                           FontSize="11"
                                           TextColor="#94A3B8"
                                           HorizontalOptions="Center"
                                           Margin="0,-4,0,4" />
                                    <HorizontalStackLayout Spacing="1" HorizontalOptions="Center">
                                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="11" TextColor="#F59E0B" />
                                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="11" TextColor="#F59E0B" />
                                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="11" TextColor="#F59E0B" />
                                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="11" TextColor="#F59E0B" />
                                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="11" TextColor="#F59E0B" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Star Distribution Bars -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <!-- 5 Star -->
                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                        <Label Text="5" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding Star5Percent}"
                                                     ProgressColor="#F59E0B"
                                                     HeightRequest="5"
                                                     VerticalOptions="Center" />
                                    </Grid>
                                    <!-- 4 Star -->
                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                        <Label Text="4" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding Star4Percent}"
                                                     ProgressColor="#F59E0B"
                                                     HeightRequest="5"
                                                     VerticalOptions="Center" />
                                    </Grid>
                                    <!-- 3 Star -->
                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                        <Label Text="3" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding Star3Percent}"
                                                     ProgressColor="#F59E0B"
                                                     HeightRequest="5"
                                                     VerticalOptions="Center" />
                                    </Grid>
                                    <!-- 2 Star -->
                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                        <Label Text="2" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding Star2Percent}"
                                                     ProgressColor="#F59E0B"
                                                     HeightRequest="5"
                                                     VerticalOptions="Center" />
                                    </Grid>
                                    <!-- 1 Star -->
                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                        <Label Text="1" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding Star1Percent}"
                                                     ProgressColor="#F59E0B"
                                                     HeightRequest="5"
                                                     VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Eligible Write Review Action Banner -->
                        <Border IsVisible="{Binding CanUserWriteReview}"
                                BackgroundColor="#FEF3C7"
                                Stroke="#FDE68A"
                                StrokeThickness="1"
                                Padding="14,12"
                                Margin="0,6,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="You bought this product!"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#B45309" />
                                    <Label Text="Share your experience to help fellow Bulldogs."
                                           FontSize="11"
                                           TextColor="#92400E" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource NuNavy}"
                                        Padding="14,8"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenWriteReviewCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="12" TextColor="#F59E0B" VerticalOptions="Center" />
                                        <Label Text="Write Review"
                                               TextColor="White"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Top Customer Reviews List -->
                        <VerticalStackLayout IsVisible="{Binding HasReviews}" Spacing="10" Margin="0,10,0,0">
                            <Label Text="Customer Reviews"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopReviews}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductReviewItemModel">
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                Padding="14,12">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="6">
                                                <!-- Author Info & Badge -->
                                                <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                    <!-- Avatar Initial Circle -->
                                                    <Border WidthRequest="32"
                                                            HeightRequest="32"
                                                            StrokeThickness="0"
                                                            BackgroundColor="{StaticResource NuNavy}"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding Initials}"
                                                               TextColor="White"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>

                                                    <!-- Name & Verified Badge -->
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                            <Label Text="{Binding PublicAuthor}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource NuNavy}" />
                                                            <HorizontalStackLayout Spacing="3" IsVisible="{Binding IsVerifiedPurchase}" VerticalOptions="Center">
                                                                <Label Text="&#xe86c;"
                                                                       FontFamily="MaterialIcons"
                                                                       FontSize="11"
                                                                       TextColor="#16A34A"
                                                                       VerticalOptions="Center" />
                                                                <Label Text="Verified Buyer"
                                                                       FontSize="10"
                                                                       TextColor="#16A34A"
                                                                       FontAttributes="Bold"
                                                                       VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding DateFormatted}"
                                                               FontSize="10"
                                                               TextColor="#94A3B8" />
                                                    </VerticalStackLayout>

                                                    <!-- Star Stars -->
                                                    <Label Grid.Column="2"
                                                           Text="{Binding RatingStars}"
                                                           FontFamily="MaterialIcons"
                                                           TextColor="#F59E0B"
                                                           FontSize="13"
                                                           VerticalOptions="Center" />
                                                </Grid>

                                                <!-- Review Title -->
                                                <Label Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       IsVisible="{Binding HasTitle}" />

                                                <!-- Review Comment -->
                                                <Label Text="{Binding Comment}"
                                                       FontSize="12"
                                                       TextColor="#475569"
                                                       LineHeight="1.3" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- View All Button -->
                            <Border IsVisible="{Binding HasMoreReviews}"
                                    BackgroundColor="White"
                                    Stroke="{StaticResource NuNavy}"
                                    StrokeThickness="1"
                                    Padding="14,10"
                                    HorizontalOptions="Fill"
                                    Margin="0,4,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAllReviewsCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding ViewAllButtonText}"
                                       TextColor="{StaticResource NuNavy}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Empty Reviews State -->
                        <VerticalStackLayout IsVisible="{Binding NoReviews}"
                                             Spacing="6"
                                             Padding="16,20"
                                             HorizontalOptions="Center">
                            <Label Text="&#xe0cb;"
                                   FontFamily="MaterialIcons"
                                   FontSize="28"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalOptions="Center" />
                            <Label Text="No customer reviews yet"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalOptions="Center" />
                            <Label Text="Be the first verified buyer to share your feedback!"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 5. Sticky Bottom Action Bar -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="16,10,16,14">
            <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="10">

                <!-- Floating Cart Icon Button -->
                <Border WidthRequest="46"
                        HeightRequest="46"
                        Stroke="{StaticResource NuNavy}"
                        StrokeThickness="1.5"
                        BackgroundColor="White"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe8cc;"
                           FontFamily="MaterialIcons"
                           FontSize="18"
                           TextColor="{StaticResource NuNavy}"
                           InputTransparent="True"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Add to Cart Button -->
                <Border Grid.Column="1"
                        HeightRequest="46"
                        Stroke="{StaticResource NuNavy}"
                        StrokeThickness="1.5"
                        BackgroundColor="White"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddToCartCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Add to Cart"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NuNavy}"
                           InputTransparent="True"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Buy Now Button -->
                <Border Grid.Column="2"
                        HeightRequest="46"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource NuNavy}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BuyNowCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Buy Now"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="White"
                           InputTransparent="True"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- All Reviews Bottom Sheet Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              IsVisible="{Binding IsAllReviewsSheetVisible}"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <!-- Backdrop -->
            <BoxView Color="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseAllReviewsCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Sheet Content -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    HorizontalOptions="Fill"
                    MaximumHeightRequest="620"
                    Padding="20,14,20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <!-- Drag Handle -->
                    <Border BackgroundColor="#CBD5E1"
                            WidthRequest="40"
                            HeightRequest="4"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2" />
                        </Border.StrokeShape>
                    </Border>

                    <!-- Header Row -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding AllReviewsTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="12" TextColor="#F59E0B" VerticalOptions="Center" />
                                <Label Text="{Binding RatingText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource NuNavy}" />
                                <Label Text="out of 5" FontSize="11" TextColor="#94A3B8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="32"
                                HeightRequest="32"
                                BackgroundColor="#F1F5F9"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseAllReviewsCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="&#xe5cd;"
                                   FontFamily="MaterialIcons"
                                   FontSize="16"
                                   TextColor="#475569"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Scrollable Reviews List -->
                    <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout Spacing="10" Padding="0,0,0,16">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AllReviews}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductReviewItemModel">
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                Padding="14,12">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                    <Border WidthRequest="32"
                                                            HeightRequest="32"
                                                            StrokeThickness="0"
                                                            BackgroundColor="{StaticResource NuNavy}"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding Initials}"
                                                               TextColor="White"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                            <Label Text="{Binding PublicAuthor}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource NuNavy}" />
                                                            <HorizontalStackLayout Spacing="3" IsVisible="{Binding IsVerifiedPurchase}" VerticalOptions="Center">
                                                                <Label Text="&#xe86c;"
                                                                       FontFamily="MaterialIcons"
                                                                       FontSize="11"
                                                                       TextColor="#16A34A"
                                                                       VerticalOptions="Center" />
                                                                <Label Text="Verified Buyer"
                                                                       FontSize="10"
                                                                       TextColor="#16A34A"
                                                                       FontAttributes="Bold"
                                                                       VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding DateFormatted}"
                                                               FontSize="10"
                                                               TextColor="#94A3B8" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2"
                                                           Text="{Binding RatingStars}"
                                                           FontFamily="MaterialIcons"
                                                           TextColor="#F59E0B"
                                                           FontSize="13"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                                <Label Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource NuNavy}"
                                                       IsVisible="{Binding HasTitle}" />
                                                <Label Text="{Binding Comment}"
                                                       FontSize="12"
                                                       TextColor="#475569"
                                                       LineHeight="1.3" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- Write Review Bottom Sheet Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              IsVisible="{Binding IsWriteReviewSheetVisible}"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <!-- Backdrop -->
            <BoxView Color="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseWriteReviewCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Sheet Content -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    HorizontalOptions="Fill"
                    MaximumHeightRequest="600"
                    Padding="20,14,20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="14">
                        <!-- Drag Handle -->
                        <Border BackgroundColor="#CBD5E1"
                                WidthRequest="40"
                                HeightRequest="4"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="2" />
                            </Border.StrokeShape>
                        </Border>

                        <!-- Header Row -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Write a Review"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource NuNavy}" />
                                <Label Text="{Binding Name}"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedText}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Close Button -->
                            <Border Grid.Column="1"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="#F1F5F9"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseWriteReviewCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xe5cd;"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="#475569"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Star Rating Selector (Interactive) -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,4,0,0">
                            <Label Text="Your Overall Rating"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}"
                                   HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetWriteRatingCommand}" CommandParameter="1" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="32" TextColor="{Binding WriteStar1Color}" />
                                </Border>
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetWriteRatingCommand}" CommandParameter="2" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="32" TextColor="{Binding WriteStar2Color}" />
                                </Border>
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetWriteRatingCommand}" CommandParameter="3" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="32" TextColor="{Binding WriteStar3Color}" />
                                </Border>
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetWriteRatingCommand}" CommandParameter="4" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="32" TextColor="{Binding WriteStar4Color}" />
                                </Border>
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetWriteRatingCommand}" CommandParameter="5" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="32" TextColor="{Binding WriteStar5Color}" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding WriteRatingStarsLabel}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#D97706"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Review Headline -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Headline (Optional)"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <Border Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="12,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding WriteTitle}"
                                       Placeholder="e.g. Excellent quality fabric, fits true to size"
                                       FontSize="12"
                                       HeightRequest="40"
                                       TextColor="{StaticResource NuNavy}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Review Comment -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Review (Required)"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource NuNavy}" />
                            <Border Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Editor Text="{Binding WriteComment}"
                                        Placeholder="Tell us about the fabric quality, sizing, fit, and overall experience..."
                                        FontSize="12"
                                        HeightRequest="80"
                                        AutoSize="Disabled"
                                        TextColor="{StaticResource NuNavy}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error Message -->
                        <Label Text="{Binding WriteReviewError}"
                               TextColor="#EF4444"
                               FontSize="11"
                               FontAttributes="Bold"
                               IsVisible="{Binding HasWriteReviewError}" />

                        <!-- Submit Button -->
                        <Border BackgroundColor="{StaticResource NuNavy}"
                                HeightRequest="46"
                                StrokeThickness="0"
                                Margin="0,6,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SubmitWriteReviewCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label Text="Submit Review"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsSubmittingWriteReview, Converter={StaticResource InvertedBoolConverter}}" />
                                <ActivityIndicator IsRunning="{Binding IsSubmittingWriteReview}"
                                                   IsVisible="{Binding IsSubmittingWriteReview}"
                                                   Color="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
