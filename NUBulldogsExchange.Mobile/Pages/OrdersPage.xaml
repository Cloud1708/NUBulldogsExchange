<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NUBulldogsExchange.Mobile.Controls"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             x:Class="NUBulldogsExchange.Mobile.Pages.OrdersPage"
             x:Name="OrdersRoot"
             x:DataType="vm:OrdersViewModel"
             Title="Orders"
             BackgroundColor="#F6F7F9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16,14,16,8">
            <Label Text="My Orders"
                   FontSize="19"
                   FontAttributes="Bold"
                   TextColor="{StaticResource NuNavy}" />
        </Border>

        <!-- Status chips -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0,0,0,10">
            <CollectionView ItemsSource="{Binding StatusChips}"
                            HeightRequest="36"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never"
                            SelectionMode="None"
                            Margin="16,0,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderStatusChip">
                        <Border BackgroundColor="{Binding BackgroundColor}"
                                StrokeThickness="0"
                                Padding="14,0"
                                HeightRequest="30"
                                Margin="0,0,8,0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectStatusCommand, Source={x:Reference OrdersRoot}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}"
                                   TextColor="{Binding TextColor}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Orders / Empty -->
        <Grid Grid.Row="2" BackgroundColor="#F6F7F9">
            <CollectionView ItemsSource="{Binding FilteredOrders}"
                            IsVisible="{Binding HasOrders}"
                            SelectionMode="None"
                            Margin="14,8,14,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderCardModel">
                        <controls:OrderCardView
                            BindingContext="{Binding .}"
                            DetailsCommand="{Binding BindingContext.DetailsCommand, Source={x:Reference OrdersRoot}}"
                            TrackCommand="{Binding BindingContext.TrackCommand, Source={x:Reference OrdersRoot}}"
                            BuyAgainCommand="{Binding BindingContext.BuyAgainCommand, Source={x:Reference OrdersRoot}}"
                            ReviewCommand="{Binding BindingContext.ReviewCommand, Source={x:Reference OrdersRoot}}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding HasNoOrders}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Padding="28,0">
                <Label Text="📦"
                       FontSize="52"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />
                <Label Text="No orders found"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       HorizontalTextAlignment="Center" />
                <Label Text="You have no orders in this category."
                       FontSize="12"
                       TextColor="{StaticResource MutedText}"
                       HorizontalTextAlignment="Center" />
                <Border BackgroundColor="{StaticResource NuNavy}"
                        HeightRequest="40"
                        WidthRequest="148"
                        HorizontalOptions="Center"
                        Margin="0,10,0,0"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartShoppingCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Start Shopping"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource NuNavy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>

        <controls:BottomNavBar Grid.Row="3"
                               ActiveTab="orders"
                               HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
