<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NUBulldogsExchange.Mobile.ViewModels"
             xmlns:data="clr-namespace:NUBulldogsExchange.Web.Shared.Data;assembly=NUBulldogsExchange.Web.Shared"
             xmlns:conv="clr-namespace:NUBulldogsExchange.Mobile.Converters"
             x:Class="NUBulldogsExchange.Mobile.Controls.OrderCardView"
             x:Name="Root"
             x:DataType="vm:OrderCardModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <conv:ProductImageConverter x:Key="ProductImageConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border Stroke="#E2E8F0"
            StrokeThickness="1"
            BackgroundColor="White"
            Padding="14,14,14,14"
            Margin="0,0,0,12"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#08000000" Offset="0,1" Radius="4" Opacity="0.08" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="10">
            <!-- Header: Order ID & Status Badge -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="{Binding DisplayId}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        BackgroundColor="{Binding BadgeBackground}"
                        Padding="10,4"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="{Binding CustomerCategory}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="{Binding BadgeTextColor}"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Subtitle: Date • Item Count -->
            <Label Text="{Binding DateAndItemsText}"
                   FontSize="11"
                   TextColor="{StaticResource MutedText}"
                   Margin="0,-4,0,0" />

            <!-- Fulfillment Row: Badge + Location -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="8,3"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding FulfillmentIcon}"
                               FontFamily="MaterialIcons"
                               FontSize="12"
                               TextColor="{StaticResource NuNavy}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding FulfillmentLabel}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Label Text="{Binding FulfillmentLocationText}"
                       FontSize="11"
                       TextColor="#334155"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>

            <!-- Payment Info Row: Method & Status -->
            <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                <Label Text="{Binding PaymentMethodText}"
                       FontSize="10"
                       TextColor="{StaticResource MutedText}" />
                <Label Text="{Binding PaymentStatusText}"
                       FontSize="10"
                       TextColor="{StaticResource MutedText}" />
            </HorizontalStackLayout>

            <!-- Items List -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8" Margin="0,2,0,2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="data:MockOrderItem">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="#F1F5F9"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Image Source="{Binding ImageUrl, Converter={StaticResource ProductImageConverter}}"
                                       Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource NuNavy}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Footer: Price on Left, Buttons on Right -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,4,0,0">
                <Label Grid.Column="0"
                       Text="{Binding TotalText}"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       VerticalOptions="Center" />

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <!-- Reviewed Status Badge -->
                    <Border IsVisible="{Binding ShowReviewedBadge}"
                            BackgroundColor="#DCFCE7"
                            StrokeThickness="0"
                            Padding="10,6"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="&#xe86c;"
                                   FontFamily="MaterialIcons"
                                   FontSize="12"
                                   TextColor="#16A34A"
                                   VerticalOptions="Center" />
                            <Label Text="Reviewed"
                                   TextColor="#16A34A"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Write Review Button -->
                    <Border IsVisible="{Binding ShowReviewButton}"
                            BackgroundColor="#FEF3C7"
                            Stroke="#FDE68A"
                            StrokeThickness="1"
                            Padding="10,6"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ReviewCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="&#xe838;"
                                   FontFamily="MaterialIcons"
                                   FontSize="12"
                                   TextColor="#D97706"
                                   VerticalOptions="Center" />
                            <Label Text="Review"
                                   TextColor="#D97706"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Cancel Order Button -->
                    <Border IsVisible="{Binding CanCancel}"
                            BackgroundColor="White"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding CancelOrderCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="Cancel Order"
                               TextColor="#DC2626"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               InputTransparent="True" />
                    </Border>

                    <!-- Order Received Button -->
                    <Border IsVisible="{Binding CanConfirmReceived}"
                            BackgroundColor="#16A34A"
                            StrokeThickness="0"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ConfirmReceivedCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="Order Received"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               InputTransparent="True" />
                    </Border>

                    <!-- View Order Button -->
                    <Border BackgroundColor="{StaticResource NuNavy}"
                            StrokeThickness="0"
                            Padding="14,6"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ViewOrderCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="View Order"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
