<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NUBulldogsExchange.Mobile.Controls.BottomNavBar"
             x:Name="Root">

    <Border BackgroundColor="White"
            StrokeThickness="0"
            HeightRequest="60"
            HorizontalOptions="Fill">
        <Border.Stroke>
            <SolidColorBrush Color="{StaticResource SoftBorder}" />
        </Border.Stroke>
        <Grid Padding="0,1,0,0">
            <BoxView Color="{StaticResource SoftBorder}"
                     HeightRequest="1"
                     VerticalOptions="Start" />

            <Grid ColumnDefinitions="*,*,*,*,*"
                  Padding="0,8,0,6">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHome" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⌂"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding HomeColor, Source={x:Reference Root}}" />
                    <Label Text="Home"
                           FontSize="10"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding HomeColor, Source={x:Reference Root}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShop" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🛍"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding ShopColor, Source={x:Reference Root}}" />
                    <Label Text="Shop"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding ShopColor, Source={x:Reference Root}}" />
                    <BoxView Color="{Binding ShopColor, Source={x:Reference Root}}"
                             HeightRequest="2"
                             WidthRequest="28"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsShopActive, Source={x:Reference Root}}"
                             CornerRadius="1" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWishlist" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="{Binding WishlistGlyph, Source={x:Reference Root}}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding WishlistIconColor, Source={x:Reference Root}}" />
                    <Label Text="Wishlist"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding WishlistColor, Source={x:Reference Root}}" />
                    <BoxView Color="{Binding WishlistColor, Source={x:Reference Root}}"
                             HeightRequest="2"
                             WidthRequest="36"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsWishlistActive, Source={x:Reference Root}}"
                             CornerRadius="1" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3"
                                     Spacing="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOrders" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="▦"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding OrdersColor, Source={x:Reference Root}}" />
                    <Label Text="Orders"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding OrdersColor, Source={x:Reference Root}}" />
                    <BoxView Color="{Binding OrdersColor, Source={x:Reference Root}}"
                             HeightRequest="2"
                             WidthRequest="32"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsOrdersActive, Source={x:Reference Root}}"
                             CornerRadius="1" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4"
                                     Spacing="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAccount" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👤"
                           FontSize="15"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding AccountColor, Source={x:Reference Root}}" />
                    <Label Text="Account"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding AccountColor, Source={x:Reference Root}}" />
                    <BoxView Color="{Binding AccountColor, Source={x:Reference Root}}"
                             HeightRequest="2"
                             WidthRequest="36"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsAccountActive, Source={x:Reference Root}}"
                             CornerRadius="1" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>
