<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NUBulldogsExchange.Mobile.Controls.ProductCardView"
             x:Name="Root">

    <Border Stroke="{StaticResource SoftBorder}"
            StrokeThickness="1"
            BackgroundColor="White"
            Padding="0"
            HorizontalOptions="Fill"
            Margin="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#14000000" Offset="0,2" Radius="8" Opacity="0.16" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto">
            <Grid HeightRequest="140">
                <Border BackgroundColor="#F1F5F9" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14,14,0,0" />
                    </Border.StrokeShape>
                    <Image Source="{Binding DisplayImage, Source={x:Reference Root}}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </Border>

                <Border IsVisible="{Binding HasBadge, Source={x:Reference Root}}"
                        BackgroundColor="{Binding BadgeColor, Source={x:Reference Root}}"
                        Padding="7,3"
                        Margin="8"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="{Binding BadgeText, Source={x:Reference Root}}"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="{Binding BadgeTextColor, Source={x:Reference Root}}" />
                </Border>

                <Border BackgroundColor="White"
                        WidthRequest="30"
                        HeightRequest="30"
                        Margin="8"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWishlistTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding WishlistGlyph, Source={x:Reference Root}}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{Binding WishlistColor, Source={x:Reference Root}}" />
                </Border>
            </Grid>

            <VerticalStackLayout Grid.Row="1" Padding="9,8,9,10" Spacing="3">
                <Label Text="{Binding Product.Name, Source={x:Reference Root}}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource NuNavy}"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       HeightRequest="32" />

                <Label FontSize="10" TextColor="{StaticResource MutedText}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="⭐ " />
                            <Span Text="{Binding RatingText, Source={x:Reference Root}}" />
                            <Span Text=" · " />
                            <Span Text="{Binding SoldText, Source={x:Reference Root}}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding PriceText, Source={x:Reference Root}}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource NuNavy}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding OriginalPriceText, Source={x:Reference Root}}"
                               IsVisible="{Binding HasOriginalPrice, Source={x:Reference Root}}"
                               FontSize="11"
                               TextColor="#94A3B8"
                               TextDecorations="Strikethrough"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource NuNavy}"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="+"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
